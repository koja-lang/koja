test "push then pop"
  stack = [1, 2, 3]
  popped = stack.get(2)
  assert popped == Option.Some(3)
end

test "a comparison failure renders both operands"
  popped = 2
  assert popped == 3
end

test "a plain condition failure records the expression"
  stack = [1]
  assert stack.empty?(), "one element left"
end

test "require unwraps a setup step"
  value = try Test.require(parse("42"))
  assert value == 42
end

test "skip ends the test as skipped"
  try Test.skip("no fixture here")
  assert false
end

test "crashes sees a panic"
  assert Test.crashes(fn () Kernel.panic("boom") end)
  assert not Test.crashes(fn () 42 end)
end

test "fail with a string literal"
  fail "a plain message"
end

test "an ordering failure renders both operands"
  assert [1, 2].length() > 5
end

priv fn parse(text: String) -> Int ! String
  match text.to_int()
    Result.Ok(value) -> value
    Result.Err(_) -> fail "not a number: #{text}"
  end
end
