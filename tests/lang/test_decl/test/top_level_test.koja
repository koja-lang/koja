test "a top-level test groups under its file"
  assert Stack.new().size() == 0
end

test "two tests may share a description"
  assert true
end

test "two tests may share a description"
  assert not false
end

test "a trailing expression needs no unit"
  Stack.new().push(1)
end

test "the right operand takes the left operand's type"
  assert Stack.new().peek() == Option.None
  assert Checksum.crc32(<<>>) == 0
  small: Int8 = -3
  assert small == -3
  ratio: Float32 = 1.5
  assert ratio == 1.5
end

test "the left operand takes the right operand's type"
  assert Option.None == Stack.new().peek()
  assert 0 == Checksum.crc32(<<>>)
  small: Int8 = -3
  assert -3 == small
  ratio: Float32 = 1.5
  assert 1.5 == ratio
end
