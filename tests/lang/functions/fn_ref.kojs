fn double(n: Int) -> Int
  n * 2
end

fn greet(name: String) -> String
  "hello #{name}"
end

fn apply(x: Int, f: fn (Int) -> Int) -> Int
  f(x)
end

# assign a function to a variable and call it
f = &double/1
f(5).print()

# pass a named function reference as an argument
apply(10, &double/1).print()

# named function reference with list.map
nums: List<Int> = [1, 2, 3]
doubled = nums.map(&double/1)

for d in doubled
  d.print()
end

# named function reference returning String
g = &greet/1
g("world").print()
