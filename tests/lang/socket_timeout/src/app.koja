alias IO.Error as IOError
alias IO.Reader.Options as ReaderOptions
alias Net.IPAddress
alias Net.Socket.Address as SocketAddress
alias Net.Socket.Error as SocketError
alias Net.TCPListener
alias Net.TCPSocket
alias Net.TLSError
alias Process.Lifecycle
alias Process.Step
alias Process.StopReason

# Socket deadlines under the process runtime: an accept with no client
# ends in `SocketError.TimedOut` and a read from a silent peer in
# `IOError.TimedOut`, instead of parking forever.

const SHORT_WAIT: Duration = Duration{
  unit: Duration.Unit.Milliseconds,
  value: 50,
}

struct App: Process<App, (), String>
  fn start(config: App) -> Result<Self, StopReason>
    Result.Ok(config)
  end

  fn handle(self, msg: (), from: Option<ReplyTo<String>>) -> Step<Self>
    Step.Continue(self)
  end

  fn run(self) -> StopReason
    addr = SocketAddress{ip: IPAddress.LOOPBACK, port: 43121}

    listener =
      match TCPListener.bind_addr(addr)
        Result.Ok(l) ->
          l

        Result.Err(e) ->
          IO.puts("bind failed: " <> e.message())
          return StopReason.Shutdown
      end

    match listener.accept(Option.Some(SHORT_WAIT))
      Result.Ok(_) -> IO.puts("accept returned a socket")
      Result.Err(SocketError.TimedOut) -> IO.puts("accept timed out")
      Result.Err(e) -> IO.puts("accept failed: " <> e.message())
    end

    client =
      match TCPSocket.connect_addr(addr)
        Result.Ok(c) ->
          c

        Result.Err(e) ->
          IO.puts("connect failed: " <> e.message())
          return StopReason.Shutdown
      end

    match client.read(16, ReaderOptions{timeout: Option.Some(SHORT_WAIT)})
      Result.Ok(_) ->
        IO.puts("read returned data")

      Result.Err(io_error: IOError) ->
        match io_error
          IOError.TimedOut -> IO.puts("read timed out")
          _ -> IO.puts("read failed: " <> io_error.message())
        end

      Result.Err(tls_error: TLSError) ->
        IO.puts("read failed: " <> tls_error.message())
    end

    _ = client.close()
    _ = listener.close()
    StopReason.Normal
  end
end
