struct Thing
  name: String
end

struct Duo<A, B>
  first: A
  second: B

  fn new(first: A, second: B) -> Duo<A, B>
    Duo{first: first, second: second}
  end
end

fn identity<T>(value: T) -> T
  value
end

fn duo<A, B>(first: A, second: B) -> Duo<A, B>
  Duo{first: first, second: second}
end

fn static_duo(thing: Thing) -> Duo<Thing, Option<String>>
  Duo.new(thing, Option.None)
end

fn free_duo -> Duo<Int, Option<String>>
  duo(1, Option.None)
end

fn optional -> Option<Int>
  identity(Option.None)
end

fn failure -> Result<Int, String>
  identity(Result.Err("failed"))
end

value = static_duo(Thing{name: "thing"})
value.first.name.print()
value.second.none?().print()
free_duo().second.none?().print()
optional().none?().print()
failure().err?().print()
