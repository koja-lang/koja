const MAX = 100
const PI = 3.14
const NAME = "koja"
const DEBUG = false

enum Direction
  North
  South
  East
  West
end

struct Point
  x: Int
  y: Int
end

struct Slot
  ref: Option<Int>

  const EMPTY: Slot = Slot{ref: Option.None}
end

struct Holder
  slot: Slot = Slot.EMPTY
end

const HEADING = Direction.North
const ORIGIN = Point{x: 0, y: 0}
const NOTHING: Option<Int> = Option.None

fn direction_name(d: Direction) -> String
  match d
    North -> "north"
    South -> "south"
    East -> "east"
    West -> "west"
  end
end

MAX.print()
PI.print()
NAME.print()
DEBUG.print()
(MAX + 1).print()

direction_name(HEADING).print()
ORIGIN.x.print()
ORIGIN.y.print()

NOTHING.none?().print()
Slot.EMPTY.ref.none?().print()
Holder{}.slot.ref.none?().print()
