alias Process.Step
alias Process.StopReason

struct FFI
  @extern "C" @link "ffi_helper"
  fn add_c(a: Int32, b: Int32) -> Int32

  @extern "C" @link "ffi_helper"
  fn mul_c(a: Int32, b: Int32) -> Int32

  @extern "C" @link "ffi_helper"
  fn half_c(x: Float64) -> Float64

  @extern "C" @link "ffi_helper"
  fn negate_i8(x: Int8) -> Int8

  @extern "C" @link "ffi_helper"
  fn max_u8(x: UInt8) -> UInt8

  @extern "C" @link "ffi_helper"
  fn negate_i16(x: Int16) -> Int16

  @extern "C" @link "ffi_helper"
  fn max_u16(x: UInt16) -> UInt16

  @extern "C" @link "ffi_helper"
  fn max_u32(x: UInt32) -> UInt32

  @extern "C" @link "ffi_helper"
  fn negate_i64(x: Int64) -> Int64

  @extern "C" @link "ffi_helper"
  fn low_i32(x: Int64) -> Int32

  @extern "C" @link "ffi_helper"
  fn shift_u64(x: UInt64) -> UInt64

  @extern "C" @link "ffi_helper"
  fn is_even(x: Int32) -> Bool

  @extern "C" @link "ffi_helper"
  fn flip(x: Bool) -> Bool

  @extern "C" @link "ffi_helper"
  fn halve_f32(x: Float32) -> Float32

  @extern "C" @link "ffi_helper"
  fn fill_array(buf: CPtr<Int32>, count: Int32, value: Int32)

  @extern "C" @link "ffi_helper"
  fn sum_array(buf: CPtr<Int32>, count: Int32) -> Int32

  @extern "C" @link "ffi_helper"
  fn read_at(buf: CPtr<Int32>, index: Int32) -> Int32

  @extern "C" @link "ffi_helper"
  fn make_greeting(name: CPtr<UInt8>, name_len: Int64) -> CPtr<UInt8>
end

struct App: Process<(), (), ()>
  fn start(config: ()) -> Result<Self, StopReason>
    Result.Ok(App{})
  end

  fn handle(self, msg: (), from: Option<ReplyTo<()>>) -> Step<Self>
    Step.Continue(self)
  end

  fn run(self) -> StopReason
    # Phase 1: primitive FFI
    sum = FFI.add_c(3, 4)
    sum.print()

    product = FFI.mul_c(5, 6)
    product.print()

    # A finite float return passes the FFI finiteness trap.
    halved: Float = FFI.half_c(3.0)
    halved.print()

    # Every other admissible width. Negative and above-signed-range
    # results catch a wrong read width or extension.
    FFI.negate_i8(100).print()
    FFI.max_u8(1).print()
    FFI.negate_i16(300).print()
    FFI.max_u16(1).print()
    FFI.max_u32(1).print()
    FFI.low_i32(FFI.negate_i64(5)).print()
    FFI.shift_u64(7).print()
    FFI.is_even(4).print()
    FFI.is_even(5).print()
    FFI.flip(true).print()
    quarter: Float32 = FFI.halve_f32(0.5.to_float32().unwrap())
    quarter.print()

    # Phase 2: pointer FFI
    # Allocate a buffer, let C fill it, read it back
    buf: CPtr<Int32> = CPtr.alloc(4)
    FFI.fill_array(buf, 4, 10)
    FFI.read_at(buf, 0).print()
    FFI.read_at(buf, 1).print()
    FFI.read_at(buf, 2).print()
    FFI.read_at(buf, 3).print()

    # Sum the filled array via C
    total = FFI.sum_array(buf, 4)
    total.print()
    buf.free()

    # Pass a CString to C and get back a pointer
    name = "Koja"
    cs = name.to_cstring().unwrap()
    greeting_ptr = FFI.make_greeting(cs.ptr, cs.len)
    cs.free()

    # Build a CString from the returned pointer to read the greeting
    greeting_len: Int = 0
    i: Int = 0

    loop
      byte = greeting_ptr.offset(i).read()

      if byte == 0
        break
      end

      i += 1
    end

    greeting_len = i

    greeting_cs = CString{ptr: greeting_ptr, len: greeting_len}
    greeting = greeting_cs.to_string().unwrap()
    greeting.print()
    greeting_cs.free()
    StopReason.Normal
  end
end
