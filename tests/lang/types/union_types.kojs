# Anonymous union types: widening coercion and match dispatch
struct Post
  title: String
end

struct Comment
  body: String
end

struct Ad
  url: String
end

fn display_item(item: Post | Comment | Ad) -> String
  match item
    _ -> "an item"
  end
end

fn widen_post(p: Post) -> Post | Comment
  p
end

fn accept_union(x: Post | Comment) -> String
  match x
    _ -> "ok"
  end
end

fn wrap_post(p: Post) -> Option<Post | Comment>
  Option.Some(p)
end

p = Post{title: "Hello"}
item: Post | Comment | Ad = p
display_item(item).print()

result = widen_post(Post{title: "Test"})
accept_union(result).print()

# A member widens in a variant payload and in a tuple argument
pairs: List<(String, Post | Comment)> = []
pairs = pairs.append(("first", p))
IO.puts("#{pairs.length()} #{wrap_post(p).some?()}")
