# Anonymous union types: widening coercion and match dispatch
struct Post
  title: String
end

struct Comment
  body: String
end

struct Ad
  url: String
end

fn display_item(item: Post | Comment | Ad) -> String
  match item
    _ -> "an item"
  end
end

fn widen_post(p: Post) -> Post | Comment
  p
end

fn accept_union(x: Post | Comment) -> String
  match x
    _ -> "ok"
  end
end

fn wrap_post(p: Post) -> Option<Post | Comment>
  Option.Some(p)
end

p = Post{title: "Hello"}
item: Post | Comment | Ad = p
display_item(item).print()

result = widen_post(Post{title: "Test"})
accept_union(result).print()

# A member widens in a variant payload and in a tuple argument
pairs: List<(String, Post | Comment)> = []
pairs = pairs.append(("first", p))
IO.puts("#{pairs.length()} #{wrap_post(p).some?()}")

# A member widens on a reassignment and on a write to a field
struct Thread
  top: Post | Comment
end

fn describe(x: Post | Comment) -> String
  match x
    post: Post -> "post #{post.title}"
    comment: Comment -> "comment #{comment.body}"
  end
end

slot: Post | Comment = p
slot = Comment{body: "Hi"}
thread = Thread{top: p}
thread.top = Comment{body: "Yo"}
IO.puts("#{describe(slot)}, #{describe(thread.top)}")

# A struct pattern and a variant pattern each match one member
enum Flag
  On
  Off(String)
end

fn summary(x: Post | Comment | Flag) -> String
  match x
    Post{title: "Hello"} -> "the hello post"
    Post{title: t} -> "post #{t}"
    Comment{body: b} -> "comment #{b}"
    Flag.On -> "on"
    Flag.Off(reason) -> "off #{reason}"
  end
end

IO.puts("#{summary(p)}, #{summary(Post{title: "Bye"})}")
IO.puts("#{summary(Comment{body: "Hi"})}, #{summary(Flag.On)}")
IO.puts(summary(Flag.Off("spam")))

# The same patterns match a union inside a variant payload
fn inside(slot: Option<Post | Flag>) -> String
  match slot
    Option.Some(Post{title: t}) -> "some post #{t}"
    Option.Some(Flag.Off(reason)) -> "some off #{reason}"
    Option.Some(Flag.On) -> "some on"
    Option.None -> "none"
  end
end

IO.puts("#{inside(Option.Some(p))}, #{inside(Option.Some(Flag.Off("late")))}")
IO.puts("#{inside(Option.Some(Flag.On))}, #{inside(Option.None)}")

# A generic literal, variant, or call takes its type arguments from a member
struct Box<T>
  value: T
end

fn contents(held: String | Box<Int32>) -> String
  match held
    text: String -> "text #{text}"
    box: Box<Int32> -> "box #{box.value}"
  end
end

fn found(held: String | Option<Int>) -> String
  match held
    text: String -> "text #{text}"
    Option.Some(n) -> "some #{n}"
    Option.None -> "none"
  end
end

fn measure(held: String | List<Int>) -> String
  match held
    text: String -> "text #{text}"
    items: List<Int> -> "list of #{items.length()}"
  end
end

boxed: String | Box<Int32> = Box{value: 3}
empty: String | Option<Int> = Option.None
fresh: String | List<Int> = List.new()
IO.puts("#{contents(boxed)}, #{found(empty)}, #{measure(fresh)}")

# The member of a recursive alias sets the type argument at each level
type Nest = Int | Box<Nest>

fn depth(nest: Nest) -> Int
  match nest
    _n: Int -> 0
    inner: Box<Nest> -> 1 + depth(inner.value)
  end
end

nest: Nest = Box{value: Box{value: 3}}
IO.puts("depth #{depth(nest)}")
