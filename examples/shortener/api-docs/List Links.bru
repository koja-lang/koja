meta {
  name: List Links
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/links?limit=100&offset=0
  body: none
  auth: none
}

params:query {
  limit: 100
  offset: 0
}

assert {
  res.status: eq 200
}

docs {
  # List Links

  Returns one page of links as a JSON array, newest first. Empty page returns `[]`.

  **Query params**

  - `limit`: page size, 1 to 1000, default 100
  - `offset`: rows to skip, default 0

  **Response 200**

      [
        {
          "code": "abc123",
          "url": "https://example.com",
          "created_at": "2026-06-07T20:00:00Z",
          "hits": 4,
          "short_path": "/abc123"
        }
      ]
}
