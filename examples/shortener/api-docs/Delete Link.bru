meta {
  name: Delete Link
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/links/{{code}}
  body: none
  auth: none
}

assert {
  res.status: eq 204
}

docs {
  # Delete Link

  Removes the link with the given `code`. Returns an empty `204 No Content`
  on success. A second delete of the same code returns `404`, the same as
  a code that was never created.

  **Response 204** has no body.

  **Errors**

  - `404 Not Found` if no link has that code.
}
