alias Postgres.Connection
alias Postgres.QueryResult
alias Postgres.Value

@doc """
A shortened link: its short `code`, the target `url`, when it was
created, and how many times it has been visited.
"""
struct Link: JSON.Encoding
  code: String
  created_at: String
  hits: Int
  url: String

  @doc """
  Returns this link in its API response shape.
  """
  fn to_json(self) -> JSON.Value
    [
      "code": self.code.to_json(), "created_at": self.created_at.to_json(),
      "hits": self.hits.to_json(), "short_path": ("/" <> self.code).to_json(),
      "url": self.url.to_json()
    ]
  end
end

const CODE_LENGTH: Int = 7
const MAX_ATTEMPTS: Int = 5
const CODE_ALPHABET: String = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

@doc """
Data-access layer over the `links` table. Every operation threads the
Postgres `Connection` through (Koja values are independent, so a query
returns an updated connection) and returns it alongside the outcome,
so callers rebind to the returned connection. Driver errors are collapsed
to their `message()` text at this boundary so the HTTP layer only
deals in strings.

User-supplied text binds as `$n` parameters through the extended
protocol (`Connection.execute`), so nothing here escapes strings.
`page` interpolates only integers the router has validated. All reads
project the same column order (`code, url, created_at, hits`) so row
mapping is uniform.
"""
struct LinkStore
  @doc """
  Inserts a new link for `url` under a freshly generated unique code,
  retrying on the (unlikely) event of a code collision.
  """
  fn create(conn: Connection, url: String) -> (Connection, Result<Link, String>)
    create_attempt(conn, url, 0)
  end

  @doc """
  Returns one page of links, newest first. `limit` and `offset` are
  validated by the router, so they interpolate as plain integers.
  """
  fn page(conn: Connection, limit: Int, offset: Int)
    -> (Connection, Result<List<Link>, String>)

    (conn, outcome) = conn.query(
      select_columns() <>
        " FROM links ORDER BY created_at DESC LIMIT #{limit} OFFSET #{offset}",
    )

    match outcome
      Result.Err(e) -> (conn, Result.Err(e.message()))
      Result.Ok(qr) -> (conn, Result.Ok(qr.rows.map(row -> row_to_link(row))))
    end
  end

  @doc """
  Looks up a single link by code.
  """
  fn find(conn: Connection, code: String)
    -> (Connection, Result<Option<Link>, String>)

    query_one(
      conn,
      select_columns() <> " FROM links WHERE code = $1",
      [Value.string(code)],
    )
  end

  @doc """
  Repoints an existing link at a new `url`, returning the updated link
  or `None` when no link has that code.
  """
  fn update(conn: Connection, code: String, url: String)
    -> (Connection, Result<Option<Link>, String>)

    query_one(
      conn,
      "UPDATE links SET url = $1 WHERE code = $2 RETURNING code, url, created_at::text, hits",
      [Value.string(url), Value.string(code)],
    )
  end

  @doc """
  Deletes a link, returning `true` when a row was removed.
  """
  fn remove(conn: Connection, code: String)
    -> (Connection, Result<Bool, String>)

    (conn, outcome) = conn.execute(
      "DELETE FROM links WHERE code = $1",
      [Value.string(code)],
    )

    match outcome
      Result.Err(e) -> (conn, Result.Err(e.message()))
      Result.Ok(qr) -> (conn, Result.Ok(qr.tag != "DELETE 0"))
    end
  end

  @doc """
  Records a visit (incrementing `hits`) and returns the target URL, or
  `None` when the code is unknown. Used by the redirect path.
  """
  fn visit(conn: Connection, code: String)
    -> (Connection, Result<Option<String>, String>)

    (conn, outcome) = conn.execute(
      "UPDATE links SET hits = hits + 1 WHERE code = $1 RETURNING url",
      [Value.string(code)],
    )

    match outcome
      Result.Err(e) ->
        (conn, Result.Err(e.message()))

      Result.Ok(qr) ->
        target: Option<String> = qr.rows.get(0).map(row -> text_at(row, 0))
        (conn, Result.Ok(target))
    end
  end

  priv fn create_attempt(conn: Connection, url: String, attempt: Int)
    -> (Connection, Result<Link, String>)

    if attempt >= MAX_ATTEMPTS
      return (conn, Result.Err("could not generate a unique code"))
    end

    code = generate_code(CODE_LENGTH)
    (conn, outcome) = conn.execute("""
      INSERT INTO links (code, url) VALUES ($1, $2)
      ON CONFLICT (code) DO NOTHING
      RETURNING code, url, created_at::text, hits
      """, [Value.string(code), Value.string(url)])

    match outcome
      Result.Err(e) ->
        (conn, Result.Err(e.message()))

      Result.Ok(qr) ->
        match first_link(qr)
          Option.Some(link) -> (conn, Result.Ok(link))
          Option.None -> create_attempt(conn, url, attempt + 1)
        end
    end
  end

  priv fn query_one(conn: Connection, sql: String, params: List<Value>)
    -> (Connection, Result<Option<Link>, String>)

    (conn, outcome) = conn.execute(sql, params)

    match outcome
      Result.Err(e) -> (conn, Result.Err(e.message()))
      Result.Ok(qr) -> (conn, Result.Ok(first_link(qr)))
    end
  end

  priv fn first_link(qr: QueryResult) -> Option<Link>
    qr.rows.get(0).map(row -> row_to_link(row))
  end

  priv fn row_to_link(row: List<Value>) -> Link
    Link{
      code: text_at(row, 0),
      created_at: text_at(row, 2),
      hits: int_at(row, 3),
      url: text_at(row, 1),
    }
  end

  priv fn text_at(row: List<Value>, index: Int) -> String
    row.get(index).map(v -> v.string_or("")).or("")
  end

  priv fn int_at(row: List<Value>, index: Int) -> Int
    row.get(index).map(v -> v.int_or(0)).or(0)
  end

  priv fn select_columns -> String
    "SELECT code, url, created_at::text, hits"
  end

  priv fn generate_code(length: Int) -> String
    code = ""

    for _ in Range{start: 1, stop: length}
      code = code <>
        CODE_ALPHABET.get(Random.int(0, CODE_ALPHABET.length() - 1)).or("0")
    end

    code
  end
end
