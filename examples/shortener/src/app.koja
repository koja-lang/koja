alias HTTP.Request
alias HTTP.Response
alias HTTP.Status
alias HTTP.Version
alias Net.TCPServer
alias Net.TCPServer.Config as TCPServerConfig
alias Net.TCPServer.Event as TCPEvent
alias Net.TCPSocket
alias Pooler.Config as PoolConfig
alias Pooler.Pool
alias Postgres.Config as DbConfig
alias Postgres.Connection
alias Process.Lifecycle
alias Process.Step
alias Process.StopReason
alias Trail.Router

const POOL_SIZE: Int = 10

# Bytes pulled per socket read, how many requests one connection may
# issue before the worker closes it, and the largest request body the
# worker accepts.
const READ_CHUNK: Int = 8192
const MAX_REQUESTS_PER_CONNECTION: Int = 1000
const MAX_BODY_BYTES: Int = 1_048_576

@doc """
The URL-shortener entry process. `start` loads config from the
environment, spawns a pool of `POOL_SIZE` Postgres connections, builds
the route table over it, and spawns a `Net.TCPServer` acceptor that
delivers connected sockets as `TCPEvent.Connected` messages. Each
connection is handed to a one-shot `Worker` process, so requests are
handled concurrently and the entry process never blocks on IO.

The pool builds its connections in the background and retries on a
backoff timer while Postgres is down, so startup never waits on the
database. Requests answer 503 until the first connection is ready.
"""
struct App: Process<List<String>, TCPEvent, String>
  router: Router

  fn start(config: List<String>) -> Self ! StopReason
    settings = Config.load()
    db_config =
      DbConfig.new(
        settings.db_host,
        settings.db_port,
        settings.db_user,
        settings.db_name,
      )
      .with_password(settings.db_password)
      .with_statement_cache_size(settings.db_statement_cache)

    pool_config = PoolConfig{
      create: fn () -> Result<Connection, String>
        Connection.connect(db_config).map_err(e -> e.message())
      end,
      destroy: Option.Some(fn (conn: Connection) -> () _ = conn.close() end),
      size: POOL_SIZE,
      valid: Option.Some(fn (conn: Connection) -> Bool conn.idle?() end),
    }

    pool =
      match Pool.start(pool_config)
        Result.Ok(started) ->
          started

        Result.Err(e) ->
          IO.puts("invalid pool config: #{e}")
          fail StopReason.Shutdown
      end

    me: Ref<TCPEvent, String> = Ref.self_ref()
    _ = spawn TCPServer.start(TCPServerConfig{port: settings.port, owner: me})

    IO.puts("koja-shortener listening on http://127.0.0.1:#{settings.port}")
    IO.puts("  POST /links {\"url\": \"...\"}  -> create")
    IO.puts("  GET  /:code                  -> redirect")
    IO.puts("  (#{POOL_SIZE} pooled db connections, press Ctrl-C to stop)")
    App{router: build_router(pool)}
  end

  fn handle(self, msg: TCPEvent, from: Option<ReplyTo<String>>) -> Step<Self>
    match msg
      TCPEvent.Connected(client) ->
        _ = spawn Worker.start(Worker{client: client, router: self.router})
        Step.Continue(self)

      TCPEvent.Error(e) ->
        IO.puts("listener error: " <> e.message())
        Step.Done(StopReason.Shutdown)
    end
  end

  fn handle_signal(self, signal: Lifecycle) -> Step<Self>
    match signal
      Lifecycle.Interrupt ->
        IO.puts("")
        IO.puts("received SIGINT, shutting down...")
        Step.Done(StopReason.Normal)

      Lifecycle.Reload ->
        Step.Continue(self)

      Lifecycle.Shutdown ->
        IO.puts("received SIGTERM, shutting down...")
        Step.Done(StopReason.Shutdown)
    end
  end
end

@doc """
A one-shot process that owns a single client connection. Its `run`
loop reads requests off the socket (HTTP keep-alive), dispatches each
one through the router, and writes the response. The worker exits
when the client closes, a read or write fails, a request is not valid
HTTP or has a body over `MAX_BODY_BYTES`, the request asks for
`Connection: close`, or the per-connection request budget is spent.
"""
struct Worker: Process<Worker, (), ()>
  client: TCPSocket
  router: Router

  fn start(config: Worker) -> Self ! StopReason
    config
  end

  fn handle(self, msg: (), from: Option<ReplyTo<()>>) -> Step<Self>
    Step.Continue(self)
  end

  fn run(self) -> StopReason
    budget = MAX_REQUESTS_PER_CONNECTION
    parser = Request.Parser.new()

    while budget > 0
      (parser, read) = self.read_request(parser)

      match read
        Read.Closed ->
          break

        Read.Rejected(status, message) ->
          _ = self.send(error_response(status, message), false)
          break

        Read.Request(request) ->
          keep = wants_keep_alive?(request) and budget > 1

          if not (self.send(self.router.dispatch(request), keep) and keep)
            break
          end

          budget = budget - 1
      end
    end

    self.close()
    StopReason.Normal
  end

  # The answer for a request body over `MAX_BODY_BYTES`.
  priv fn body_too_large -> Read
    Read.Rejected(Status.new(413), "request body is too large")
  end

  priv fn close(self)
    _ = self.client.close()
  end

  # The answer for a request that is not valid HTTP.
  priv fn malformed -> Read
    Read.Rejected(Status.bad_request(), "malformed request")
  end

  # Reads one request from the client through `parser` and joins its
  # body. Returns the parser, which keeps the bytes of a pipelined
  # request, and what the read gave. The parser holds no body, so the
  # worker counts the body bytes and enforces `MAX_BODY_BYTES`.
  priv fn read_request(self, parser: Request.Parser) -> (Request.Parser, Read)
    body: Binary = <<>>
    request: Option<Request> = Option.None

    loop
      event =
        match parser.next()
          Result.Ok((advanced, found)) ->
            parser = advanced
            found

          Result.Err(_) ->
            return (parser, Worker.malformed())
        end

      match event
        Option.Some(Request.Parser.Event.Request(head)) ->
          if head.headers.content_length().or(0) > MAX_BODY_BYTES
            return (parser, Worker.body_too_large())
          end

          request = Option.Some(head)

        Option.Some(Request.Parser.Event.Data(piece)) ->
          if body.byte_size() + piece.byte_size() > MAX_BODY_BYTES
            return (parser, Worker.body_too_large())
          end

          body = body <> piece

        Option.Some(Request.Parser.Event.End) ->
          break

        Option.None ->
          match self.client.read(READ_CHUNK)
            Result.Ok(chunk) when chunk.byte_size() > 0 ->
              parser = parser.feed(chunk)
            _ -> return (parser, Read.Closed)
          end
      end
    end

    # The parser returns `End` only after a `Request`.
    complete = request.unwrap()
    complete.body = body
    (parser, Read.Request(complete))
  end

  # Writes the whole response with its `Connection` header. Returns
  # false when the write failed, which means the client is gone.
  priv fn send(self, response: Response, keep: Bool) -> Bool
    response = with_connection(response, keep ? "keep-alive" : "close")

    match self.client.write_all(response.serialize())
      Result.Ok(_) -> true
      Result.Err(_) -> false
    end
  end
end

# What one read of a request gave. `Closed` means the client closed
# the connection or a read failed. `Rejected` carries the status and
# the message of the answer for a request that the worker refuses.
# `Request` carries a complete request with its body joined.
priv enum Read
  Closed
  Rejected(Status, String)
  Request(Request)
end

# HTTP/1.1 defaults to keep-alive and HTTP/1.0 to close, but an
# explicit Connection header overrides either.
priv fn wants_keep_alive?(req: Request) -> Bool
  fallback = req.version == Version.HTTP1_1

  match req.headers.get("Connection")
    Option.None ->
      fallback

    Option.Some(value) ->
      lowered = value.downcase()

      cond
        lowered.contains?("close") -> false
        lowered.contains?("keep-alive") -> true
        else -> fallback
      end
  end
end

priv fn with_connection(response: Response, value: String) -> Response
  response.headers = response.headers.set("Connection", value)
  response
end
