alias HTTP.Headers
alias HTTP.Method
alias HTTP.Request
alias HTTP.Response
alias HTTP.Status
alias JSON.Value
alias Postgres.Connection

const LINKS_PREFIX: String = "/links/"
const DEFAULT_LIMIT: Int = 100
const MAX_LIMIT: Int = 1000

@doc """
Maps an HTTP request to a response, threading the Postgres
`Connection` through (each query yields an updated connection) and
returning it alongside the response so the caller can rebind.

Routes:
- `GET    /`            service info
- `GET    /links`       list links, newest first (`limit` and `offset` query params)
- `POST   /links`       create a link from a JSON `{"url": ...}` body
- `GET    /links/:code` link metadata
- `PUT    /links/:code` repoint a link at a new URL
- `DELETE /links/:code` delete a link
- `GET    /:code`       302-redirect to the target, counting the hit
"""
struct Router
  fn route(req: Request, conn: Connection) -> (Response, Connection)
    (path, query) = split_query(req.path)

    match req.method
      Method.Delete -> handle_delete(path, conn)
      Method.Get -> handle_get(path, query, conn)
      Method.Post -> handle_post(req, conn)
      Method.Put -> handle_put(req, conn)
      _ ->
        (
          error(
            Status.method_not_allowed(),
            "#{req.method.to_string()} is not supported",
          ), conn
        )
    end
  end

  @doc """
  Builds a JSON error response with the given status and message.
  """
  fn error(status: Status, message: String) -> Response
    body: Value = [
      "error": status.reason.to_json(), "message": message.to_json(),
      "status": status.code.to_json()
    ]
    json_response(status, body)
  end

  priv fn handle_get(path: String, query: String, conn: Connection)
    -> (Response, Connection)

    if path == "/"
      return (info(), conn)
    end

    if path == "/links"
      return list_links(query, conn)
    end

    match code_after(path, LINKS_PREFIX)
      Option.Some(code) ->
        metadata(conn, code)

      Option.None ->
        match code_after(path, "/")
          Option.Some(code) -> redirect(conn, code)
          Option.None ->
            (error(Status.not_found(), "no route for #{path}"), conn)
        end
    end
  end

  priv fn handle_post(req: Request, conn: Connection) -> (Response, Connection)
    unless req.path == "/links"
      return (error(Status.not_found(), "no route for POST #{req.path}"), conn)
    end

    match JsonUtil.parse_url(req.body)
      Result.Err(message) ->
        (error(Status.bad_request(), message), conn)

      Result.Ok(url) ->
        (conn, created) = LinkStore.create(conn, url)

        match created
          Result.Ok(link) -> (json_response(Status.created(), link), conn)
          Result.Err(e) -> (db_error(e), conn)
        end
    end
  end

  priv fn handle_put(req: Request, conn: Connection) -> (Response, Connection)
    code =
      match code_after(req.path, LINKS_PREFIX)
        Option.Some(c) -> c
        Option.None ->
          return (
            error(Status.not_found(), "no route for PUT #{req.path}"), conn
          )
      end

    match JsonUtil.parse_url(req.body)
      Result.Err(message) ->
        (error(Status.bad_request(), message), conn)

      Result.Ok(url) ->
        outcome = LinkStore.update(conn, code, url)
        link_or_404(outcome, code)
    end
  end

  priv fn handle_delete(path: String, conn: Connection)
    -> (Response, Connection)

    code =
      match code_after(path, LINKS_PREFIX)
        Option.Some(c) -> c
        Option.None ->
          return (
            error(Status.not_found(), "no route for DELETE #{path}"), conn
          )
      end

    (conn, removed) = LinkStore.remove(conn, code)

    match removed
      Result.Err(e) -> (db_error(e), conn)
      Result.Ok(deleted) ->
        deleted ? (no_content(), conn) : (not_found(code), conn)
    end
  end

  priv fn list_links(query: String, conn: Connection) -> (Response, Connection)
    (limit, offset) =
      match page_params(query)
        Result.Ok(params) -> params
        Result.Err(message) ->
          return (error(Status.bad_request(), message), conn)
      end

    (conn, listed) = LinkStore.page(conn, limit, offset)

    match listed
      Result.Ok(links) -> (json_response(Status.ok(), links), conn)
      Result.Err(e) -> (db_error(e), conn)
    end
  end

  # Parses and bounds the pagination params. `limit` defaults to
  # DEFAULT_LIMIT, `offset` to 0.
  priv fn page_params(query: String) -> (Int, Int) ! String
    limit = try int_param(query, "limit", DEFAULT_LIMIT)
    offset = try int_param(query, "offset", 0)

    unless limit >= 1 and limit <= MAX_LIMIT
      fail "limit must be between 1 and #{MAX_LIMIT}"
    end

    unless offset >= 0
      fail "offset must not be negative"
    end

    (limit, offset)
  end

  priv fn int_param(query: String, name: String, default: Int) -> Int ! String
    match query_param(query, name)
      Option.None -> default
      Option.Some(text) ->
        text.to_int()
          rescue _ -> fail "#{name} must be an integer, got '#{text}'"
    end
  end

  priv fn query_param(query: String, name: String) -> Option<String>
    prefix = name <> "="
    found: Option<String> = Option.None

    for pair in query.split("&")
      if pair.starts_with?(prefix)
        found = Option.Some(pair.slice(
          Range{start: prefix.length(), stop: pair.length() - 1},
        ))
      end
    end

    found
  end

  # Splits a request target into its path and query string, e.g.
  # "/links?limit=10" into ("/links", "limit=10").
  priv fn split_query(target: String) -> (String, String)
    parts = target.split("?")
    (parts.get(0).or(target), parts.get(1).or(""))
  end

  priv fn metadata(conn: Connection, code: String) -> (Response, Connection)
    link_or_404(LinkStore.find(conn, code), code)
  end

  priv fn redirect(conn: Connection, code: String) -> (Response, Connection)
    (conn, visited) = LinkStore.visit(conn, code)

    match visited
      Result.Err(e) ->
        (db_error(e), conn)

      Result.Ok(target) ->
        match target
          Option.Some(url) -> (redirect_response(url), conn)
          Option.None -> (not_found(code), conn)
        end
    end
  end

  priv fn link_or_404(
    outcome: (Connection, Result<Option<Link>, String>),
    code: String,
  ) -> (Response, Connection)

    (conn, found) = outcome

    match found
      Result.Err(e) ->
        (db_error(e), conn)

      Result.Ok(maybe) ->
        match maybe
          Option.Some(link) -> (json_response(Status.ok(), link), conn)
          Option.None -> (not_found(code), conn)
        end
    end
  end

  priv fn info -> Response
    body: Value = [
      "name": "koja-shortener",
      "routes": [
        "GET /links?limit=&offset=", "POST /links", "GET /links/:code",
        "PUT /links/:code", "DELETE /links/:code", "GET /:code"
      ]
    ]
    json_response(Status.ok(), body)
  end

  priv fn not_found(code: String) -> Response
    error(Status.not_found(), "no link with code #{code}")
  end

  priv fn db_error(message: String) -> Response
    error(Status.internal_server_error(), message)
  end

  priv fn json_response<T: JSON.Encoding>(status: Status, body: T) -> Response
    text = JSON.encode_pretty(body)
    headers = Headers.new()
      .set("Content-Type", "application/json")
      .set("Content-Length", "#{text.byte_length()}")
    Response{body: text, headers: headers, status: status, version: "HTTP/1.1"}
  end

  priv fn redirect_response(target: String) -> Response
    headers = Headers.new().set("Location", target).set("Content-Length", "0")
    Response{
      body: "",
      headers: headers,
      status: Status.new(302, "Found"),
      version: "HTTP/1.1",
    }
  end

  priv fn no_content -> Response
    headers = Headers.new().set("Content-Length", "0")
    Response{
      body: "",
      headers: headers,
      status: Status.no_content(),
      version: "HTTP/1.1",
    }
  end

  priv fn code_after(path: String, prefix: String) -> Option<String>
    unless path.starts_with?(prefix)
      return Option.None
    end

    code = path.slice(Range{start: prefix.length(), stop: path.length() - 1})

    if code.empty?() or code.contains?("/")
      return Option.None
    end

    Option.Some(code)
  end
end
