alias HTTP.Headers
alias HTTP.Response
alias HTTP.Status
alias JSON.Value
alias Pooler.Pool
alias Postgres.Connection
alias Trail.Conn
alias Trail.Rejection
alias Trail.Router

const DEFAULT_LIMIT: Int = 100
const MAX_LIMIT: Int = 1000
const CHECKOUT_MS: Int = 5000

@doc """
Why a handler could not answer. Each variant renders as one status,
so a handler fails with the variant and `failure` picks the status.
"""
enum Error
  Database(String)
  NotFound(String)
  Unavailable(String)
  Validation(String)

  fn message(self) -> String
    match self
      Error.Database(text) -> text
      Error.NotFound(text) -> text
      Error.Unavailable(text) -> text
      Error.Validation(text) -> text
    end
  end

  fn status(self) -> Status
    match self
      Error.Database(_) -> Status.internal_server_error()
      Error.NotFound(_) -> Status.not_found()
      Error.Unavailable(_) -> Status.new(503, "Service Unavailable")
      Error.Validation(_) -> Status.bad_request()
    end
  end
end

@doc """
Builds the route table. Every handler captures the pool when the
table is built, so each route is a plain `fn (Conn) -> Conn` closure
and the `Worker` only calls `dispatch`.

- `GET    /`            service info
- `GET    /links`       list links, newest first (`limit` and `offset` query params)
- `POST   /links`       create a link from a JSON `{"url": ...}` body
- `GET    /links/:code` link metadata
- `PUT    /links/:code` repoint a link at a new URL
- `DELETE /links/:code` delete a link
- `GET    /:code`       302-redirect to the target, counting the hit

`/links` is registered before `/:code`, so the static route wins.
The router answers 400, 404, and 405 itself through `reject`, in the
same JSON error shape the handlers use.
"""
fn build_router(pool: Pool<Connection>) -> Router
  Router{}
    .on_reject(&reject/2)
    .get("/", c -> info(c))
    .get("/links", c -> list_links(pool, c))
    .post("/links", c -> create_link(pool, c))
    .get("/links/:code", c -> show_link(pool, c))
    .put("/links/:code", c -> update_link(pool, c))
    .delete("/links/:code", c -> delete_link(pool, c))
    .get("/:code", c -> redirect(pool, c))
end

@doc """
Builds a JSON error response without a `Conn`, for a request the
`Worker` could not parse.
"""
fn error_response(status: Status, message: String) -> Response
  text = JSON.encode(error_body(status, message), pretty())
  headers =
    Headers.new()
    .set("Content-Type", "application/json")
    .set("Content-Length", "#{text.byte_length()}")
  Response{body: text, headers: headers, status: status, version: "HTTP/1.1"}
end

# --- handlers ---

priv fn info(c: Conn) -> Conn
  body: Value = [
    "name": "koja-shortener",
    "routes": [
      "GET /links?limit=&offset=", "POST /links", "GET /links/:code",
      "PUT /links/:code", "DELETE /links/:code", "GET /:code"
    ]
  ]
  json(c, Status.ok(), body)
end

priv fn list_links(pool: Pool<Connection>, c: Conn) -> Conn
  do_list(pool, c) rescue e -> failure(c, e)
end

priv fn do_list(pool: Pool<Connection>, c: Conn) -> Conn ! Error
  (limit, offset) = try page_params(c)
  links = try with_db(pool, db -> LinkStore.page(db, limit, offset))
  json(c, Status.ok(), links)
end

priv fn create_link(pool: Pool<Connection>, c: Conn) -> Conn
  do_create(pool, c) rescue e -> failure(c, e)
end

priv fn do_create(pool: Pool<Connection>, c: Conn) -> Conn ! Error
  url = JsonUtil.parse_url(c.body) rescue m -> fail Error.Validation(m)
  link = try with_db(pool, db -> LinkStore.create(db, url))
  json(c, Status.created(), link)
end

priv fn show_link(pool: Pool<Connection>, c: Conn) -> Conn
  do_show(pool, c) rescue e -> failure(c, e)
end

priv fn do_show(pool: Pool<Connection>, c: Conn) -> Conn ! Error
  code = code_param(c)
  link = try with_db(pool, db -> LinkStore.find(db, code))
  json(c, Status.ok(), try found(link, code))
end

priv fn update_link(pool: Pool<Connection>, c: Conn) -> Conn
  do_update(pool, c) rescue e -> failure(c, e)
end

priv fn do_update(pool: Pool<Connection>, c: Conn) -> Conn ! Error
  code = code_param(c)
  url = JsonUtil.parse_url(c.body) rescue m -> fail Error.Validation(m)
  link = try with_db(pool, db -> LinkStore.update(db, code, url))
  json(c, Status.ok(), try found(link, code))
end

priv fn delete_link(pool: Pool<Connection>, c: Conn) -> Conn
  do_delete(pool, c) rescue e -> failure(c, e)
end

priv fn do_delete(pool: Pool<Connection>, c: Conn) -> Conn ! Error
  code = code_param(c)
  removed = try with_db(pool, db -> LinkStore.remove(db, code))

  if not removed
    fail Error.NotFound("no link with code #{code}")
  end

  c.resp(Status.no_content(), "")
end

priv fn redirect(pool: Pool<Connection>, c: Conn) -> Conn
  do_redirect(pool, c) rescue e -> failure(c, e)
end

priv fn do_redirect(pool: Pool<Connection>, c: Conn) -> Conn ! Error
  code = code_param(c)
  target = try with_db(pool, db -> LinkStore.visit(db, code))

  match target
    Option.Some(url) ->
      c.resp(Status.new(302, "Found"), "").put_resp_header("Location", url)

    Option.None ->
      fail Error.NotFound("no link with code #{code}")
  end
end

# --- database access ---

# Checks a connection out of the pool, runs `work`, and checks the
# updated connection back in. The pool's `valid` check drops a
# connection that comes back broken, so nothing here discards.
priv fn with_db<T>(
  pool: Pool<Connection>,
  work: fn (Connection) -> (Connection, Result<T, String>),
) -> T ! Error

  lease = pool.checkout(CHECKOUT_MS)
    rescue _ -> fail Error.Unavailable("no database connection available")

  (db, outcome) = work(lease.resource)
  lease.resource = db
  pool.checkin(lease)
  outcome rescue message -> fail Error.Database(message)
end

priv fn found(link: Option<Link>, code: String) -> Link ! Error
  match link
    Option.Some(found) -> found
    Option.None -> fail Error.NotFound("no link with code #{code}")
  end
end

# --- request reads ---

priv fn code_param(c: Conn) -> String
  c.param("code").or("")
end

# Parses and bounds the pagination params. `limit` defaults to
# DEFAULT_LIMIT, `offset` to 0.
priv fn page_params(c: Conn) -> (Int, Int) ! Error
  limit = try int_param(c, "limit", DEFAULT_LIMIT)
  offset = try int_param(c, "offset", 0)

  if limit < 1 or limit > MAX_LIMIT
    fail Error.Validation("limit must be between 1 and #{MAX_LIMIT}")
  end

  if offset < 0
    fail Error.Validation("offset must not be negative")
  end

  (limit, offset)
end

priv fn int_param(c: Conn, name: String, default: Int) -> Int ! Error
  match c.query_param(name)
    Option.None -> default
    Option.Some(text) ->
      text.to_int()
        rescue _ -> fail Error.Validation("#{name} must be an integer, got '#{text}'")
  end
end

# --- responses ---

priv fn json<T: JSON.Encoding>(c: Conn, status: Status, body: T) -> Conn
  text = JSON.encode(body, pretty())
  c.resp(status, text).put_resp_header("Content-Type", "application/json")
end

priv fn failure(c: Conn, e: Error) -> Conn
  json(c, e.status(), error_body(e.status(), e.message()))
end

# Renders the answers the router gives without a handler in the same
# error shape.
priv fn reject(c: Conn, rejection: Rejection) -> Conn
  message =
    match rejection
      Rejection.BadRequest(_) ->
        "malformed encoding in path or query"

      Rejection.MethodNotAllowed(_) ->
        "#{c.method.to_string()} is not supported"

      Rejection.NotFound ->
        "no route for #{c.path}"
    end

  json(c, rejection.status(), error_body(rejection.status(), message))
end

priv fn error_body(status: Status, message: String) -> Value
  [
    "error": status.reason.to_json(), "message": message.to_json(),
    "status": status.code.to_json()
  ]
end

priv fn pretty -> JSON.EncodeOptions
  JSON.EncodeOptions{pretty?: true}
end
