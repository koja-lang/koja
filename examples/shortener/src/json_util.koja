alias JSON.Value

@doc """
JSON request helpers.
"""
struct JsonUtil
  @doc """
  Extracts a non-empty `url` string from a JSON request body, or
  fails with a human-readable error describing what was wrong.
  """
  fn parse_url(body: String) -> String ! String
    decoded = JSON.decode(body) rescue _ -> fail "body is not valid JSON"

    match field(decoded, "url")
      Option.None ->
        fail "missing \"url\" field"

      Option.Some(Value.String(url)) ->
        if url.empty?()
          fail "\"url\" must not be empty"
        end

        url

      Option.Some(_) ->
        fail "\"url\" must be a string"
    end
  end

  priv fn field(value: Value, key: String) -> Option<Value>
    match value
      Value.Object(entries) -> scan(entries, key, 0)
      _ -> Option.None
    end
  end

  priv fn scan(entries: List<(String, Value)>, key: String, index: Int)
    -> Option<Value>

    if index >= entries.length()
      return Option.None
    end

    (entry_key, entry_value) = entries.get(index).unwrap()
    entry_key == key ? Option.Some(entry_value) : scan(entries, key, index + 1)
  end
end
