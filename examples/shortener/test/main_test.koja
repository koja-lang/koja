struct JsonUtilTest
  @test "parse_url extracts a url from a JSON body"
  fn test_parse_url_ok -> Bool ! String
    url = JsonUtil.parse_url("{\"url\": \"https://example.com\"}")
      rescue e -> fail "expected Ok, got error `#{e}`"

    unless url == "https://example.com"
      fail "got unexpected url `#{url}`"
    end

    true
  end

  @test "parse_url rejects a missing url field"
  fn test_parse_url_missing -> Bool ! String
    match JsonUtil.parse_url("{\"href\": \"https://example.com\"}")
      Result.Err(_) -> true
      Result.Ok(_) -> fail "expected an error for a missing url"
    end
  end

  @test "parse_url rejects a non-string url"
  fn test_parse_url_wrong_type -> Bool ! String
    match JsonUtil.parse_url("{\"url\": 42}")
      Result.Err(_) -> true
      Result.Ok(_) -> fail "expected an error for a non-string url"
    end
  end

  @test "parse_url rejects invalid JSON"
  fn test_parse_url_invalid -> Bool ! String
    match JsonUtil.parse_url("not json")
      Result.Err(_) -> true
      Result.Ok(_) -> fail "expected an error for invalid JSON"
    end
  end

  @test "Link encoding serializes every field"
  fn test_link_encoding -> Bool ! String
    link = Link{
      code: "abc123",
      created_at: "2026-01-01 00:00:00+00",
      hits: 7,
      url: "https://example.com",
    }
    encoded = JSON.encode(link)

    unless encoded.contains?("\"code\":\"abc123\"")
      fail "missing code in `#{encoded}`"
    end

    unless encoded.contains?("\"hits\":7")
      fail "missing hits in `#{encoded}`"
    end

    unless encoded.contains?("\"short_path\":\"/abc123\"")
      fail "missing short_path in `#{encoded}`"
    end

    true
  end
end
