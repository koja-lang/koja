alias Test.require

test "parse_url extracts a url from a JSON body"
  url = try require(JsonUtil.parse_url("{\"url\": \"https://example.com\"}"))
  assert url == "https://example.com"
end

test "parse_url rejects a missing url field"
  assert JsonUtil.parse_url("{\"href\": \"https://example.com\"}").err?()
end

test "parse_url rejects a non-string url"
  assert JsonUtil.parse_url("{\"url\": 42}").err?()
end

test "parse_url rejects invalid JSON"
  assert JsonUtil.parse_url("not json").err?()
end

test "Link encoding serializes every field"
  link = Link{
    code: "abc123",
    created_at: "2026-01-01 00:00:00+00",
    hits: 7,
    url: "https://example.com",
  }
  encoded = JSON.encode(link)

  assert encoded.contains?("\"code\":\"abc123\""), encoded
  assert encoded.contains?("\"hits\":7"), encoded
  assert encoded.contains?("\"short_path\":\"/abc123\""), encoded
end
