alias Gh.GitHub.Repo
alias Gh.GitHub.User
alias JSON.Value

# Trimmed-down captures of real GitHub API payloads; `null` and
# missing keys exercise the zero-value folding in `Fields`.
const USER_JSON: String = "{\"login\": \"octocat\", \"name\": \"The Octocat\", \"company\": \"@github\", \"blog\": \"https://github.blog\", \"location\": \"San Francisco\", \"bio\": null, \"public_repos\": 8, \"followers\": 9999, \"following\": 9, \"created_at\": \"2011-01-25T18:44:36Z\"}"
const REPO_JSON: String = "{\"full_name\": \"octocat/Hello-World\", \"description\": \"My first repository on GitHub!\", \"fork\": false, \"language\": null, \"stargazers_count\": 2500, \"forks_count\": 1300, \"updated_at\": \"2026-06-01T12:00:00Z\"}"

struct FieldsTest
  @test "text folds null and missing keys to empty string"
  fn test_text_zero_values -> Bool ! String
    value = try decode_fixture(USER_JSON)

    unless Fields.text(value, "bio") == ""
      fail "null bio should read as empty"
    end

    unless Fields.text(value, "no_such_key") == ""
      fail "missing key should read as empty"
    end

    unless Fields.text(value, "login") == "octocat"
      fail "expected login to be octocat"
    end

    true
  end

  @test "number and flag read typed fields"
  fn test_number_and_flag -> Bool ! String
    value = try decode_fixture(REPO_JSON)

    unless Fields.number(value, "stargazers_count") == 2500
      fail "expected 2500 stars"
    end

    unless Fields.number(value, "missing") == 0
      fail "missing number should read as 0"
    end

    if Fields.flag(value, "fork")
      fail "expected fork to be false"
    end

    true
  end
end

struct RenderTest
  @test "user payload renders a profile"
  fn test_render_user -> Bool ! String
    value = try decode_fixture(USER_JSON)
    rendered = Cli.render_user(User.from_json(value))

    unless rendered.contains?("The Octocat (@octocat)")
      fail "missing title line in:\n#{rendered}"
    end

    unless rendered.contains?("joined: 2011-01-25")
      fail "missing joined date in:\n#{rendered}"
    end

    unless rendered.contains?("8 public repos · 9999 followers · 9 following")
      fail "missing counts line in:\n#{rendered}"
    end

    true
  end

  @test "repo payload renders a detail view"
  fn test_render_repo -> Bool ! String
    value = try decode_fixture(REPO_JSON)
    rendered = Cli.render_repo(Repo.from_json(value))

    unless rendered.contains?("octocat/Hello-World")
      fail "missing repo name in:\n#{rendered}"
    end

    unless rendered.contains?("stars: 2500")
      fail "missing stars in:\n#{rendered}"
    end

    unless rendered.contains?("My first repository on GitHub!")
      fail "missing description in:\n#{rendered}"
    end

    true
  end

  @test "unknown commands and missing args fail with usage hints"
  fn test_dispatch_errors -> Bool ! String
    match Cli.dispatch(["frobnicate"])
      Result.Ok(_) ->
        fail "unknown command should fail"

      Result.Err(e) ->
        unless e.contains?("unknown command: frobnicate")
          fail "unexpected message: #{e}"
        end
    end

    match Cli.dispatch(["user"])
      Result.Ok(_) ->
        fail "missing login should fail"

      Result.Err(e) ->
        unless e.contains?("missing argument")
          fail "unexpected message: #{e}"
        end
    end

    true
  end
end

priv fn decode_fixture(raw: String) -> Value ! String
  JSON.decode(raw) rescue e -> fail "fixture did not decode: #{e}"
end
