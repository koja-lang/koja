# A campground takes bookings. Each part of this tour adds one idea
# and builds on itself.

# An enum is one of several variants. A `match` covers each one.
enum Shelter
  Cabin
  Hut
  Tent
end

fn nightly_rate(shelter: Shelter) -> Int
  match shelter
    Shelter.Cabin -> 90
    Shelter.Hut -> 45
    Shelter.Tent -> 20
  end
end

# A struct holds data and functions. A constant can hold a struct.
struct Site
  capacity: Int
  shelter: Shelter

  fn cost(self, nights: Int) -> Int
    nightly_rate(self.shelter) * nights
  end
end

const OVERFLOW = Site{capacity: 2, shelter: Shelter.Tent}

# A map pairs keys with values. This one is an index of the sites by name.
sites: Map<String, Site> = [
  "Koja": Site{capacity: 2, shelter: Shelter.Hut},
  "Lakeside": Site{capacity: 4, shelter: Shelter.Tent},
  "Ridge": Site{capacity: 6, shelter: Shelter.Cabin}
]

# `get` returns an `Option`, because the key can be absent.
for name in ["Koja", "Ridge", "Summit"]
  match sites.get(name)
    Option.Some(site) -> IO.puts("#{name} sleeps #{site.capacity}")
    Option.None -> IO.puts("#{name} is not a site")
  end
end

# A list holds values in order. A closure runs on each one.
ridge = sites.get("Ridge").or(OVERFLOW)
costs = [1, 2, 3].map(nights -> ridge.cost(nights))
IO.puts("Ridge costs #{costs} for one, two, and three nights")

# A union is one of several types. A booking counts its guests or names them.
type Guests = Int | List<String>

fn head_count(guests: Guests) -> Int
  match guests
    count: Int -> count
    names: List<String> -> names.length()
  end
end

# A function that can fail names its error after `!`.
enum BookingError
  NotFound
  TooManyGuests(Int)
end

fn find(sites: Map<String, Site>, name: String) -> Site ! BookingError
  match sites.get(name)
    Option.Some(site) -> site
    Option.None -> fail BookingError.NotFound
  end
end

# `try` passes the error of a call on to the caller.
fn book(sites: Map<String, Site>, name: String, guests: Guests)
  -> Site ! BookingError

  site = try find(sites, name)

  if head_count(guests) > site.capacity
    fail BookingError.TooManyGuests(site.capacity)
  end

  site
end

match book(sites, "Koja", ["Ann", "Bo", "Cy"])
  Result.Ok(site) -> IO.puts("booked for #{site.cost(2)}")
  Result.Err(error) -> IO.puts("not booked: #{error}")
end

# `rescue` handles the error in place.
site = book(sites, "Summit", 2) rescue _ -> OVERFLOW
IO.puts("a walk-in pays #{site.cost(1)} for one night")
