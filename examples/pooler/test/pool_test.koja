struct PoolTest
  priv fn int_pool(size: Int) -> Pool<Int>
    config = Config{
      create: fn () -> Result<Int, String> Result.Ok(7) end,
      size: size,
    }

    Pool.start(config)
  end

  @test "checkout lends a resource and checkin returns the updated value"
  fn test_round_trip -> Bool ! String
    pool = int_pool(1)
    first = pool.checkout(1000) rescue _ -> fail "first checkout failed"

    if first != 7
      fail "expected fresh resource 7, got #{first}"
    end

    pool.checkin(first + 1)

    second = pool.checkout(1000) rescue _ -> fail "second checkout failed"
    pool.stop()

    unless second == 8
      fail "expected checked-in 8, got #{second}"
    end

    true
  end

  @test "an exhausted pool queues callers until a checkin"
  fn test_waitlist -> Bool ! String
    pool = int_pool(1)
    lent = pool.checkout(1000) rescue _ -> fail "initial checkout failed"
    waiter = Task.async(fn () -> Result<Int, Error> pool.checkout(3000) end)

    pool.checkin(lent)

    outcome = Task.await(waiter) rescue _ -> fail "waiter task failed"
    pool.stop()

    match outcome
      Result.Ok(_) -> ()
      Result.Err(_) -> fail "queued checkout should be answered by checkin"
    end

    true
  end

  @test "checkout times out when every resource stays lent"
  fn test_timeout -> Bool ! String
    pool = int_pool(1)
    _ = pool.checkout(1000) rescue _ -> fail "initial checkout failed"

    second = pool.checkout(100)
    pool.stop()

    match second
      Result.Err(Error.Timeout) -> true
      Result.Err(_) -> fail "expected Timeout error"
      Result.Ok(_) -> fail "checkout should not succeed on an exhausted pool"
    end
  end

  @test "discard builds a replacement resource"
  fn test_discard -> Bool ! String
    pool = int_pool(1)
    _ = pool.checkout(1000) rescue _ -> fail "initial checkout failed"

    pool.discard(1000) rescue _ -> fail "discard failed"

    replacement = pool.checkout(1000)
      rescue _ -> fail "checkout after discard failed"

    pool.stop()

    unless replacement == 7
      fail "expected replacement 7, got #{replacement}"
    end

    true
  end

  @test "a failing factory brings the pool down"
  fn test_start_failure -> Bool ! String
    config = Config{
      create: fn () -> Result<Int, String> Result.Err("boom") end,
      size: 1,
    }

    pool = Pool.start(config)

    match pool.checkout(1000)
      Result.Err(Error.PoolDown) -> true
      Result.Err(_) -> fail "expected PoolDown error"
      Result.Ok(_) -> fail "checkout should not succeed on a dead pool"
    end
  end
end
