alias HTTP.Headers
alias HTTP.Method
alias IO.Error as IOError
alias JSON.Value
alias Net.Socket.Error as SocketError
alias Net.TLSError

const API_ROOT: String = "https://api.github.com"

@doc """
A minimal GitHub REST API client over the stdlib HTTPS stack:
`HTTP.request` rides `TCPSocket.connect_tls`, which verifies the
api.github.com certificate against the system trust store.

Requests are unauthenticated by default (60 requests/hour); set
`GITHUB_TOKEN` to send an `Authorization` header and raise the limit.
"""
struct Client
  @doc """
  Fetches a repository by its `owner/name` path.
  """
  fn repo(full_name: String) -> Repo ! String
    value = try fetch("/repos/#{full_name}")
    Repo.from_json(value)
  end

  @doc """
  Fetches a user's repositories, most recently updated first.
  """
  fn repos(login: String) -> List<Repo> ! String
    value = try fetch("/users/#{login}/repos?sort=updated&per_page=20")

    match value
      items: List<Value> -> items.map(item -> Repo.from_json(item))
      _ -> fail "expected a JSON array of repositories"
    end
  end

  @doc """
  Fetches a user profile by login.
  """
  fn user(login: String) -> User ! String
    value = try fetch("/users/#{login}")
    User.from_json(value)
  end

  priv fn decode(body: String) -> Value ! String
    JSON.decode(body) rescue e -> fail "malformed JSON from GitHub: #{e}"
  end

  # The client fails with a union of four error types. A union has no
  # `message`, so the match picks the member and asks it.
  priv fn error_message(e: HTTP.Error | SocketError | IOError | TLSError)
    -> String

    match e
      http_error: HTTP.Error -> http_error.message()
      socket_error: SocketError -> socket_error.message()
      io_error: IOError -> io_error.message()
      tls_error: TLSError -> tls_error.message()
    end
  end

  priv fn fetch(path: String) -> Value ! String
    response = HTTP.request(Method.Get, "#{API_ROOT}#{path}", headers(), "")
      rescue e -> fail error_message(e)

    match response.status.code
      _ when response.status.ok?() ->
        text = response.text()
          rescue _ -> fail "GitHub sent a body that is not valid UTF-8"

        try decode(text)

      403 ->
        fail "rate limited or forbidden -- set GITHUB_TOKEN to authenticate"

      404 ->
        fail "not found: #{path}"

      code ->
        fail "GitHub returned HTTP #{code}"
    end
  end

  priv fn headers -> Headers
    base =
      Headers.new()
      .set("Accept", "application/vnd.github+json")
      .set("User-Agent", "koja-gh")

    match System.get_env("GITHUB_TOKEN")
      Option.Some(token) -> base.set("Authorization", "Bearer #{token}")
      Option.None -> base
    end
  end
end
