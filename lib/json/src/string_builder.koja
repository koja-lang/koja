@doc """
A string builder that accumulates fragments and joins them at the
end. Deprecated since string concat now grows the left side in place
when it holds the only reference, so a plain `out = out <> part`
loop is already linear.
"""
@deprecated """
Accumulate with `<>` directly, or use `String.join`. This struct
will be removed in 0.19.0.
"""
struct StringBuilder
  parts: List<String>

  @doc """
  Creates an empty builder.
  """
  fn new -> StringBuilder
    StringBuilder{parts: List.new()}
  end

  @doc """
  Appends one fragment and returns the updated builder.
  """
  fn add(self, s: String) -> StringBuilder
    StringBuilder{parts: self.parts.append(s)}
  end

  @doc """
  Joins all fragments into the final string.
  """
  fn build(self) -> String
    String.join(self.parts, "")
  end
end
