@doc """
A protocol for types that have a JSON value representation.
"""
protocol Encoding
  @doc """
  Converts `self` to a JSON `Value` tree. `JSON.encode` calls this
  before it writes text. A `Value` conforms because each of its six
  types does.
  """
  fn to_json(self) -> Value
end

@doc """
Options for JSON text encoding.
"""
struct EncodeOptions
  pretty?: Bool = false
end

@doc """
Encodes `value` as JSON text.
"""
fn encode<T: Encoding>(value: T, options: EncodeOptions = EncodeOptions{})
  -> String

  options.pretty?
    ? Encoder.encode_pretty(value.to_json())
    : Encoder.encode(value.to_json())
end

@doc """
Decodes JSON text to a value tree.
"""
fn decode(input: String) -> Value ! String
  try Decoder.decode(input)
end

@doc """
Returns the value of `key` when `value` is an object that has the
key. Returns `None` for an object with no such key and for a value
that is not an object. See `Object.get`.
"""
fn get(value: Value, key: String) -> Option<Value>
  match value
    object: Object -> object.get(key)
    _ -> Option.None
  end
end

impl Encoding for Array
  @doc """
  Returns this array as a JSON value.
  """
  fn to_json(self) -> Value
    self
  end
end

impl Encoding for Bool
  @doc """
  Returns this boolean as a JSON value.
  """
  fn to_json(self) -> Value
    self
  end
end

impl Encoding for Float
  @doc """
  Returns this float as a JSON number.
  """
  fn to_json(self) -> Value
    Number.from_float(self)
  end
end

impl Encoding for Int
  @doc """
  Returns this integer as a JSON number.
  """
  fn to_json(self) -> Value
    Number.from_int(self)
  end
end

impl Encoding for Null
  @doc """
  Returns this null as a JSON value.
  """
  fn to_json(self) -> Value
    self
  end
end

impl Encoding for Number
  @doc """
  Returns this number as a JSON value.
  """
  fn to_json(self) -> Value
    self
  end
end

impl Encoding for Object
  @doc """
  Returns this object as a JSON value.
  """
  fn to_json(self) -> Value
    self
  end
end

impl Encoding for String
  @doc """
  Returns this string as a JSON value.
  """
  fn to_json(self) -> Value
    self
  end
end

impl Encoding for List<T: Encoding>
  @doc """
  Encodes each item as a JSON array item.
  """
  fn to_json(self) -> Value
    items: List<Value> = []

    for item in self
      items = items.append(item.to_json())
    end

    Array{items: items}
  end
end
