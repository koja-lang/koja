priv struct Encoder
  fn encode(value: Value) -> String
    Encoder.encode_value(value)
  end

  fn encode_pretty(value: Value) -> String
    Encoder.encode_value_pretty(value, 0)
  end

  priv fn encode_value(value: Value) -> String
    match value
      Value.Null -> "null"
      Value.Bool(b) -> b ? "true" : "false"
      Value.Int(n) -> "#{n}"
      Value.Float(f) -> "#{f}"
      Value.String(s) -> Encoder.encode_string(s)
      Value.Array(items) -> Encoder.encode_array(items)
      Value.Object(entries) -> Encoder.encode_object(entries)
    end
  end

  # Escapes with whole-string replace passes instead of a per-character
  # loop, so cost stays linear in the string length. Backslash goes
  # first because later passes introduce new backslashes.
  priv fn encode_string(s: String) -> String
    escaped = s.replace("\\", "\\\\")
      .replace("\"", "\\\"")
      .replace("\n", "\\n")
      .replace("\r", "\\r")
      .replace("\t", "\\t")

    "\"" <> escaped <> "\""
  end

  priv fn encode_array(items: List<Value>) -> String
    if items.empty?()
      return "[]"
    end

    out = "["
    i = 0

    while i < items.length()
      if i > 0
        out = out <> ","
      end

      out = out <> Encoder.encode_value(items.get(i).unwrap())
      i += 1
    end

    out <> "]"
  end

  priv fn encode_object(entries: List<(String, Value)>) -> String
    if entries.empty?()
      return "{}"
    end

    out = "{"
    i = 0

    while i < entries.length()
      if i > 0
        out = out <> ","
      end

      (key, value) = entries.get(i).unwrap()
      out = out <> Encoder.encode_string(key) <> ":" <>
        Encoder.encode_value(value)
      i += 1
    end

    out <> "}"
  end

  priv fn encode_value_pretty(value: Value, indent: Int) -> String
    match value
      Value.Null ->
        "null"

      Value.Bool(b) ->
        if b
          "true"
        else
          "false"
        end

      Value.Int(n) ->
        "#{n}"

      Value.Float(f) ->
        "#{f}"

      Value.String(s) ->
        Encoder.encode_string(s)

      Value.Array(items) ->
        Encoder.encode_array_pretty(items, indent)

      Value.Object(entries) ->
        Encoder.encode_object_pretty(entries, indent)
    end
  end

  priv fn make_indent(level: Int) -> String
    result = ""
    i = 0

    while i < level
      result = result <> "  "
      i += 1
    end

    result
  end

  priv fn encode_array_pretty(items: List<Value>, indent: Int) -> String
    if items.empty?()
      return "[]"
    end

    inner = indent + 1
    out = "[\n"
    i = 0

    while i < items.length()
      if i > 0
        out = out <> ",\n"
      end

      out = out <> Encoder.make_indent(inner)
      out = out <> Encoder.encode_value_pretty(items.get(i).unwrap(), inner)
      i += 1
    end

    out <> "\n" <> Encoder.make_indent(indent) <> "]"
  end

  priv fn encode_object_pretty(entries: List<(String, Value)>, indent: Int)
    -> String

    if entries.empty?()
      return "{}"
    end

    inner = indent + 1
    out = "{\n"
    i = 0

    while i < entries.length()
      if i > 0
        out = out <> ",\n"
      end

      (key, value) = entries.get(i).unwrap()
      out = out <> Encoder.make_indent(inner)
      out = out <> Encoder.encode_string(key)
      out = out <> ": " <> Encoder.encode_value_pretty(value, inner)
      i += 1
    end

    out <> "\n" <> Encoder.make_indent(indent) <> "}"
  end
end
