priv const BYTE_BACKSLASH: Int = 92
priv const BYTE_COLON: Int = 58
priv const BYTE_COMMA: Int = 44
priv const BYTE_DOT: Int = 46
priv const BYTE_LBRACE: Int = 123
priv const BYTE_LBRACKET: Int = 91
priv const BYTE_LOWER_E: Int = 101
priv const BYTE_LOWER_F: Int = 102
priv const BYTE_LOWER_N: Int = 110
priv const BYTE_LOWER_T: Int = 116
priv const BYTE_MINUS: Int = 45
priv const BYTE_NEWLINE: Int = 10
priv const BYTE_NINE: Int = 57
priv const BYTE_PLUS: Int = 43
priv const BYTE_QUOTE: Int = 34
priv const BYTE_RBRACE: Int = 125
priv const BYTE_RBRACKET: Int = 93
priv const BYTE_RETURN: Int = 13
priv const BYTE_SPACE: Int = 32
priv const BYTE_TAB: Int = 9
priv const BYTE_UPPER_E: Int = 69
priv const BYTE_ZERO: Int = 48

priv struct Decoder
  input: Binary
  size: Int

  fn decode(input: String) -> Value ! String
    bytes = input.to_binary()
    d = Decoder{input: bytes, size: bytes.byte_size()}

    (value, next_pos) = try d.parse_value_at(d.skip_ws(0))
    rest = d.skip_ws(next_pos)

    if rest < d.size
      fail "unexpected trailing content at position #{rest}"
    end

    value
  end

  priv fn parse_value_at(self, pos: Int) -> (Value, Int) ! String
    if pos >= self.size
      fail "unexpected end of input at position #{pos}"
    end

    b = self.byte(pos)

    cond
      b == BYTE_LOWER_N -> try self.parse_null(pos)
      b == BYTE_LOWER_T or b == BYTE_LOWER_F -> try self.parse_bool(pos)
      b == BYTE_QUOTE -> try self.parse_string(pos)
      b == BYTE_LBRACKET -> try self.parse_array(pos)
      b == BYTE_LBRACE -> try self.parse_object(pos)
      b == BYTE_MINUS or Decoder.digit?(b) -> try self.parse_number(pos)
      else ->
        fail "unexpected character '#{self.text(pos, pos)}' at position #{pos}"
    end
  end

  priv fn parse_null(self, pos: Int) -> (Value, Int) ! String
    if pos + 4 > self.size or self.text(pos, pos + 3) != "null"
      fail "expected 'null' at position #{pos}"
    end

    (Value.Null, pos + 4)
  end

  priv fn parse_bool(self, pos: Int) -> (Value, Int) ! String
    if pos + 4 <= self.size and self.text(pos, pos + 3) == "true"
      return (Value.Bool(true), pos + 4)
    end

    if pos + 5 <= self.size and self.text(pos, pos + 4) == "false"
      return (Value.Bool(false), pos + 5)
    end

    fail "expected 'true' or 'false' at position #{pos}"
  end

  priv fn parse_number(self, pos: Int) -> (Value, Int) ! String
    i = pos

    if self.peek?(i, BYTE_MINUS)
      i += 1
    end

    if not self.digit_at?(i)
      fail "expected digit at position #{i}"
    end

    i = self.consume_digits(i)
    is_float = false

    if self.peek?(i, BYTE_DOT)
      is_float = true
      i += 1

      if not self.digit_at?(i)
        fail "expected digit after decimal point at position #{i}"
      end

      i = self.consume_digits(i)
    end

    if self.peek?(i, BYTE_LOWER_E) or self.peek?(i, BYTE_UPPER_E)
      is_float = true
      i += 1

      if self.peek?(i, BYTE_PLUS) or self.peek?(i, BYTE_MINUS)
        i += 1
      end

      if not self.digit_at?(i)
        fail "expected digit in exponent at position #{i}"
      end

      i = self.consume_digits(i)
    end

    num_str = self.text(pos, i - 1)

    if is_float
      f = num_str.to_float()
        rescue e -> fail "invalid float '#{num_str}' at position #{pos}: #{e}"

      return (Value.Float(f), i)
    end

    n = num_str.to_int()
      rescue e -> fail "invalid integer '#{num_str}' at position #{pos}: #{e}"

    (Value.Int(n), i)
  end

  priv fn consume_digits(self, start: Int) -> Int
    i = start

    while i < self.size
      if not Decoder.digit?(self.byte(i))
        return i
      end

      i += 1
    end

    i
  end

  priv fn parse_string(self, pos: Int) -> (Value, Int) ! String
    (string, next_pos) = try self.parse_raw_string(pos)
    (Value.String(string), next_pos)
  end

  priv fn parse_raw_string(self, pos: Int) -> (String, Int) ! String
    if not self.peek?(pos, BYTE_QUOTE)
      fail "expected '\"' at position #{pos}"
    end

    try self.scan_string(pos + 1, pos)
  end

  # Fast path for string contents. Scan for the closing quote and cut
  # the value out as one slice. Falls over to `scan_escaped` at the
  # first backslash.
  priv fn scan_string(self, start: Int, open: Int) -> (String, Int) ! String
    i = start

    while i < self.size
      b = self.byte(i)

      if b == BYTE_QUOTE
        return (self.text(start, i - 1), i + 1)
      end

      if b == BYTE_BACKSLASH
        return try self.scan_escaped(start, i, open, StringBuilder.new())
      end

      i += 1
    end

    fail "unterminated string starting at position #{open}"
  end

  # Slow path for strings containing escapes. Accumulate the slices
  # between escapes plus each unescaped character. `start` tracks the
  # beginning of the pending unflushed segment.
  priv fn scan_escaped(
    self,
    seg_start: Int,
    pos: Int,
    open: Int,
    sb: StringBuilder,
  ) -> (String, Int) ! String

    start = seg_start
    i = pos

    while i < self.size
      b = self.byte(i)

      if b == BYTE_QUOTE
        if start <= i - 1
          sb = sb.add(self.text(start, i - 1))
        end

        return (sb.build(), i + 1)
      end

      if b == BYTE_BACKSLASH
        if i + 1 >= self.size
          fail "unexpected end of string escape at position #{i}"
        end

        match Decoder.unescape(self.byte(i + 1))
          Option.Some(unescaped) ->
            if start <= i - 1
              sb = sb.add(self.text(start, i - 1))
            end

            sb = sb.add(unescaped)
            start = i + 2

          # Unknown escapes (e.g. \uXXXX) pass through verbatim:
          # leave the backslash and escape byte in the segment.
          Option.None ->
            ()
        end

        i += 2
      else
        i += 1
      end
    end

    fail "unterminated string starting at position #{open}"
  end

  priv fn parse_array(self, pos: Int) -> (Value, Int) ! String
    i = self.skip_ws(pos + 1)
    items: List<Value> = List.new()

    if self.peek?(i, BYTE_RBRACKET)
      return (Value.Array(items), i + 1)
    end

    try self.parse_array_elements(items, i, pos)
  end

  # One element per call. Recurses past each ',' with the elements
  # parsed so far and returns at ']'.
  priv fn parse_array_elements(
    self,
    items: List<Value>,
    pos: Int,
    arr_start: Int,
  ) -> (Value, Int) ! String

    i = self.skip_ws(pos)
    (value, next_pos) = try self.parse_value_at(i)
    items = items.append(value)
    i = self.skip_ws(next_pos)

    if i >= self.size
      fail "unterminated array starting at position #{arr_start}"
    end

    b = self.byte(i)

    if b == BYTE_RBRACKET
      return (Value.Array(items), i + 1)
    end

    if b != BYTE_COMMA
      fail "expected ',' or ']' in array at position #{i}"
    end

    try self.parse_array_elements(items, i + 1, arr_start)
  end

  priv fn parse_object(self, pos: Int) -> (Value, Int) ! String
    i = self.skip_ws(pos + 1)
    entries: List<(String, Value)> = List.new()

    if self.peek?(i, BYTE_RBRACE)
      return (Value.Object(entries), i + 1)
    end

    try self.parse_object_entries(entries, i, pos)
  end

  # One entry per call, same recursion shape as parse_array_elements.
  priv fn parse_object_entries(
    self,
    entries: List<(String, Value)>,
    pos: Int,
    obj_start: Int,
  ) -> (Value, Int) ! String

    i = self.skip_ws(pos)

    (key, next_pos) = self.parse_raw_string(i)
      rescue msg -> fail "expected string key in object: #{msg}"

    i = self.skip_ws(next_pos)

    if not self.peek?(i, BYTE_COLON)
      fail "expected ':' after object key at position #{i}"
    end

    i = self.skip_ws(i + 1)

    (value, next_pos) = try self.parse_value_at(i)
    entries = entries.append((key, value))
    i = self.skip_ws(next_pos)

    if i >= self.size
      fail "unterminated object starting at position #{obj_start}"
    end

    b = self.byte(i)

    if b == BYTE_RBRACE
      return (Value.Object(entries), i + 1)
    end

    if b != BYTE_COMMA
      fail "expected ',' or '}' in object at position #{i}"
    end

    try self.parse_object_entries(entries, i + 1, obj_start)
  end

  # The byte at `pos`. Callers guarantee `pos` is in bounds.
  priv fn byte(self, pos: Int) -> Int
    self.input.at(pos).unwrap()
  end

  priv fn digit?(b: Int) -> Bool
    b >= BYTE_ZERO and b <= BYTE_NINE
  end

  priv fn digit_at?(self, pos: Int) -> Bool
    pos >= 0 and pos < self.size and Decoder.digit?(self.byte(pos))
  end

  priv fn peek?(self, pos: Int, expected: Int) -> Bool
    pos >= 0 and pos < self.size and self.byte(pos) == expected
  end

  priv fn skip_ws(self, pos: Int) -> Int
    i = pos

    while i < self.size
      b = self.byte(i)

      if b != BYTE_SPACE and b != BYTE_NEWLINE and b != BYTE_RETURN
        and b != BYTE_TAB

        return i
      end

      i += 1
    end

    i
  end

  # The inclusive byte range `[start, stop]` as a String. The input
  # bytes come from a String and every cut point is an ASCII byte, so
  # the slice is always valid UTF-8.
  priv fn text(self, start: Int, stop: Int) -> String
    match self.input.slice(Range{start: start, stop: stop}).to_string()
      Result.Ok(s) -> s
      Result.Err(_) -> ""
    end
  end

  priv fn unescape(b: Int) -> Option<String>
    match b
      34 -> Option.Some("\"")
      47 -> Option.Some("/")
      92 -> Option.Some("\\")
      110 -> Option.Some("\n")
      114 -> Option.Some("\r")
      116 -> Option.Some("\t")
      _ -> Option.None
    end
  end
end
