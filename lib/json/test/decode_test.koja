alias Test.require

test "decode null"
  val = try require(decode("null"))
  assert encode(val) == "null"
end

test "decode true"
  val = try require(decode("true"))
  assert encode(val) == "true"
end

test "decode integer"
  val = try require(decode("42"))
  assert encode(val) == "42"
end

test "decode string"
  val = try require(decode("\"hello\""))
  assert encode(val) == "\"hello\""
end

test "decode empty array"
  val = try require(decode("[]"))
  assert encode(val) == "[]"
end

test "decode array"
  val = try require(decode("[1, 2, 3]"))
  assert encode(val) == "[1,2,3]"
end

test "decode object"
  val = try require(decode("{\"key\": \"value\"}"))
  assert encode(val) == "{\"key\":\"value\"}"
end

test "round trip object"
  input = "{\"name\":\"koja\",\"version\":\"0.1.0\",\"tags\":[1,2,3]}"
  val = try require(decode(input))
  assert encode(val) == input
end

# The decoder recurses once per element. A long array pins that
# the recursion runs in constant stack and keeps one live copy of
# the accumulator, since a few thousand frames would overflow the
# process stack and per-frame copies would use quadratic memory.
test "decode long array"
  count = 5000
  parts: List<String> = List.new()

  for i in Range{start: 0, stop: count - 1}
    parts = parts.append("#{i}.5")
  end

  input = "[" <> String.join(parts, ",") <> "]"

  match try require(decode(input))
    array: Array -> assert array.items.length() == count
    _ -> fail "expected an array"
  end
end

test "decode gives each JSON type its own type"
  input = "[null, true, 1, \"a\", [], {}]"
  names: List<String> = []

  match try require(decode(input))
    array: Array ->
      for item in array.items
        name =
          match item
            _null: Null -> "null"
            _flag: Bool -> "bool"
            _number: Number -> "number"
            _text: String -> "string"
            _array: Array -> "array"
            _object: Object -> "object"
          end

        names = names.append(name)
      end

    _ ->
      fail "expected an array"
  end

  assert names == ["null", "bool", "number", "string", "array", "object"]
end

test "decode null equals the null constant"
  null: Value = NULL

  assert try require(decode("null")) == null
  assert try require(decode("0")) != null
end

test "decode keeps the text of a number"
  input = "[1.0,1e2,-0.0,9223372036854775808,0.10000000000000000001]"

  assert encode(try require(decode(input))) == input
end

test "decode leaves the numeric type to the caller"
  match try require(decode("1.0"))
    number: Number ->
      assert number.to_int() == Result.Ok(1)
      assert number.to_float() == Result.Ok(1.0)

    _ ->
      fail "expected a number"
  end
end

test "decode rejects a number outside the grammar"
  assert decode("-").err?()
  assert decode("1.").err?()
  assert decode("1e").err?()
  assert decode("1e+").err?()
end
