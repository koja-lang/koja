test "decode null"
  val = try Test.require(decode("null"))
  assert encode(val) == "null"
end

test "decode true"
  val = try Test.require(decode("true"))
  assert encode(val) == "true"
end

test "decode integer"
  val = try Test.require(decode("42"))
  assert encode(val) == "42"
end

test "decode string"
  val = try Test.require(decode("\"hello\""))
  assert encode(val) == "\"hello\""
end

test "decode empty array"
  val = try Test.require(decode("[]"))
  assert encode(val) == "[]"
end

test "decode array"
  val = try Test.require(decode("[1, 2, 3]"))
  assert encode(val) == "[1,2,3]"
end

test "decode object"
  val = try Test.require(decode("{\"key\": \"value\"}"))
  assert encode(val) == "{\"key\":\"value\"}"
end

test "round trip object"
  input = "{\"name\":\"koja\",\"version\":\"0.1.0\",\"tags\":[1,2,3]}"
  val = try Test.require(decode(input))
  assert encode(val) == input
end

# The decoder recurses once per element. A long array pins that
# the recursion runs in constant stack and keeps one live copy of
# the accumulator, since a few thousand frames would overflow the
# process stack and per-frame copies would use quadratic memory.
test "decode long array"
  count = 5000
  parts: List<String> = List.new()

  for i in Range{start: 0, stop: count - 1}
    parts = parts.append("#{i}.5")
  end

  input = "[" <> String.join(parts, ",") <> "]"

  match try Test.require(decode(input))
    Value.Array(items) -> assert items.length() == count
    _ -> fail "expected an array"
  end
end
