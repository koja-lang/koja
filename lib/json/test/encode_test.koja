struct EncodedPoint
  x: Int
  y: Int
end

impl Encoding for EncodedPoint
  fn to_json(self) -> Value
    value: Value = ["x": self.x.to_json(), "y": self.y.to_json()]
    value
  end
end

test "encode null"
  assert encode(Value.null()) == "null"
end

test "encode true"
  assert encode(Value.bool(true)) == "true"
end

test "encode false"
  assert encode(Value.bool(false)) == "false"
end

test "encode integer"
  assert encode(Value.int(42)) == "42"
end

test "encode string"
  assert encode(Value.string("hello")) == "\"hello\""
end

test "encode empty array"
  assert encode(Value.array([])) == "[]"
end

test "encode array with elements"
  assert encode(Value.array([Value.int(1), Value.int(2), Value.int(3)])) ==
    "[1,2,3]"
end

test "encode empty object"
  assert encode(Value.object([])) == "{}"
end

test "encode object"
  assert encode(Value.object([Value.entry("name", Value.string("koja"))])) ==
    "{\"name\":\"koja\"}"
end

test "encode protocol values"
  assert encode(true) == "true"
  assert encode(-42) == "-42"
  assert encode(1.5) == "1.5"
  assert encode("hello") == "\"hello\""
  assert encode([1, 2, 3]) == "[1,2,3]"
end

test "encode nested JSON literals"
  value: Value = [
    "first": 1, "first": 2, "nested": [true, -3, 1.5, "x"], "empty": [:]
  ]
  expected = "{\"first\":1,\"first\":2,\"nested\":[true,-3,1.5,\"x\"],\"empty\":{}}"

  assert encode(value) == expected
end

test "encode user protocol implementation"
  assert encode(EncodedPoint{x: 3, y: 4}) == "{\"x\":3,\"y\":4}"
end

test "encode defaults to compact output"
  value: Value = ["active": true]
  assert encode(value) == "{\"active\":true}"
end

test "encode accepts pretty options"
  value: Value = ["active": true]
  assert encode(value, EncodeOptions{pretty?: true}) ==
    "{\n  \"active\": true\n}"
end
