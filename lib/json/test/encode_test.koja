struct EncodedPoint
  x: Int
  y: Int
end

impl Encoding for EncodedPoint
  fn to_json(self) -> Value
    ["x": self.x.to_json(), "y": self.y.to_json()]
  end
end

test "encode null"
  value: Value = NULL

  assert encode(value) == "null"
  assert encode(NULL) == "null"
end

test "encode true"
  value: Value = true
  assert encode(value) == "true"
end

test "encode false"
  value: Value = false
  assert encode(value) == "false"
end

test "encode integer"
  value: Value = 42
  assert encode(value) == "42"
end

test "encode string"
  value: Value = "hello"
  assert encode(value) == "\"hello\""
end

test "encode empty array"
  value: Value = []

  assert encode(value) == "[]"
  assert encode(Array{}) == "[]"
end

test "encode array with elements"
  value: Value = [1, 2, 3]
  assert encode(value) == "[1,2,3]"
end

test "encode empty object"
  value: Value = [:]

  assert encode(value) == "{}"
  assert encode(Object{}) == "{}"
end

test "encode object"
  value: Value = ["name": "koja"]
  assert encode(value) == "{\"name\":\"koja\"}"
end

test "encode null in a literal"
  value: Value = ["result": NULL, "items": [NULL, 1]]
  assert encode(value) == "{\"result\":null,\"items\":[null,1]}"
end

test "encode a list of values"
  values: List<Value> = [1, "a", NULL]
  assert encode(values) == "[1,\"a\",null]"
end

test "encode writes the text of a number as is"
  assert encode(Number{text: "1.50"}) == "1.50"
  assert encode(Number{text: "1e2"}) == "1e2"
end

test "encode a variable inside a literal"
  count = 3
  name = "koja"
  inner: Value = [true]
  value: Value = ["count": count.to_json(), "name": name, "inner": inner]

  assert encode(value) == "{\"count\":3,\"name\":\"koja\",\"inner\":[true]}"
end

test "encode protocol values"
  assert encode(true) == "true"
  assert encode(-42) == "-42"
  assert encode(1.5) == "1.5"
  assert encode("hello") == "\"hello\""
  assert encode([1, 2, 3]) == "[1,2,3]"
end

test "encode nested JSON literals"
  value: Value = [
    "first": 1,
    "first": 2,
    "nested": [true, -3, 1.5, "x"],
    "empty": [:]
  ]
  expected = "{\"first\":1,\"first\":2,\"nested\":[true,-3,1.5,\"x\"],\"empty\":{}}"

  assert encode(value) == expected
end

test "encode user protocol implementation"
  assert encode(EncodedPoint{x: 3, y: 4}) == "{\"x\":3,\"y\":4}"
end

test "encode defaults to compact output"
  value: Value = ["active": true]
  assert encode(value) == "{\"active\":true}"
end

test "encode accepts pretty options"
  value: Value = ["active": true]
  assert encode(value, EncodeOptions{pretty?: true}) ==
    "{\n  \"active\": true\n}"
end
