alias Test.require

test "integer arithmetic"
  assert 2 + 3 == 5
  assert 10 - 4 == 6
  assert 6 * 7 == 42
  assert 20 / 4 == 5
  assert 17 % 5 == 2
  assert -3 + 10 == 7
  assert 0 * 100 == 0
end

test "float arithmetic"
  assert 1.5 + 2.5 == 4.0
  assert 10.0 - 3.5 == 6.5
  assert 2.0 * 3.0 == 6.0
  assert 7.0 / 2.0 == 3.5
end

test "comparison operators"
  assert 1 == 1
  assert not (1 == 2)
  assert 1 != 2
  assert not (1 != 1)
  assert 3 < 5
  assert not (5 < 3)
  assert 5 > 3
  assert not (3 > 5)
  assert 3 <= 3
  assert 3 <= 4
  assert not (4 <= 3)
  assert 5 >= 5
  assert 5 >= 4
  assert not (4 >= 5)
end

test "compound assignment"
  x = 10
  x += 5
  assert x == 15

  x -= 3
  assert x == 12

  x *= 4
  assert x == 48

  x /= 6
  assert x == 8
end

test "primitive integer widths and underscore literal"
  i8: Int8 = 127
  i16: Int16 = 32000
  i32: Int32 = 42
  i: Int = 100

  assert i8 == 127
  assert i16 == 32000
  assert i32 == 42
  assert i == 100
  assert 1_000 == 1000
end

test "numeric widening into Int slots"
  i32: Int32 = -42
  widened: Int = i32
  assert widened == -42

  byte: UInt8 = 255
  wide_byte: Int = byte
  assert wide_byte == 255

  u16: UInt16 = 65535
  wide_u16: Int = u16
  assert wide_u16 == 65535
end

test "checked narrowing round-trips"
  small = try require(127.to_int8())
  assert small == 127

  assert 128.to_int8().err?()
  assert (-129).to_int8().err?()

  medium = try require((-1234).to_int32())
  assert medium == -1234

  assert (-1).to_uint64().err?()

  wide = try require(10.to_uint64())
  back = try require(wide.to_int())
  assert back == 10
end
