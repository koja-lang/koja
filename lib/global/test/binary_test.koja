test "empty binary literal has byte_size 0"
  empty: Binary = <<>>

  assert empty.byte_size() == 0
  assert empty == <<>>
end

test "single byte 0xFF literal"
  one = <<0xFF>>

  assert one.byte_size() == 1
  assert one == <<0xFF>>
end

test "multi-byte header literal spells Hello"
  header = <<0x48, 0x65, 0x6C, 0x6C, 0x6F>>

  assert header.byte_size() == 5
  assert header == <<0x48, 0x65, 0x6C, 0x6C, 0x6F>>
end

test "sized 16-bit big-endian segment 0x0102"
  wide = <<0x0102::16>>

  assert wide.byte_size() == 2
  assert wide == <<0x01, 0x02>>
end

test "two-byte unit segment for small integer"
  chunk = <<3::2 byte>>

  assert chunk.byte_size() == 2
  assert chunk == <<0x00, 0x03>>
end

test "mixed literal: bytes and 16-bit value 1024"
  packet = <<0xFF, 0x00, 1024::16>>

  assert packet.byte_size() == 4
  assert packet == <<0xFF, 0x00, 0x04, 0x00>>
end

test "16-bit little-endian literal segment"
  le = <<0x0102::16 little>>

  assert le.byte_size() == 2
  assert le == <<0x02, 0x01>>
end

test "signed -1 in 8-bit segment"
  neg = <<-1::8 signed>>

  assert neg.byte_size() == 1
  assert neg == <<0xFF>>
end

test "variable value in sized segment"
  port: Int = 8080
  msg = <<0x01, port::16>>

  assert msg.byte_size() == 3
  assert msg == <<0x01, 0x1F, 0x90>>
end

test "32-bit segment 0xDEADBEEF"
  big_val = <<0xDEADBEEF::32>>

  assert big_val.byte_size() == 4
  assert big_val == <<0xDE, 0xAD, 0xBE, 0xEF>>
end

test "match exact three-byte literal pattern"
  # --- binary_match.koja ---
  data = <<0x01, 0x02, 0x03>>

  match data
    <<0x01, 0x02, 0x03>> -> ()
    _ -> fail "exact literal match"
  end
end

test "match binds tag and 16-bit field"
  packet = <<0xAB, 0x00, 0x10>>

  match packet
    <<tag::8, _length::16>> -> assert tag == 0xAB
    _ -> fail "tag pattern"
  end
end

test "match dispatches on first byte and binds second"
  msg1 = <<0x01, 0xFF>>

  match msg1
    <<0x02, _::8>> -> fail "wrong arm type 2"
    <<0x01, val::8>> -> assert val == 0xFF
    _ -> fail "dispatch arm"
  end
end

test "match greedy rest: Binary after first byte"
  stream = <<0xAA, 0xBB, 0xCC, 0xDD>>

  match stream
    <<header::8, rest: Binary>> ->
      assert header == 0xAA
      assert rest.byte_size() == 3
      assert rest == <<0xBB, 0xCC, 0xDD>>

    _ ->
      fail "stream pattern"
  end
end

test "match 16-bit little-endian value in pattern"
  le_data = <<0x02, 0x01>>

  match le_data
    <<val::16 little>> -> assert val == 0x0102
    _ -> fail "le pattern"
  end
end

test "match discards leading bytes and binds payload"
  frame = <<0x00, 0x00, 0x00, 0x42>>

  match frame
    <<_::24, payload::8>> -> assert payload == 0x42
    _ -> fail "discard pattern"
  end
end

test "pattern too short for data falls through"
  short = <<0x01>>

  match short
    <<_::8, _::8, _::8>> -> fail "should not match three bytes"
    _ -> ()
  end
end

test "empty binary matches empty pattern"
  empty: Binary = <<>>

  match empty
    <<>> -> ()
    _ -> fail "empty match"
  end
end

test "string segment in binary construction"
  # --- binary_string_segment.koja ---
  pkt = <<"HELLO", 0x01>>

  assert pkt.byte_size() == 6
  assert pkt == <<0x48, 0x45, 0x4C, 0x4C, 0x4F, 0x01>>
end

test "string literal pattern matches byte sequence"
  data = <<0x48, 0x49>>

  match data
    <<"HI">> -> ()
    _ -> fail "HI pattern"
  end
end

test "string prefix and bound u8 in pattern"
  frame = <<0x4F, 0x4B, 0x2A>>

  match frame
    <<"OK", val::8>> -> assert val == 0x2A
    _ -> fail "OK val pattern"
  end
end

test "multi-arm HTTP verb: GET path capture"
  msg = <<0x47, 0x45, 0x54, 0x20, 0x2F>>

  match msg
    <<"POST", _rest: Binary>> ->
      fail "matched POST"

    <<"GET ", path: Binary>> ->
      assert path.byte_size() == 1
      assert path == <<0x2F>>

    _ ->
      fail "GET arm"
  end
end

test "Binary.at reads bytes in O(1) and rejects out-of-bounds"
  data = <<0x01, 0xFF, 0x7F>>

  assert data.at(0) == Option.Some(1)
  assert data.at(1) == Option.Some(255)
  assert data.at(2) == Option.Some(127)
  assert data.at(3).none?()
  assert data.at(0 - 1).none?()
end

test "Binary.find locates byte needles from an offset"
  data = <<0xFF, 0x00, 0xFE, 0x00, 0xFE>>

  assert data.find(<<0x00, 0xFE>>, 0) == Option.Some(1)
  assert data.find(<<0x00, 0xFE>>, 2) == Option.Some(3)
  assert data.find(<<0x00, 0xFE>>, 4).none?()
  assert data.find(<<0xAB>>, 0).none?()

  empty: Binary = <<>>
  assert data.find(empty, 3) == Option.Some(3)
  assert data.find(empty, 6).none?()
  assert data.find(<<0xFF>>, 0 - 1).none?()
  assert <<0x01>>.find(<<0x01, 0x02>>, 0).none?()
end

test "Binary.slice copies inclusive byte ranges and clamps"
  data = <<0xAA, 0xBB, 0xCC, 0xDD>>

  assert data.slice(Range{start: 1, stop: 2}) == <<0xBB, 0xCC>>
  assert data.slice(Range{start: 2, stop: 99}) == <<0xCC, 0xDD>>
  assert data.slice(Range{start: 3, stop: 1}).byte_size() == 0
end

test "String.to_binary UTF-8 bytes"
  # --- binary_type_conversions.koja ---
  bin = "hello".to_binary()

  assert bin.byte_size() == 5
  assert bin == <<0x68, 0x65, 0x6C, 0x6C, 0x6F>>
end

test "Binary.to_bits widens and round-trips with to_binary"
  b: Binary = <<0xAB, 0xCD>>
  bits = b.to_bits()
  back = try Test.require(bits.to_binary())
  assert back == <<0xAB, 0xCD>>
end

test "Binary.to_string succeeds for valid UTF-8"
  valid: Binary = <<0x68, 0x69>>
  str = try Test.require(valid.to_string())
  assert str == "hi"
end

test "Binary.to_string fails for invalid UTF-8"
  invalid: Binary = <<0xFF, 0xFE>>

  match invalid.to_string()
    Result.Ok(_) -> fail "should not decode invalid utf8"
    Result.Err(String.ConversionError.InvalidUTF8) -> ()
  end
end

test "Bits.to_binary on byte-aligned bits from Binary"
  aligned: Binary = <<0x01, 0x02>>
  as_bits = aligned.to_bits()
  back = try Test.require(as_bits.to_binary())
  assert back == <<0x01, 0x02>>
end

test "Binary equality compares length and bytes"
  a = <<83, 0, 0, 0, 4>>
  b = <<83, 0, 0, 0, 4>>

  assert a == b
  assert a != <<83, 0, 0, 0>>
  assert a != <<83, 0, 0, 0, 5>>

  empty: Binary = <<>>
  assert empty == <<>>
end

test "Binary hash is byte-stable and length-sensitive"
  a = <<1, 2, 3>>
  b = <<1, 2, 3>>

  assert a.hash() == b.hash()
  assert a.hash() != <<1, 2>>.hash()
end

test "Binary keys work in Map and Set"
  key = <<0x51, 0x00>>
  m: Map<Binary, String> = Map.new()
  m = m.put(key, "query")
  assert m.get(<<0x51, 0x00>>) == Option.Some("query")

  s: Set<Binary> = Set.new()
  s = s.insert(key)
  assert s.has?(<<0x51, 0x00>>)
end

test "Binary format renders the byte list, truncated past 64"
  assert <<83, 0, 0, 0, 4>>.format() == "<<83, 0, 0, 0, 4>>"

  empty: Binary = <<>>
  assert empty.format() == "<<>>"

  big: Binary = <<>>
  i = 0

  while i < 65
    big = <<big, 7>>
    i += 1
  end

  assert big.format().ends_with?(", ...>>")
end

test "Bits.bit_size counts bits including a partial byte"
  assert <<0x48, 0x65, 5::3>>.bit_size() == 19
  assert <<0x01, 0x02>>.to_bits().bit_size() == 16

  empty: Binary = <<>>
  assert empty.to_bits().bit_size() == 0
end

test "Bits.byte_at reads storage bytes and rejects out-of-bounds"
  bits = <<0x48, 0x65, 5::3>>

  assert bits.byte_at(0) == Option.Some(0x48)
  # The partial byte stores its bits MSB-first with zero padding.
  assert bits.byte_at(2) == Option.Some(0xA0)
  assert bits.byte_at(3).none?()
  assert bits.byte_at(0 - 1).none?()
end

test "Bits equality compares bit length and bits"
  assert <<5::3>> == <<5::3>>
  assert <<5::3>> != <<4::3>>
  # Same storage byte 0x10, different bit lengths.
  assert <<16>>.to_bits() != <<1::4>>

  empty: Binary = <<>>
  assert empty.to_bits() == empty.to_bits()
end

test "Bits hash is bit-stable and length-sensitive"
  assert <<5::3>>.hash() == <<5::3>>.hash()
  assert <<16>>.to_bits().hash() != <<1::4>>.hash()
end

test "Bits keys work in Map and Set"
  m: Map<Bits, String> = Map.new()
  m = m.put(<<5::3>>, "partial")
  assert m.get(<<5::3>>) == Option.Some("partial")

  s: Set<Bits> = Set.new()
  s = s.insert(<<5::3>>)
  assert s.has?(<<5::3>>)
end

test "Bits format renders the round-trippable literal form"
  assert <<72, 101, 5::3>>.format() == "<<72, 101, 5::3>>"
  assert <<72, 101>>.to_bits().format() == "<<72, 101>>"

  empty: Binary = <<>>
  assert empty.to_bits().format() == "<<>>"

  assert <<5::3>>.format() == "<<5::3>>"
end
