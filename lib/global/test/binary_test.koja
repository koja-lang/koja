struct BinaryTest
  @test "empty binary literal has byte_size 0"
  fn test_empty_binary_literal ! String
    empty: Binary = <<>>

    if empty.byte_size() != 0
      fail "empty byte_size"
    end

    match empty
      <<>> -> ()
      _ -> fail "empty pattern"
    end
  end

  @test "single byte 0xFF literal"
  fn test_single_byte_literal ! String
    one = <<0xFF>>

    if one.byte_size() != 1
      fail "single byte size"
    end

    match one
      <<0xFF>> -> ()
      _ -> fail "0xFF pattern"
    end
  end

  @test "multi-byte header literal spells Hello"
  fn test_multi_byte_header_literal ! String
    header = <<0x48, 0x65, 0x6C, 0x6C, 0x6F>>

    if header.byte_size() != 5
      fail "header byte_size"
    end

    match header
      <<0x48, 0x65, 0x6C, 0x6C, 0x6F>> -> ()
      _ -> fail "header bytes"
    end
  end

  @test "sized 16-bit big-endian segment 0x0102"
  fn test_sized_u16_be ! String
    wide = <<0x0102::16>>

    if wide.byte_size() != 2
      fail "wide byte_size"
    end

    match wide
      <<0x01, 0x02>> -> ()
      _ -> fail "wide bytes"
    end
  end

  @test "two-byte unit segment for small integer"
  fn test_two_byte_unit_segment ! String
    chunk = <<3::2 byte>>

    if chunk.byte_size() != 2
      fail "chunk byte_size"
    end

    match chunk
      <<0x00, 0x03>> -> ()
      _ -> fail "chunk bytes"
    end
  end

  @test "mixed literal: bytes and 16-bit value 1024"
  fn test_mixed_packet_literal ! String
    packet = <<0xFF, 0x00, 1024::16>>

    if packet.byte_size() != 4
      fail "packet byte_size"
    end

    match packet
      <<0xFF, 0x00, 0x04, 0x00>> -> ()
      _ -> fail "packet bytes"
    end
  end

  @test "16-bit little-endian literal segment"
  fn test_u16_little_endian_literal ! String
    le = <<0x0102::16 little>>

    if le.byte_size() != 2
      fail "le byte_size"
    end

    match le
      <<0x02, 0x01>> -> ()
      _ -> fail "le bytes"
    end
  end

  @test "signed -1 in 8-bit segment"
  fn test_signed_negative_byte ! String
    neg = <<-1::8 signed>>

    if neg.byte_size() != 1
      fail "neg byte_size"
    end

    match neg
      <<0xFF>> -> ()
      _ -> fail "signed -1 byte"
    end
  end

  @test "variable value in sized segment"
  fn test_variable_in_binary_segment ! String
    port: Int = 8080
    msg = <<0x01, port::16>>

    if msg.byte_size() != 3
      fail "msg byte_size"
    end

    match msg
      <<0x01, 0x1F, 0x90>> -> ()
      _ -> fail "port bytes"
    end
  end

  @test "32-bit segment 0xDEADBEEF"
  fn test_u32_segment ! String
    big_val = <<0xDEADBEEF::32>>

    if big_val.byte_size() != 4
      fail "big_val byte_size"
    end

    match big_val
      <<0xDE, 0xAD, 0xBE, 0xEF>> -> ()
      _ -> fail "u32 bytes"
    end
  end

  @test "match exact three-byte literal pattern"
  fn test_match_exact_literal ! String
    # --- binary_match.koja ---

    data = <<0x01, 0x02, 0x03>>

    match data
      <<0x01, 0x02, 0x03>> -> ()
      _ -> fail "exact literal match"
    end
  end

  @test "match binds tag and 16-bit field"
  fn test_match_tag_and_length_fields ! String
    packet = <<0xAB, 0x00, 0x10>>

    match packet
      <<tag::8, _length::16>> ->
        if tag != 0xAB
          fail "tag binding"
        end

      _ ->
        fail "tag pattern"
    end
  end

  @test "match dispatches on first byte and binds second"
  fn test_match_dispatch_first_byte ! String
    msg1 = <<0x01, 0xFF>>

    match msg1
      <<0x02, _::8>> ->
        fail "wrong arm type 2"

      <<0x01, val::8>> ->
        if val != 0xFF
          fail "val binding"
        end

      _ ->
        fail "dispatch arm"
    end
  end

  @test "match greedy rest: Binary after first byte"
  fn test_match_greedy_rest ! String
    stream = <<0xAA, 0xBB, 0xCC, 0xDD>>

    match stream
      <<header::8, rest: Binary>> ->
        if header != 0xAA
          fail "header"
        end

        if rest.byte_size() != 3
          fail "rest byte_size"
        end

        match rest
          <<0xBB, 0xCC, 0xDD>> -> ()
          _ -> fail "rest bytes"
        end

      _ ->
        fail "stream pattern"
    end
  end

  @test "match 16-bit little-endian value in pattern"
  fn test_match_u16_little_in_pattern ! String
    le_data = <<0x02, 0x01>>

    match le_data
      <<val::16 little>> ->
        if val != 0x0102
          fail "le val"
        end

      _ ->
        fail "le pattern"
    end
  end

  @test "match discards leading bytes and binds payload"
  fn test_match_discard_and_payload ! String
    frame = <<0x00, 0x00, 0x00, 0x42>>

    match frame
      <<_::24, payload::8>> ->
        if payload != 0x42
          fail "payload"
        end

      _ ->
        fail "discard pattern"
    end
  end

  @test "pattern too short for data falls through"
  fn test_match_insufficient_pattern_length ! String
    short = <<0x01>>

    match short
      <<_::8, _::8, _::8>> -> fail "should not match three bytes"
      _ -> ()
    end
  end

  @test "empty binary matches empty pattern"
  fn test_match_empty_binary ! String
    empty: Binary = <<>>

    match empty
      <<>> -> ()
      _ -> fail "empty match"
    end
  end

  @test "string segment in binary construction"
  fn test_string_segment_construction ! String
    # --- binary_string_segment.koja ---

    pkt = <<"HELLO", 0x01>>

    if pkt.byte_size() != 6
      fail "pkt byte_size"
    end

    match pkt
      <<0x48, 0x45, 0x4C, 0x4C, 0x4F, 0x01>> -> ()
      _ -> fail "string seg bytes"
    end
  end

  @test "string literal pattern matches byte sequence"
  fn test_string_pattern_hi ! String
    data = <<0x48, 0x49>>

    match data
      <<"HI">> -> ()
      _ -> fail "HI pattern"
    end
  end

  @test "string prefix and bound u8 in pattern"
  fn test_string_prefix_and_u8 ! String
    frame = <<0x4F, 0x4B, 0x2A>>

    match frame
      <<"OK", val::8>> ->
        if val != 0x2A
          fail "val after OK"
        end

      _ ->
        fail "OK val pattern"
    end
  end

  @test "multi-arm HTTP verb: GET path capture"
  fn test_string_dispatch_get_path ! String
    msg = <<0x47, 0x45, 0x54, 0x20, 0x2F>>

    match msg
      <<"POST", _rest: Binary>> ->
        fail "matched POST"

      <<"GET ", path: Binary>> ->
        if path.byte_size() != 1
          fail "path size"
        end

        match path
          <<0x2F>> -> ()
          _ -> fail "path bytes"
        end

      _ ->
        fail "GET arm"
    end
  end

  @test "Binary.at reads bytes in O(1) and rejects out-of-bounds"
  fn test_binary_at ! String
    data = <<0x01, 0xFF, 0x7F>>

    if data.at(0) != Option.Some(1)
      fail "at(0)"
    end

    if data.at(1) != Option.Some(255)
      fail "at(1)"
    end

    if data.at(2) != Option.Some(127)
      fail "at(2)"
    end

    match data.at(3)
      Option.None -> ()
      Option.Some(_) -> fail "at(3) past end"
    end

    match data.at(0 - 1)
      Option.None -> ()
      Option.Some(_) -> fail "at(-1)"
    end
  end

  @test "Binary.find locates byte needles from an offset"
  fn test_binary_find ! String
    data = <<0xFF, 0x00, 0xFE, 0x00, 0xFE>>

    if data.find(<<0x00, 0xFE>>, 0) != Option.Some(1)
      fail "first match"
    end

    if data.find(<<0x00, 0xFE>>, 2) != Option.Some(3)
      fail "match after from"
    end

    match data.find(<<0x00, 0xFE>>, 4)
      Option.None -> ()
      Option.Some(_) -> fail "from past the last match"
    end

    match data.find(<<0xAB>>, 0)
      Option.None -> ()
      Option.Some(_) -> fail "absent needle"
    end

    empty: Binary = <<>>

    if data.find(empty, 3) != Option.Some(3)
      fail "empty needle matches at from"
    end

    match data.find(empty, 6)
      Option.None -> ()
      Option.Some(_) -> fail "from past the end"
    end

    match data.find(<<0xFF>>, 0 - 1)
      Option.None -> ()
      Option.Some(_) -> fail "negative from"
    end

    match <<0x01>>.find(<<0x01, 0x02>>, 0)
      Option.None -> ()
      Option.Some(_) -> fail "needle longer than haystack"
    end
  end

  @test "Binary.slice copies inclusive byte ranges and clamps"
  fn test_binary_slice ! String
    data = <<0xAA, 0xBB, 0xCC, 0xDD>>

    match data.slice(Range{start: 1, stop: 2})
      <<0xBB, 0xCC>> -> ()
      _ -> fail "middle slice"
    end

    match data.slice(Range{start: 2, stop: 99})
      <<0xCC, 0xDD>> -> ()
      _ -> fail "clamped stop"
    end

    empty = data.slice(Range{start: 3, stop: 1})

    if empty.byte_size() != 0
      fail "inverted range is empty"
    end
  end

  @test "String.to_binary UTF-8 bytes"
  fn test_string_to_binary ! String
    # --- binary_type_conversions.koja ---

    s = "hello"
    bin = s.to_binary()

    if bin.byte_size() != 5
      fail "hello byte_size"
    end

    match bin
      <<0x68, 0x65, 0x6C, 0x6C, 0x6F>> -> ()
      _ -> fail "hello bytes"
    end
  end

  @test "Binary.to_bits widens and round-trips with to_binary"
  fn test_binary_to_bits_round_trip ! String
    b: Binary = <<0xAB, 0xCD>>
    bits = b.to_bits()

    match bits.to_binary()
      Result.Ok(b2) ->
        match b2
          <<0xAB, 0xCD>> ->
            if b2.byte_size() != 2
              fail "round trip size"
            end

          _ ->
            fail "round trip bytes"
        end

      Result.Err(msg) ->
        fail "to_binary: #{msg}"
    end
  end

  @test "Binary.to_string succeeds for valid UTF-8"
  fn test_binary_to_string_valid ! String
    valid: Binary = <<0x68, 0x69>>

    match valid.to_string()
      Result.Ok(str) ->
        if str != "hi"
          fail "valid utf8 string"
        end

      Result.Err(msg) ->
        fail "unexpected err: #{msg}"
    end
  end

  @test "Binary.to_string fails for invalid UTF-8"
  fn test_binary_to_string_invalid ! String
    invalid: Binary = <<0xFF, 0xFE>>

    match invalid.to_string()
      Result.Ok(_) ->
        fail "should not decode invalid utf8"

      Result.Err(error) ->
        match error
          String.ConversionError.InvalidUTF8 -> ()
        end
    end
  end

  @test "Bits.to_binary on byte-aligned bits from Binary"
  fn test_bits_to_binary_aligned ! String
    aligned: Binary = <<0x01, 0x02>>
    as_bits = aligned.to_bits()

    match as_bits.to_binary()
      Result.Ok(b2) ->
        match b2
          <<0x01, 0x02>> ->
            if b2.byte_size() != 2
              fail "aligned size"
            end

          _ ->
            fail "aligned bytes"
        end

      Result.Err(msg) ->
        fail "aligned to_binary: #{msg}"
    end
  end

  @test "Binary equality compares length and bytes"
  fn test_binary_equality ! String
    a = <<83, 0, 0, 0, 4>>
    b = <<83, 0, 0, 0, 4>>

    if a != b
      fail "equal binaries compared unequal"
    end

    if a == <<83, 0, 0, 0>>
      fail "prefix compared equal"
    end

    if a == <<83, 0, 0, 0, 5>>
      fail "differing byte compared equal"
    end

    empty: Binary = <<>>

    if empty != <<>>
      fail "empty binaries compared unequal"
    end
  end

  @test "Binary hash is byte-stable and length-sensitive"
  fn test_binary_hash ! String
    a = <<1, 2, 3>>
    b = <<1, 2, 3>>

    if a.hash() != b.hash()
      fail "equal binaries hashed differently"
    end

    if a.hash() == <<1, 2>>.hash()
      fail "prefix hashed identically"
    end
  end

  @test "Binary keys work in Map and Set"
  fn test_binary_hash_collections ! String
    key = <<0x51, 0x00>>
    m: Map<Binary, String> = Map.new()
    m = m.put(key, "query")

    if m.get(<<0x51, 0x00>>) != Option.Some("query")
      fail "map lookup by equal key missed"
    end

    s: Set<Binary> = Set.new()
    s = s.insert(key)

    if not s.has?(<<0x51, 0x00>>)
      fail "set membership by equal key missed"
    end
  end

  @test "Binary format renders the byte list, truncated past 64"
  fn test_binary_format ! String
    if <<83, 0, 0, 0, 4>>.format() != "<<83, 0, 0, 0, 4>>"
      fail "short format: #{<<83, 0, 0, 0, 4>>.format()}"
    end

    empty: Binary = <<>>

    if empty.format() != "<<>>"
      fail "empty format: #{empty.format()}"
    end

    big: Binary = <<>>
    i = 0

    while i < 65
      big = <<big, 7>>
      i += 1
    end

    if not big.format().ends_with?(", ...>>")
      fail "expected truncation marker: #{big.format()}"
    end
  end

  @test "Bits.bit_size counts bits including a partial byte"
  fn test_bits_bit_size ! String
    if <<0x48, 0x65, 5::3>>.bit_size() != 19
      fail "partial bit_size"
    end

    if <<0x01, 0x02>>.to_bits().bit_size() != 16
      fail "aligned bit_size"
    end

    empty: Binary = <<>>

    if empty.to_bits().bit_size() != 0
      fail "empty bit_size"
    end
  end

  @test "Bits.byte_at reads storage bytes and rejects out-of-bounds"
  fn test_bits_byte_at ! String
    bits = <<0x48, 0x65, 5::3>>

    if bits.byte_at(0) != Option.Some(0x48)
      fail "byte_at(0)"
    end

    # The partial byte stores its bits MSB-first with zero padding.
    if bits.byte_at(2) != Option.Some(0xA0)
      fail "byte_at(2) partial"
    end

    match bits.byte_at(3)
      Option.None -> ()
      Option.Some(_) -> fail "byte_at(3) past end"
    end

    match bits.byte_at(0 - 1)
      Option.None -> ()
      Option.Some(_) -> fail "byte_at(-1)"
    end
  end

  @test "Bits equality compares bit length and bits"
  fn test_bits_equality ! String
    if <<5::3>> != <<5::3>>
      fail "equal bits compared unequal"
    end

    if <<5::3>> == <<4::3>>
      fail "differing bits compared equal"
    end

    # Same storage byte 0x10, different bit lengths.
    if <<16>>.to_bits() == <<1::4>>
      fail "same bytes at different lengths compared equal"
    end

    empty: Binary = <<>>

    if empty.to_bits() != empty.to_bits()
      fail "empty bits compared unequal"
    end
  end

  @test "Bits hash is bit-stable and length-sensitive"
  fn test_bits_hash ! String
    if <<5::3>>.hash() != <<5::3>>.hash()
      fail "equal bits hashed differently"
    end

    if <<16>>.to_bits().hash() == <<1::4>>.hash()
      fail "same bytes at different lengths hashed identically"
    end
  end

  @test "Bits keys work in Map and Set"
  fn test_bits_hash_collections ! String
    m: Map<Bits, String> = Map.new()
    m = m.put(<<5::3>>, "partial")

    if m.get(<<5::3>>) != Option.Some("partial")
      fail "map lookup by equal key missed"
    end

    s: Set<Bits> = Set.new()
    s = s.insert(<<5::3>>)

    if not s.has?(<<5::3>>)
      fail "set membership by equal key missed"
    end
  end

  @test "Bits format renders the round-trippable literal form"
  fn test_bits_format ! String
    if <<72, 101, 5::3>>.format() != "<<72, 101, 5::3>>"
      fail "partial format: #{<<72, 101, 5::3>>.format()}"
    end

    if <<72, 101>>.to_bits().format() != "<<72, 101>>"
      fail "aligned format: #{<<72, 101>>.to_bits().format()}"
    end

    empty: Binary = <<>>

    if empty.to_bits().format() != "<<>>"
      fail "empty format: #{empty.to_bits().format()}"
    end

    if <<5::3>>.format() != "<<5::3>>"
      fail "partial-only format: #{<<5::3>>.format()}"
    end
  end
end
