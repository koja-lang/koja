enum Color
  Red
  Green
  Blue
end

enum Shape
  Circle(Int)
  Rect(Int, Int)
end

struct CondStmtCounter
  value: Int

  fn new -> Self
    CondStmtCounter{value: 0}
  end

  fn apply(self, n: Int) -> Self
    cond
      n > 0 -> self.value = self.value + n
      n < 0 -> self.value = self.value + n
      else -> ()
    end

    self
  end
end

test "for loops accumulate and iterate strings"
  list: List<Int> = List.new()
  list = list.append(1)
  list = list.append(2)
  list = list.append(3)

  sum = 0

  for item in list
    sum += item
  end

  assert sum == 6

  acc = ""

  for c in "abc"
    acc = acc <> c
  end

  assert acc == "abc"
end

test "if else nested and classify"
  branch = ""

  if true
    branch = "yes"
  end

  assert branch == "yes"

  branch2 = ""

  if false
    branch2 = "nope"
  else
    branch2 = "else branch"
  end

  assert branch2 == "else branch"

  x = 5
  cmp = ""

  if x > 3
    cmp = "greater"
  else
    cmp = "not greater"
  end

  assert cmp == "greater"

  y = x > 2 ? "big" : "small"
  assert y == "big"

  assert classify_size(200) == "big"
  assert classify_size(50) == "medium"
  assert classify_size(3) == "small"
end

test "loop and break"
  i = 0
  count = 0

  loop
    if i >= 3
      break
    end

    count += 1
    i += 1
  end

  assert count == 3
end

test "match integers and wildcards"
  x = 3

  label =
    match x
      1 -> "one"
      2 -> "two"
      3 -> "three"
      _ -> "other"
    end

  assert label == "three"

  y = 99
  kind = ""

  match y
    1 -> kind = "one"
    _ -> kind = "wildcard"
  end

  assert kind == "wildcard"

  z = 42

  msg =
    match z
      0 -> "zero"
      val -> "got #{val}"
    end

  assert msg == "got 42"
end

test "match plain and tagged enums"
  assert color_name(Color.Red) == "red"
  assert color_name(Color.Blue) == "blue"
  assert shape_area(Shape.Circle(5)) == 75
  assert shape_area(Shape.Rect(4, 6)) == 24

  opt: Option<Int> = Option.Some(10)

  bucket =
    match opt
      Option.Some(v) when v > 5 -> "big some"
      Option.Some(_) -> "small some"
      Option.None -> "none"
    end

  assert bucket == "big some"
end

test "match OR patterns"
  assert classify_or(1) == "small"
  assert classify_or(2) == "small"
  assert classify_or(5) == "medium"
  assert classify_or(99) == "large"

  assert bracket_kind("(") == "bracket"
  assert bracket_kind("]") == "bracket"
  assert bracket_kind("x") == "other"

  assert color_warmth(Color.Red) == "warm"
  assert color_warmth(Color.Green) == "cool"
  assert color_warmth(Color.Blue) == "cool"

  assert or_with_guard(3) == "three"
  assert or_with_guard(1) == "small"
  assert or_with_guard(7) == "other"
end

test "if not guards"
  ran_false = false

  if not false
    ran_false = true
  end

  assert ran_false

  ran_true = false

  if not true
    ran_true = true
  end

  assert not ran_true

  x = 10
  ok_high = false

  if not x > 20
    ok_high = true
  end

  assert ok_high

  ok_low = false

  if not x < 5
    ok_low = true
  end

  assert ok_low
end

test "while accumulation"
  i = 0
  seen = 0

  while i < 5
    seen += 1
    i += 1
  end

  assert seen == 5

  sum = 0
  n = 1

  while n <= 10
    sum += n
    n += 1
  end

  assert sum == 55
end

test "cond with multiple statements per branch"
  c = CondStmtCounter.new()
  c = c.apply(5)
  c = c.apply(-2)
  c = c.apply(0)

  assert c.value == 3
end

priv fn classify_size(n: Int) -> String
  cond
    n > 100 -> "big"
    n > 10 -> "medium"
    else -> "small"
  end
end

priv fn color_name(c: Color) -> String
  match c
    Red -> "red"
    Green -> "green"
    Blue -> "blue"
  end
end

priv fn shape_area(s: Shape) -> Int
  match s
    Shape.Circle(r) -> r * r * 3
    Shape.Rect(w, h) -> w * h
  end
end

priv fn classify_or(n: Int) -> String
  match n
    1 | 2 | 3 -> "small"
    4 | 5 | 6 -> "medium"
    _ -> "large"
  end
end

priv fn bracket_kind(ch: String) -> String
  match ch
    "(" | ")" | "[" | "]" -> "bracket"
    _ -> "other"
  end
end

priv fn color_warmth(c: Color) -> String
  match c
    Color.Red -> "warm"
    Color.Green | Color.Blue -> "cool"
  end
end

priv fn or_with_guard(n: Int) -> String
  match n
    1 | 2 | 3 when n > 2 -> "three"
    1 | 2 | 3 -> "small"
    _ -> "other"
  end
end
