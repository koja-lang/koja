enum Color
  Red
  Green
  Blue
end

enum Shape
  Circle(Int)
  Rect(Int, Int)
end

struct CondStmtCounter
  value: Int

  fn new -> Self
    CondStmtCounter{value: 0}
  end

  fn apply(self, n: Int) -> Self
    cond
      n > 0 -> self.value = self.value + n
      n < 0 -> self.value = self.value + n
      else -> ()
    end

    self
  end
end

struct ControlFlowTest
  fn classify_size(n: Int) -> String
    cond
      n > 100 -> "big"
      n > 10 -> "medium"
      else -> "small"
    end
  end

  fn color_name(c: Color) -> String
    match c
      Red -> "red"
      Green -> "green"
      Blue -> "blue"
    end
  end

  fn shape_area(s: Shape) -> Int
    match s
      Shape.Circle(r) -> r * r * 3
      Shape.Rect(w, h) -> w * h
    end
  end

  fn classify_or(n: Int) -> String
    match n
      1 | 2 | 3 -> "small"
      4 | 5 | 6 -> "medium"
      _ -> "large"
    end
  end

  fn bracket_kind(ch: String) -> String
    match ch
      "(" | ")" | "[" | "]" -> "bracket"
      _ -> "other"
    end
  end

  fn color_warmth(c: Color) -> String
    match c
      Color.Red -> "warm"
      Color.Green | Color.Blue -> "cool"
    end
  end

  fn or_with_guard(n: Int) -> String
    match n
      1 | 2 | 3 when n > 2 -> "three"
      1 | 2 | 3 -> "small"
      _ -> "other"
    end
  end

  @test "for loops accumulate and iterate strings"
  fn test_for_loops ! String
    list: List<Int> = List.new()
    list = list.append(1)
    list = list.append(2)
    list = list.append(3)

    sum = 0

    for item in list
      sum += item
    end

    if sum != 6
      fail "for sum over list"
    end

    acc = ""

    for c in "abc"
      acc = acc <> c
    end

    if acc != "abc"
      fail "for over string codepoints"
    end
  end

  @test "if else nested and classify"
  fn test_if_else ! String
    branch = ""

    if true
      branch = "yes"
    end

    if branch != "yes"
      fail "if true branch"
    end

    branch2 = ""

    if false
      branch2 = "nope"
    else
      branch2 = "else branch"
    end

    if branch2 != "else branch"
      fail "if false else branch"
    end

    x = 5
    cmp = ""

    if x > 3
      cmp = "greater"
    else
      cmp = "not greater"
    end

    if cmp != "greater"
      fail "if comparison"
    end

    y = x > 2 ? "big" : "small"

    if y != "big"
      fail "ternary"
    end

    if ControlFlowTest.classify_size(200) != "big"
      fail "classify big"
    end

    if ControlFlowTest.classify_size(50) != "medium"
      fail "classify medium"
    end

    if ControlFlowTest.classify_size(3) != "small"
      fail "classify small"
    end
  end

  @test "loop and break"
  fn test_loop_break ! String
    i = 0
    count = 0

    loop
      if i >= 3
        break
      end

      count += 1
      i += 1
    end

    if count != 3
      fail "loop iterations before break"
    end
  end

  @test "match integers and wildcards"
  fn test_match_integers ! String
    x = 3

    label =
      match x
        1 -> "one"
        2 -> "two"
        3 -> "three"
        _ -> "other"
      end

    if label != "three"
      fail "match literal 3"
    end

    y = 99
    kind = ""

    match y
      1 -> kind = "one"
      _ -> kind = "wildcard"
    end

    if kind != "wildcard"
      fail "match wildcard"
    end

    z = 42

    msg =
      match z
        0 -> "zero"
        val -> "got #{val}"
      end

    if msg != "got 42"
      fail "match bind pattern"
    end
  end

  @test "match plain and tagged enums"
  fn test_match_enums ! String
    if ControlFlowTest.color_name(Color.Red) != "red"
      fail "color Red"
    end

    if ControlFlowTest.color_name(Color.Blue) != "blue"
      fail "color Blue"
    end

    if ControlFlowTest.shape_area(Shape.Circle(5)) != 75
      fail "circle area"
    end

    if ControlFlowTest.shape_area(Shape.Rect(4, 6)) != 24
      fail "rect area"
    end

    opt: Option<Int> = Option.Some(10)

    bucket =
      match opt
        Option.Some(v) when v > 5 -> "big some"
        Option.Some(_) -> "small some"
        Option.None -> "none"
      end

    if bucket != "big some"
      fail "Option match with guard"
    end
  end

  @test "match OR patterns"
  fn test_match_or ! String
    if ControlFlowTest.classify_or(1) != "small"
      fail "or classify 1"
    end

    if ControlFlowTest.classify_or(2) != "small"
      fail "or classify 2"
    end

    if ControlFlowTest.classify_or(5) != "medium"
      fail "or classify 5"
    end

    if ControlFlowTest.classify_or(99) != "large"
      fail "or classify 99"
    end

    if ControlFlowTest.bracket_kind("(") != "bracket"
      fail "bracket paren"
    end

    if ControlFlowTest.bracket_kind("]") != "bracket"
      fail "bracket square close"
    end

    if ControlFlowTest.bracket_kind("x") != "other"
      fail "bracket other"
    end

    if ControlFlowTest.color_warmth(Color.Red) != "warm"
      fail "warmth red"
    end

    if ControlFlowTest.color_warmth(Color.Green) != "cool"
      fail "warmth green"
    end

    if ControlFlowTest.color_warmth(Color.Blue) != "cool"
      fail "warmth blue"
    end

    if ControlFlowTest.or_with_guard(3) != "three"
      fail "or guard three"
    end

    if ControlFlowTest.or_with_guard(1) != "small"
      fail "or guard one"
    end

    if ControlFlowTest.or_with_guard(7) != "other"
      fail "or guard other"
    end
  end

  @test "unless"
  fn test_unless ! String
    ran_false = false

    unless false
      ran_false = true
    end

    unless ran_false
      fail "unless false should run body"
    end

    ran_true = false

    unless true
      ran_true = true
    end

    if ran_true
      fail "unless true should not run body"
    end

    x = 10
    ok_high = false

    unless x > 20
      ok_high = true
    end

    unless ok_high
      fail "unless x > 20 should run when condition is false"
    end

    ok_low = false

    unless x < 5
      ok_low = true
    end

    unless ok_low
      fail "unless x < 5 should run when condition is false"
    end
  end

  @test "while accumulation"
  fn test_while ! String
    i = 0
    seen = 0

    while i < 5
      seen += 1
      i += 1
    end

    if seen != 5
      fail "while iteration count"
    end

    sum = 0
    n = 1

    while n <= 10
      sum += n
      n += 1
    end

    if sum != 55
      fail "while sum 1..10"
    end
  end

  @test "cond with multiple statements per branch"
  fn test_cond_multistatement ! String
    c = CondStmtCounter.new()
    c = c.apply(5)
    c = c.apply(-2)
    c = c.apply(0)

    if c.value != 3
      fail "cond counter value"
    end
  end
end
