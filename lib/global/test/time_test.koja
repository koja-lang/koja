test "DateTime.now has positive epoch millis"
  assert DateTime.now().timestamp_millis() > 0
end

test "Duration.from_secs"
  assert Duration.from_secs(5).millis() == 5000
end

test "Duration.from_millis"
  assert Duration.from_millis(1500).millis() == 1500
end

test "Duration zero"
  assert Duration.from_secs(0).millis() == 0
  assert Duration.from_millis(0).millis() == 0
end
