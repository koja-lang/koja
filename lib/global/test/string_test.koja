test "escape sequences: tab, quote, backslash"
  # --- strings.koja: escapes, interpolation, heredoc ---
  assert "tab:\there" == "tab:\t" <> "here"
  assert "quote: \"yes\"" == "quote: " <> "\"" <> "yes" <> "\""
  assert "backslash: \\" == "backslash: " <> "\\"
end

test "string interpolation: variable and expression"
  name = "koja"

  assert "hello #{name}" == "hello koja"
  assert "1 + 2 = #{1 + 2}" == "1 + 2 = 3"
end

test "heredoc dedents trailing lines"
  msg = """
  first line
  second line
  """

  assert msg == "first line\nsecond line"
end

test "digit? and whitespace? on literals"
  assert "123456790".digit?()
  assert not "notdigit".digit?()
  assert " \n\r\t".whitespace?()
  assert not "notwhitespace ".whitespace?()
end

test "byte_length and length for ASCII"
  # --- string_intrinsics.koja ---
  s = "hello"

  assert s.byte_length() == 5
  assert s.length() == 5
end

test "get returns Option of single-codepoint strings"
  s = "hello"

  assert s.get(0) == Option.Some("h")
  assert s.get(4) == Option.Some("o")
end

test "for loop iterates codepoints in order"
  acc = ""

  for c in "abc"
    acc = acc <> c
  end

  assert acc == "abc"
  assert "abc".length() == 3
end

test "slice with inclusive Range"
  s = "hello"
  assert s.slice(Range{start: 1, stop: 3}) == "ell"
end

test "to_binary and to_string round trip"
  bin = "test".to_binary()
  val = try Test.require(bin.to_string())
  assert val == "test"
end

test "Int.parse success and failure"
  val = try Test.require(Int.parse("42"))
  assert val == 42

  match Int.parse("not_a_number")
    Result.Ok(_) -> fail "expected parse failure"
    Result.Err(NumericConversionError.InvalidFormat) -> ()
    Result.Err(_) -> fail "wrong error kind"
  end

  match Int.parse("99999999999999999999")
    Result.Ok(_) -> fail "expected overflow failure"
    Result.Err(NumericConversionError.OutOfRange) -> ()
    Result.Err(_) -> fail "overflow should be OutOfRange"
  end
end

test "Float.parse success and failure"
  val = try Test.require(Float.parse("3.14"))
  assert val == 3.14

  match Float.parse("bad")
    Result.Ok(_) -> fail "expected parse failure"
    Result.Err(NumericConversionError.InvalidFormat) -> ()
    Result.Err(_) -> fail "wrong error kind"
  end

  match Float.parse("1e999")
    Result.Ok(_) -> fail "expected overflow failure"
    Result.Err(NumericConversionError.OutOfRange) -> ()
    Result.Err(_) -> fail "overflow should be OutOfRange"
  end

  match Float.parse("inf")
    Result.Ok(_) -> fail "inf should not parse"
    Result.Err(NumericConversionError.InvalidFormat) -> ()
    Result.Err(_) -> fail "inf should be InvalidFormat"
  end
end

test "Unicode length vs byte_length and get"
  emoji = "héllo"

  assert emoji.length() == 5
  assert emoji.byte_length() == 6
  assert emoji.get(1) == Option.Some("é")
end

test "empty?"
  # --- string_stdlib.koja ---
  assert "".empty?()
  assert not "hello".empty?()
end

test "at: valid index, out of bounds, negative"
  assert "hello".at(1) == Option.Some("e")
  assert "hello".at(10).none?()
  assert "hello".at(-1).none?()
end

test "contains?"
  assert "hello world".contains?("world")
  assert not "hello world".contains?("xyz")
  assert "hello".contains?("")
  assert not "".contains?("a")
end

test "starts_with? and ends_with?"
  assert "hello world".starts_with?("hello")
  assert not "hello world".starts_with?("world")
  assert "hello".starts_with?("")
  assert not "hi".starts_with?("hello")

  assert "hello world".ends_with?("world")
  assert not "hello world".ends_with?("hello")
  assert "hello".ends_with?("")
  assert not "hi".ends_with?("hello")
end

test "trim_start, trim_end, trim"
  assert "  hello  ".trim_start() == "hello  "
  assert "hello".trim_start() == "hello"
  assert "  hello  ".trim_end() == "  hello"
  assert "hello".trim_end() == "hello"
  assert "  hello  ".trim() == "hello"
  assert "hello".trim() == "hello"
end

test "upcase and downcase"
  assert "hello".upcase() == "HELLO"
  assert "Hello World 123".upcase() == "HELLO WORLD 123"
  assert "HELLO".downcase() == "hello"
  assert "Hello World 123".downcase() == "hello world 123"
end

test "replace"
  assert "hello world".replace("world", "koja") == "hello koja"
  assert "aaa".replace("a", "bb") == "bbbbbb"
  assert "hello".replace("xyz", "!") == "hello"
  assert "hello".replace("", "!") == "hello"
end

test "reverse"
  assert "hello".reverse() == "olleh"
  assert "".reverse() == ""
  assert "a".reverse() == "a"
end

test "split"
  assert "a,b,c".split(",") == ["a", "b", "c"]
  assert "hi".split("") == ["h", "i"]
end

test "split edge cases: adjacent, boundary, and multi-byte separators"
  assert "a,,b".split(",") == ["a", "", "b"]
  assert ",a,".split(",") == ["", "a", ""]
  assert "".split(",") == [""]
  assert ",".split(",") == ["", ""]
  assert "aébéc".split("é") == ["a", "b", "c"]
  assert "héllo wörld".split(" ") == ["héllo", "wörld"]
  assert "mississippi".split("ss") == ["mi", "i", "ippi"]
  assert "ab".split("abc") == ["ab"]
end

test "search family on multi-byte boundaries"
  assert "héllo".contains?("él")
  assert not "é".starts_with?("ab")
  assert not "aé".ends_with?("bb")
  assert "héllo".starts_with?("hé")
  assert "héllo".ends_with?("llo")
  assert "héllo".replace("é", "e") == "hello"
end

test "String.join"
  join_parts: List<String> = ["a", "b", "c"]
  assert String.join(join_parts, ", ") == "a, b, c"

  join_one: List<String> = ["one"]
  assert String.join(join_one, "-") == "one"

  join_empty: List<String> = List.new()
  assert String.join(join_empty, ",") == ""
end

test "alpha?, digit?, whitespace? (stdlib)"
  assert "hello".alpha?()
  assert not "hello123".alpha?()
  assert "".alpha?()
  assert "123".digit?()
  assert not "12a".digit?()
  assert " \t\n".whitespace?()
  assert not " x ".whitespace?()
end

test "codepoints and graphemes"
  assert "abc".codepoints() == ["a", "b", "c"]
  assert "hi".graphemes() == ["h", "i"]
end

test "to_int and to_float"
  int_val = try Test.require("42".to_int())
  assert int_val == 42

  match "bad".to_int()
    Result.Ok(_) -> fail "to_int bad expected err"
    Result.Err(NumericConversionError.InvalidFormat) -> ()
    Result.Err(_) -> fail "to_int bad kind"
  end

  float_val = try Test.require("3.14".to_float())
  assert float_val == 3.14

  match "bad".to_float()
    Result.Ok(_) -> fail "to_float bad expected err"
    Result.Err(NumericConversionError.InvalidFormat) -> ()
    Result.Err(_) -> fail "to_float bad kind"
  end
end
