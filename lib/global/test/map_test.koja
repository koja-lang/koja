struct MapTest
  @test "new, put, has?, length"
  fn test_new_put_has ! String
    m: Map<String, Int> = Map.new()
    m = m.put("hello", 10)
    m = m.put("world", 20)
    m = m.put("hello", 30)

    if m.length() != 2
      fail "expected length 2, got #{m.length()}"
    end

    if not m.has?("hello")
      fail "expected has hello"
    end

    if m.has?("missing")
      fail "should not have missing"
    end

    if m.empty?()
      fail "should not be empty"
    end
  end

  @test "remove deletes key"
  fn test_remove ! String
    m: Map<String, Int> = Map.new()
    m = m.put("hello", 10)
    m = m.put("world", 20)
    m = m.remove("hello")

    if m.length() != 1
      fail "expected length 1 after remove"
    end

    if m.has?("hello")
      fail "hello should be removed"
    end
  end

  @test "literal syntax"
  fn test_literal ! String
    m: Map<String, Int> = ["hello": 10, "world": 20]

    if m.length() != 2
      fail "expected length 2"
    end

    if not m.has?("hello")
      fail "expected has hello"
    end

    if not m.has?("world")
      fail "expected has world"
    end

    if m.has?("missing")
      fail "should not have missing"
    end
  end

  @test "empty literal"
  fn test_empty_literal ! String
    empty: Map<String, Int> = [:]

    if empty.length() != 0
      fail "expected length 0"
    end

    if not empty.empty?()
      fail "should be empty"
    end
  end

  @test "int keys"
  fn test_int_keys ! String
    m: Map<Int, String> = [1: "one", 2: "two", 3: "three"]

    if m.length() != 3
      fail "expected length 3"
    end

    if not m.has?(1)
      fail "expected has 1"
    end

    if m.has?(4)
      fail "should not have 4"
    end
  end

  @test "resize preserves entries"
  fn test_resize ! String
    m: Map<Int, String> = [1: "one", 2: "two", 3: "three"]
    m = m.put(4, "four")
    m = m.put(5, "five")
    m = m.put(6, "six")
    m = m.put(7, "seven")
    m = m.put(8, "eight")
    m = m.put(9, "nine")
    m = m.put(10, "ten")

    if m.length() != 10
      fail "expected length 10 after resize, got #{m.length()}"
    end

    if not m.has?(1)
      fail "lost key 1 after resize"
    end

    if not m.has?(10)
      fail "missing key 10 after resize"
    end
  end

  @test "iteration, equality, and debug"
  fn test_iteration_equality_debug ! String
    map: Map<String, Int> = ["one": 1, "two": 2, "three": 3]
    count = 0
    sum = 0

    for (_, value) in map
      count += 1
      sum += value
    end

    if not (count == 3 and sum == 6)
      fail "map iteration missed an entry"
    end

    same: Map<String, Int> = ["three": 3, "one": 1, "two": 2]
    different: Map<String, Int> = ["one": 1, "two": 9, "three": 3]

    if map != same
      fail "equal maps compared unequal"
    end

    if map == different
      fail "different maps compared equal"
    end

    rendered = map.format()

    if not (rendered.starts_with?("[") and rendered.ends_with?("]"))
      fail "map debug did not use map literal syntax"
    end

    if not rendered.contains?("\"one\": 1")
      and rendered.contains?("\"three\": 3")

      fail "map debug omitted an entry"
    end
  end
end
