test "new, put, has?, length"
  m: Map<String, Int> = Map.new()
  m = m.put("hello", 10)
  m = m.put("world", 20)
  m = m.put("hello", 30)

  assert m.length() == 2
  assert m.has?("hello")
  assert not m.has?("missing")
  assert not m.empty?()
end

test "remove deletes key"
  m: Map<String, Int> = Map.new()
  m = m.put("hello", 10)
  m = m.put("world", 20)
  m = m.remove("hello")

  assert m.length() == 1
  assert not m.has?("hello")
end

test "remove leaves a copy unchanged"
  m: Map<String, Int> = ["hello": 10, "world": 20]
  copy = m
  m = m.remove("hello")

  assert m.length() == 1
  assert copy.length() == 2
  assert copy.get("hello") == Option.Some(10)
end

test "put after remove keeps one entry for the key"
  m: Map<Int, Int> = Map.new()
  m = m.put(1, 10)
  m = m.put(3, 30)
  m = m.put(5, 50)
  m = m.put(7, 70)
  m = m.remove(1)
  m = m.put(7, 71)

  assert m.length() == 3
  assert m.get(7) == Option.Some(71)
end

test "get misses after many keys come and go"
  m: Map<Int, Int> = Map.new()
  key = 0

  while key < 64
    m = m.put(key, key)
    m = m.remove(key)
    key += 1
  end

  assert m.empty?()
  assert m.get(1000) == Option.None
end

test "remove keeps the other keys in reach"
  m: Map<Int, Int> = Map.new()
  key = 0

  while key < 48
    m = m.put(key, key)
    key += 1
  end

  key = 0

  while key < 48
    m = m.remove(key)
    key += 3
  end

  assert m.length() == 32
  key = 0

  while key < 48
    assert m.has?(key) == (key % 3 != 0)
    key += 1
  end
end

test "literal syntax"
  m: Map<String, Int> = ["hello": 10, "world": 20]

  assert m.length() == 2
  assert m.has?("hello")
  assert m.has?("world")
  assert not m.has?("missing")
end

test "empty literal"
  empty: Map<String, Int> = [:]

  assert empty.length() == 0
  assert empty.empty?()
end

test "int keys"
  m: Map<Int, String> = [1: "one", 2: "two", 3: "three"]

  assert m.length() == 3
  assert m.has?(1)
  assert not m.has?(4)
end

test "resize preserves entries"
  m: Map<Int, String> = [1: "one", 2: "two", 3: "three"]
  m = m.put(4, "four")
  m = m.put(5, "five")
  m = m.put(6, "six")
  m = m.put(7, "seven")
  m = m.put(8, "eight")
  m = m.put(9, "nine")
  m = m.put(10, "ten")

  assert m.length() == 10
  assert m.has?(1)
  assert m.has?(10)
end

test "iteration, equality, and debug"
  map: Map<String, Int> = ["one": 1, "two": 2, "three": 3]
  count = 0
  sum = 0

  for (_, value) in map
    count += 1
    sum += value
  end

  assert count == 3
  assert sum == 6

  same: Map<String, Int> = ["three": 3, "one": 1, "two": 2]
  different: Map<String, Int> = ["one": 1, "two": 9, "three": 3]

  assert map == same
  assert map != different

  rendered = map.format()

  assert rendered.starts_with?("[")
  assert rendered.ends_with?("]")
  assert rendered.contains?("\"one\": 1")
  assert rendered.contains?("\"three\": 3")
end
