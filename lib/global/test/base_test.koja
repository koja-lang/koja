test "encode64 matches the RFC 4648 vectors"
  vectors: List<(String, String)> = [
    ("", ""), ("f", "Zg=="), ("fo", "Zm8="), ("foo", "Zm9v"),
    ("foob", "Zm9vYg=="), ("fooba", "Zm9vYmE="), ("foobar", "Zm9vYmFy")
  ]

  for vector in vectors
    (input, expected) = vector
    assert Base.encode64(input) == expected
  end
end

test "decode64 reverses the RFC 4648 vectors"
  vectors: List<(String, String)> = [
    ("", ""), ("Zg==", "f"), ("Zm8=", "fo"), ("Zm9v", "foo"),
    ("Zm9vYmFy", "foobar")
  ]

  for vector in vectors
    (input, expected) = vector
    assert Base.decode64(input) == ok(expected.to_binary())
  end
end

test "decode64 accepts unpadded input"
  assert Base.decode64("Zg") == ok("f".to_binary())
  assert Base.decode64("Zm8") == ok("fo".to_binary())
  assert Base.decode64("Zm9vYg") == ok("foob".to_binary())
end

test "base64 round-trips every byte value"
  all = every_byte()

  assert Base.decode64(Base.encode64(all)) == ok(all)
  assert Base.url_decode64(Base.url_encode64(all)) == ok(all)
end

test "url-safe base64 swaps + and / for - and _"
  data = <<251, 239>>

  assert Base.encode64(data) == "++8="
  assert Base.url_encode64(data) == "--8="
end

test "each base64 alphabet rejects the other's symbols"
  assert Base.url_decode64("++8=") == err(Base.Error.InvalidCharacter("+"))
  assert Base.decode64("--8=") == err(Base.Error.InvalidCharacter("-"))
end

test "decode64 rejects malformed input"
  assert Base.decode64("Zm9v!GFy") == err(Base.Error.InvalidCharacter("!"))
  assert Base.decode64("Zm==YmFy") == err(Base.Error.InvalidPadding)
  assert Base.decode64("=m9v") == err(Base.Error.InvalidPadding)
  assert Base.decode64("Zm9vY") == err(Base.Error.InvalidLength)
end

test "encode16 renders lowercase hex"
  assert Base.encode16(<<>>) == ""
  assert Base.encode16("Hello") == "48656c6c6f"
  assert Base.encode16(<<0, 15, 255>>) == "000fff"
end

test "decode16 accepts both cases and round-trips"
  assert Base.decode16("48656c6c6f") == ok("Hello".to_binary())
  assert Base.decode16("48656C6C6F") == ok("Hello".to_binary())

  all = every_byte()
  assert Base.decode16(Base.encode16(all)) == ok(all)
end

test "decode16 rejects malformed input"
  assert Base.decode16("abc") == err(Base.Error.InvalidLength)
  assert Base.decode16("4g") == err(Base.Error.InvalidCharacter("g"))
end

# Typed constructors so `==` comparisons can infer both Result
# parameters.
priv fn ok(bytes: Binary) -> Result<Binary, Base.Error>
  Result.Ok(bytes)
end

priv fn err(error: Base.Error) -> Result<Binary, Base.Error>
  Result.Err(error)
end

priv fn every_byte -> Binary
  all: Binary = <<>>
  i = 0

  while i < 256
    all = <<all, i>>
    i += 1
  end

  all
end
