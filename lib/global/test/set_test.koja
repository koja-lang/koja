test "new, insert, has?, length"
  s: Set<Int> = Set.new()
  s = s.insert(10)
  s = s.insert(20)
  s = s.insert(10)

  assert s.length() == 2
  assert s.has?(10)
  assert not s.has?(30)
  assert not s.empty?()
end

test "remove deletes element"
  s: Set<Int> = Set.new()
  s = s.insert(10)
  s = s.insert(20)
  s = s.remove(10)

  assert s.length() == 1
  assert not s.has?(10)
end

test "from list deduplicates"
  s: Set<Int> = [1, 2, 3, 2, 1]

  assert s.length() == 3
  assert s.has?(1)
  assert s.has?(2)
  assert s.has?(3)
  assert not s.has?(4)
end

test "iteration, equality, and debug"
  set: Set<Int> = [1, 2, 3]
  count = 0
  sum = 0

  for item in set
    count += 1
    sum += item
  end

  assert count == 3
  assert sum == 6

  same: Set<Int> = [3, 1, 2]
  different: Set<Int> = [1, 2, 4]

  assert set == same
  assert set != different

  rendered = set.format()

  assert rendered.starts_with?("[")
  assert rendered.ends_with?("]")
  assert rendered.contains?("1")
  assert rendered.contains?("3")
end
