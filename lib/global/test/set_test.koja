test "new, insert, has?, length"
  s: Set<Int> = Set.new()
  s = s.insert(10)
  s = s.insert(20)
  s = s.insert(10)

  assert s.length() == 2
  assert s.has?(10)
  assert not s.has?(30)
  assert not s.empty?()
end

test "remove deletes element"
  s: Set<Int> = Set.new()
  s = s.insert(10)
  s = s.insert(20)
  s = s.remove(10)

  assert s.length() == 1
  assert not s.has?(10)
end

test "remove leaves a copy unchanged"
  s: Set<String> = ["hello", "world"]
  copy = s
  s = s.remove("hello")

  assert s.length() == 1
  assert copy.length() == 2
  assert copy.has?("hello")
end

test "insert after remove keeps one element"
  s: Set<Int> = Set.new()
  s = s.insert(1)
  s = s.insert(3)
  s = s.insert(5)
  s = s.insert(7)
  s = s.remove(1)
  s = s.insert(7)

  assert s.length() == 3
  assert s.has?(7)
end

test "has? misses after many elements come and go"
  s: Set<Int> = Set.new()
  item = 0

  while item < 64
    s = s.insert(item)
    s = s.remove(item)
    item += 1
  end

  assert s.empty?()
  assert not s.has?(1000)
end

test "remove keeps the other elements in reach"
  s: Set<Int> = Set.new()
  item = 0

  while item < 48
    s = s.insert(item)
    item += 1
  end

  item = 0

  while item < 48
    s = s.remove(item)
    item += 3
  end

  assert s.length() == 32
  item = 0

  while item < 48
    assert s.has?(item) == (item % 3 != 0)
    item += 1
  end
end

test "from list deduplicates"
  s: Set<Int> = [1, 2, 3, 2, 1]

  assert s.length() == 3
  assert s.has?(1)
  assert s.has?(2)
  assert s.has?(3)
  assert not s.has?(4)
end

test "iteration, equality, and debug"
  set: Set<Int> = [1, 2, 3]
  count = 0
  sum = 0

  for item in set
    count += 1
    sum += item
  end

  assert count == 3
  assert sum == 6

  same: Set<Int> = [3, 1, 2]
  different: Set<Int> = [1, 2, 4]

  assert set == same
  assert set != different

  rendered = set.format()

  assert rendered.starts_with?("[")
  assert rendered.ends_with?("]")
  assert rendered.contains?("1")
  assert rendered.contains?("3")
end
