struct SetTest
  @test "new, insert, has?, length"
  fn test_new_insert_has ! String
    s: Set<Int> = Set.new()
    s = s.insert(10)
    s = s.insert(20)
    s = s.insert(10)

    if s.length() != 2
      fail "expected length 2, got #{s.length()}"
    end

    if not s.has?(10)
      fail "expected has 10"
    end

    if s.has?(30)
      fail "should not have 30"
    end

    if s.empty?()
      fail "should not be empty"
    end
  end

  @test "remove deletes element"
  fn test_remove ! String
    s: Set<Int> = Set.new()
    s = s.insert(10)
    s = s.insert(20)
    s = s.remove(10)

    if s.length() != 1
      fail "expected length 1 after remove"
    end

    if s.has?(10)
      fail "10 should be removed"
    end
  end

  @test "from list deduplicates"
  fn test_from_list ! String
    s: Set<Int> = [1, 2, 3, 2, 1]

    if s.length() != 3
      fail "expected length 3, got #{s.length()}"
    end

    if not s.has?(1)
      fail "expected has 1"
    end

    if not s.has?(2)
      fail "expected has 2"
    end

    if not s.has?(3)
      fail "expected has 3"
    end

    if s.has?(4)
      fail "should not have 4"
    end
  end

  @test "iteration, equality, and debug"
  fn test_iteration_equality_debug ! String
    set: Set<Int> = [1, 2, 3]
    count = 0
    sum = 0

    for item in set
      count += 1
      sum += item
    end

    if not (count == 3 and sum == 6)
      fail "set iteration missed an element"
    end

    same: Set<Int> = [3, 1, 2]
    different: Set<Int> = [1, 2, 4]

    if set != same
      fail "equal sets compared unequal"
    end

    if set == different
      fail "different sets compared equal"
    end

    rendered = set.format()

    if not (rendered.starts_with?("[") and rendered.ends_with?("]"))
      fail "set debug did not use list literal syntax"
    end

    if not (rendered.contains?("1") and rendered.contains?("3"))
      fail "set debug omitted an element"
    end
  end
end
