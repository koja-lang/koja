alias URI.Error as URIError

test "encode escapes only forbidden characters"
  encoded = URI.encode("ftp://s-ite.tld/?value=put it+й")
  assert encoded == "ftp://s-ite.tld/?value=put%20it+%D0%B9"
end

test "encode keeps reserved and unreserved characters"
  input = "abc123-._~:/?#[]@!$&'()*+,;="
  assert URI.encode(input) == input
end

test "encode uses uppercase hex"
  assert URI.encode("a b") == "a%20b"
end

test "decode unescapes percent sequences"
  decoded = try Test.require(URI.decode("https%3A%2F%2Fkoja-lang.org"))
  assert decoded == "https://koja-lang.org"
end

test "decode accepts lowercase hex"
  decoded = try Test.require(URI.decode("%2fpath"))
  assert decoded == "/path"
end

test "decode passes strings without escapes through"
  decoded = try Test.require(URI.decode("plain-text_~123"))
  assert decoded == "plain-text_~123"
end

test "decode rejects malformed percent sequences"
  match URI.decode("bad%ZZsequence")
    Result.Ok(decoded) -> fail "expected error, got #{decoded}"
    Result.Err(URIError.InvalidPercentEncoding(part)) -> assert part == "%ZZ"
    Result.Err(err) -> fail "expected InvalidPercentEncoding, got #{err}"
  end
end

test "decode rejects truncated percent sequences"
  assert URI.decode("truncated%2").err?()
  assert URI.decode("truncated%").err?()
end

test "decode rejects invalid UTF-8"
  match URI.decode("%FF")
    Result.Ok(decoded) -> fail "expected error, got #{decoded}"
    Result.Err(URIError.InvalidUTF8) -> ()
    Result.Err(err) -> fail "expected InvalidUTF8, got #{err}"
  end
end

test "decode reverses encode"
  input = "hello world/й?=100%"
  encoded = URI.encode(input)
  decoded = try Test.require(URI.decode(encoded))
  assert decoded == input
end
