test "empty data has the standard zero checksums"
  assert Checksum.crc32(<<>>) == 0
  assert Checksum.crc32c(<<>>) == 0
end

test "checksums match the standard check values"
  data = "123456789".to_binary()

  assert Checksum.crc32(data) == 0xCBF43926
  assert Checksum.crc32c(data) == 0xE3069283
end

test "checksums include embedded zero bytes"
  data = <<0, 1, 0, 255>>

  assert Checksum.crc32(data) == 0x0D845AA6
  assert Checksum.crc32c(data) == 0x405B8AE8
end
