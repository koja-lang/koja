test "band bor bxor bnot bsl bsr"
  assert 5.band(3) == 1
  assert 5.bor(3) == 7
  assert 5.bxor(3) == 6
  assert 0.bnot() == -1
  assert 1.bsl(4) == 16
  assert 16.bsr(4) == 1
end

test "chained bitwise on flags"
  flags = 0xFF

  assert flags.band(0x0F) == 15
  assert flags.band(0x0F).bor(0x30) == 63
end
