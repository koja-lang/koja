struct ListTest
  @test "new, append, get, length"
  fn test_new_append_get ! String
    list: List<Int> = List.new()
    list = list.append(10)
    list = list.append(20)
    list = list.append(30)

    if list.length() != 3
      fail "expected length 3, got #{list.length()}"
    end

    if list.get(0).unwrap() != 10
      fail "expected 10 at index 0"
    end

    if list.get(1).unwrap() != 20
      fail "expected 20 at index 1"
    end

    if list.get(2).unwrap() != 30
      fail "expected 30 at index 2"
    end

    if list.empty?()
      fail "should not be empty"
    end
  end

  @test "literal syntax"
  fn test_literal ! String
    nums = [10, 20, 30]

    if nums.length() != 3
      fail "expected length 3"
    end

    if nums.get(0).unwrap() != 10
      fail "expected 10 at 0"
    end

    if nums.get(2).unwrap() != 30
      fail "expected 30 at 2"
    end
  end

  @test "empty literal"
  fn test_empty_literal ! String
    empty: List<Int> = []

    if empty.length() != 0
      fail "expected length 0"
    end

    if not empty.empty?()
      fail "should be empty"
    end
  end

  @test "string list"
  fn test_string_list ! String
    words = ["hello", "world"]

    if words.get(0).unwrap() != "hello"
      fail "expected hello"
    end

    if words.get(1).unwrap() != "world"
      fail "expected world"
    end
  end

  @test "single element literal"
  fn test_single_element ! String
    single = [42]

    if single.length() != 1
      fail "expected length 1"
    end

    if single.get(0).unwrap() != 42
      fail "expected 42"
    end
  end

  @test "first returns first element"
  fn test_first ! String
    list = [10, 20, 30, 40, 50]

    if list.first().unwrap() != 10
      fail "expected first 10"
    end
  end

  @test "pop removes last element"
  fn test_pop ! String
    list = [10, 20, 30, 40, 50]
    (popped, remaining) = list.pop()

    if popped.unwrap() != 50
      fail "expected popped value 50"
    end

    if remaining.length() != 4
      fail "expected remaining length 4"
    end
  end

  @test "pop until empty"
  fn test_pop_empty ! String
    rest = [1, 2, 3]
    (_, rest) = rest.pop()
    (_, rest) = rest.pop()
    (_, rest) = rest.pop()
    (popped, _) = rest.pop()

    if popped.some?()
      fail "expected None from empty pop"
    end
  end

  @test "replace_at in bounds"
  fn test_replace_at ! String
    updated = [1, 2, 3].replace_at(1, 99)

    if updated.get(1).unwrap() != 99
      fail "expected 99 at index 1"
    end
  end

  @test "replace_at out of bounds is no-op"
  fn test_replace_at_oob ! String
    same = [1, 2, 3].replace_at(10, 99)

    if same.length() != 3
      fail "expected length 3"
    end
  end

  @test "slice extracts sublist"
  fn test_slice ! String
    sliced = [10, 20, 30, 40, 50].slice(1, 3)

    if sliced.length() != 3
      fail "expected length 3, got #{sliced.length()}"
    end

    if sliced.first().unwrap() != 20
      fail "expected first 20"
    end

    if sliced.last().unwrap() != 40
      fail "expected last 40"
    end
  end

  @test "slice clamps to bounds"
  fn test_slice_clamped ! String
    clamped = [1, 2, 3].slice(1, 100)

    if clamped.length() != 2
      fail "expected length 2, got #{clamped.length()}"
    end
  end

  @test "concat joins two lists"
  fn test_concat ! String
    combined = [1, 2].concat([3, 4, 5])

    if combined.length() != 5
      fail "expected length 5"
    end

    if combined.last().unwrap() != 5
      fail "expected last 5"
    end
  end

  @test "reverse reverses order"
  fn test_reverse ! String
    rev = [1, 2, 3].reverse()

    if rev.first().unwrap() != 3
      fail "expected first 3"
    end

    if rev.last().unwrap() != 1
      fail "expected last 1"
    end
  end

  @test "find returns matching element"
  fn test_find ! String
    found = [10, 20, 30].find(fn (x: Int) -> Bool x > 15 end)

    if found.unwrap() != 20
      fail "expected 20"
    end

    not_found = [10, 20, 30].find(fn (x: Int) -> Bool x > 100 end)

    if not_found.some?()
      fail "expected None"
    end
  end

  @test "reduce accumulates value"
  fn test_reduce ! String
    sum = [1, 2, 3, 4].reduce(0, fn (acc: Int, x: Int) -> Int acc + x end)

    if sum != 10
      fail "expected sum 10, got #{sum}"
    end
  end

  @test "map transforms elements"
  fn test_map ! String
    nums = [1, 2, 3, 4, 5]
    doubled = nums.map(fn (n: Int) -> Int n * 2 end)

    if doubled.length() != 5
      fail "expected length 5"
    end

    if doubled.get(0).unwrap() != 2
      fail "expected 2 at 0"
    end

    if doubled.get(4).unwrap() != 10
      fail "expected 10 at 4"
    end
  end

  @test "map changes element type"
  fn test_map_type_change ! String
    strings = [1, 2, 3].map(fn (n: Int) -> String "item_#{n}" end)

    if strings.get(0).unwrap() != "item_1"
      fail "expected item_1"
    end

    if strings.get(2).unwrap() != "item_3"
      fail "expected item_3"
    end
  end

  @test "filter selects matching elements"
  fn test_filter ! String
    big = [1, 2, 3, 4, 5].filter(fn (n: Int) -> Bool n > 2 end)

    if big.length() != 3
      fail "expected length 3, got #{big.length()}"
    end

    if big.first().unwrap() != 3
      fail "expected first 3"
    end
  end

  @test "any? and all? predicates"
  fn test_any_all ! String
    nums = [1, 2, 3, 4, 5]

    if not nums.any?(fn (n: Int) -> Bool n > 4 end)
      fail "any? should find 5"
    end

    if not nums.all?(fn (n: Int) -> Bool n > 0 end)
      fail "all? should pass for positive"
    end

    if nums.all?(fn (n: Int) -> Bool n > 3 end)
      fail "all? should fail for > 3"
    end
  end

  @test "filter then map chaining"
  fn test_chaining ! String
    chained = [1, 2, 3, 4, 5]
      .filter(fn (n: Int) -> Bool n > 2 end)
      .map(fn (n: Int) -> Int n * 10 end)

    if chained.length() != 3
      fail "expected length 3"
    end

    if chained.get(0).unwrap() != 30
      fail "expected 30 at 0"
    end

    if chained.get(1).unwrap() != 40
      fail "expected 40 at 1"
    end

    if chained.get(2).unwrap() != 50
      fail "expected 50 at 2"
    end
  end

  @test "for-in iterates map, filter, and chained lists"
  fn test_for_in_iterators ! String
    nums: List<Int> = [1, 2, 3, 4, 5]

    doubled = nums.map(fn (n: Int) -> Int n * 2 end)
    sum_d = 0

    for d in doubled
      sum_d += d
    end

    if sum_d != 30
      fail "expected sum 30 from doubled, got #{sum_d}"
    end

    big = nums.filter(fn (n: Int) -> Bool n > 2 end)
    sum_b = 0

    for b in big
      sum_b += b
    end

    if sum_b != 12
      fail "expected sum 12 from filter, got #{sum_b}"
    end

    chained = nums.filter(fn (n: Int) -> Bool n > 2 end)
      .map(fn (n: Int) -> Int n * 10 end)
    sum_c = 0

    for c in chained
      sum_c += c
    end

    if sum_c != 120
      fail "expected sum 120 from chained, got #{sum_c}"
    end
  end

  @test "equality compares elements"
  fn test_equality ! String
    if [1, 2, 3] != [1, 2, 3]
      fail "identical lists should be equal"
    end

    if [1, 2, 3] == [1, 2, 4]
      fail "lists differing in one element should not be equal"
    end

    if [1, 2] == [1, 2, 3]
      fail "lists of different lengths should not be equal"
    end

    empty_a: List<Int> = []
    empty_b: List<Int> = []

    if empty_a != empty_b
      fail "empty lists should be equal"
    end
  end

  @test "equality on string and nested lists"
  fn test_equality_nested ! String
    if ["a", "b"] != ["a", "b"]
      fail "string lists should compare element-wise"
    end

    if ["a", "b"] == ["a", "c"]
      fail "differing string lists should not be equal"
    end

    nested_a = [[1, 2], [3]]
    nested_b = [[1, 2], [3]]
    nested_c = [[1, 2], [4]]

    if nested_a != nested_b
      fail "nested lists should compare recursively"
    end

    if nested_a == nested_c
      fail "differing nested lists should not be equal"
    end
  end
end
