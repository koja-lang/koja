test "new, append, get, length"
  list: List<Int> = List.new()
  list = list.append(10)
  list = list.append(20)
  list = list.append(30)

  assert list.length() == 3
  assert list.get(0).unwrap() == 10
  assert list.get(1).unwrap() == 20
  assert list.get(2).unwrap() == 30
  assert not list.empty?()
end

test "literal syntax"
  nums = [10, 20, 30]

  assert nums.length() == 3
  assert nums.get(0).unwrap() == 10
  assert nums.get(2).unwrap() == 30
end

test "empty literal"
  empty: List<Int> = []

  assert empty.length() == 0
  assert empty.empty?()
end

test "string list"
  words = ["hello", "world"]

  assert words.get(0).unwrap() == "hello"
  assert words.get(1).unwrap() == "world"
end

test "single element literal"
  single = [42]

  assert single.length() == 1
  assert single.get(0).unwrap() == 42
end

test "first returns first element"
  list = [10, 20, 30, 40, 50]
  assert list.first().unwrap() == 10
end

test "pop removes last element"
  list = [10, 20, 30, 40, 50]
  (popped, remaining) = list.pop()

  assert popped.unwrap() == 50
  assert remaining.length() == 4
end

test "pop until empty"
  rest = [1, 2, 3]
  (_, rest) = rest.pop()
  (_, rest) = rest.pop()
  (_, rest) = rest.pop()
  (popped, _) = rest.pop()

  assert popped.none?()
end

test "replace_at in bounds"
  updated = [1, 2, 3].replace_at(1, 99)
  assert updated.get(1).unwrap() == 99
end

test "replace_at out of bounds is no-op"
  same = [1, 2, 3].replace_at(10, 99)
  assert same.length() == 3
end

test "slice extracts sublist"
  sliced = [10, 20, 30, 40, 50].slice(1, 3)

  assert sliced.length() == 3
  assert sliced.first().unwrap() == 20
  assert sliced.last().unwrap() == 40
end

test "slice clamps to bounds"
  clamped = [1, 2, 3].slice(1, 100)
  assert clamped.length() == 2
end

test "concat joins two lists"
  combined = [1, 2].concat([3, 4, 5])

  assert combined.length() == 5
  assert combined.last().unwrap() == 5
end

test "reverse reverses order"
  rev = [1, 2, 3].reverse()

  assert rev.first().unwrap() == 3
  assert rev.last().unwrap() == 1
end

test "find returns matching element"
  found = [10, 20, 30].find(fn (x: Int) -> Bool x > 15 end)
  assert found.unwrap() == 20

  not_found = [10, 20, 30].find(fn (x: Int) -> Bool x > 100 end)
  assert not_found.none?()
end

test "reduce accumulates value"
  sum = [1, 2, 3, 4].reduce(0, fn (acc: Int, x: Int) -> Int acc + x end)
  assert sum == 10
end

test "map transforms elements"
  nums = [1, 2, 3, 4, 5]
  doubled = nums.map(fn (n: Int) -> Int n * 2 end)

  assert doubled.length() == 5
  assert doubled.get(0).unwrap() == 2
  assert doubled.get(4).unwrap() == 10
end

test "map changes element type"
  strings = [1, 2, 3].map(fn (n: Int) -> String "item_#{n}" end)

  assert strings.get(0).unwrap() == "item_1"
  assert strings.get(2).unwrap() == "item_3"
end

test "filter selects matching elements"
  big = [1, 2, 3, 4, 5].filter(fn (n: Int) -> Bool n > 2 end)

  assert big.length() == 3
  assert big.first().unwrap() == 3
end

test "any? and all? predicates"
  nums = [1, 2, 3, 4, 5]

  assert nums.any?(fn (n: Int) -> Bool n > 4 end)
  assert nums.all?(fn (n: Int) -> Bool n > 0 end)
  assert not nums.all?(fn (n: Int) -> Bool n > 3 end)
end

test "filter then map chaining"
  chained = [1, 2, 3, 4, 5]
    .filter(fn (n: Int) -> Bool n > 2 end)
    .map(fn (n: Int) -> Int n * 10 end)

  assert chained.length() == 3
  assert chained.get(0).unwrap() == 30
  assert chained.get(1).unwrap() == 40
  assert chained.get(2).unwrap() == 50
end

test "for-in iterates map, filter, and chained lists"
  nums: List<Int> = [1, 2, 3, 4, 5]

  doubled = nums.map(fn (n: Int) -> Int n * 2 end)
  sum_d = 0

  for d in doubled
    sum_d += d
  end

  assert sum_d == 30

  big = nums.filter(fn (n: Int) -> Bool n > 2 end)
  sum_b = 0

  for b in big
    sum_b += b
  end

  assert sum_b == 12

  chained = nums.filter(fn (n: Int) -> Bool n > 2 end)
    .map(fn (n: Int) -> Int n * 10 end)
  sum_c = 0

  for c in chained
    sum_c += c
  end

  assert sum_c == 120
end

test "equality compares elements"
  assert [1, 2, 3] == [1, 2, 3]
  assert [1, 2, 3] != [1, 2, 4]
  assert [1, 2] != [1, 2, 3]

  empty_a: List<Int> = []
  empty_b: List<Int> = []
  assert empty_a == empty_b
end

test "equality on string and nested lists"
  assert ["a", "b"] == ["a", "b"]
  assert ["a", "b"] != ["a", "c"]

  nested_a = [[1, 2], [3]]
  nested_b = [[1, 2], [3]]
  nested_c = [[1, 2], [4]]

  assert nested_a == nested_b
  assert nested_a != nested_c
end
