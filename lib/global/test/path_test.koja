test "absolute? recognizes a leading slash"
  assert Path.absolute?("/")
  assert Path.absolute?("/usr/local")
  assert not Path.absolute?("usr/local")
  assert not Path.absolute?("")
end

test "basename returns the last component"
  cases: List<(String, String)> = [
    ("foo", "foo"), ("foo/bar", "bar"), ("foo/bar/", "bar"), ("/", ""),
    ("//", ""), ("", "")
  ]

  for test_case in cases
    (input, expected) = test_case
    assert Path.basename(input) == expected
  end
end

test "dirname returns the directory component"
  cases: List<(String, String)> = [
    ("/foo/bar.ex", "/foo"), ("/foo/bar/", "/foo/bar"), ("bar.ex", "."),
    ("foo//bar", "foo"), ("/foo", "/"), ("/", "/"), ("", ".")
  ]

  for test_case in cases
    (input, expected) = test_case
    assert Path.dirname(input) == expected
  end
end

test "extname returns the last dot segment of the basename"
  cases: List<(String, String)> = [
    ("foo.erl", ".erl"), ("~/foo/bar", ""), (".gitignore", ""), ("foo.", "."),
    ("foo.d/bar", ""), ("archive.tar.gz", ".gz")
  ]

  for test_case in cases
    (input, expected) = test_case
    assert Path.extname(input) == expected
  end
end

test "rootname strips exactly the extension"
  assert Path.rootname("/foo/bar.ex") == "/foo/bar"
  assert Path.rootname("archive.tar.gz") == "archive.tar"
  assert Path.rootname("foo") == "foo"
  # Unlike Elixir, a dotfile has no extension so it passes through.
  assert Path.rootname(".gitignore") == ".gitignore"
end

test "join collapses separators and skips empty segments"
  assert Path.join(["/", "foo", "bar/"]) == "/foo/bar"
  assert Path.join(["/foo", "/bar/"]) == "/foo/bar"
  assert Path.join(["", "foo"]) == "foo"
  assert Path.join(["foo"]) == "foo"
  assert Path.join(["/"]) == "/"

  empty: List<String> = List.new()
  assert Path.join(empty) == ""
end

test "split breaks a path into components"
  none: List<String> = []
  assert Path.split("") == none
  assert Path.split("/") == ["/"]
  assert Path.split("/foo/bar") == ["/", "foo", "bar"]
  assert Path.split("foo/bar") == ["foo", "bar"]
  assert Path.split("/foo//bar/") == ["/", "foo", "bar"]
end

test "expand resolves dot segments lexically"
  assert Path.expand("/foo/bar/../baz") == "/foo/baz"
  assert Path.expand("/foo/../../baz") == "/baz"
  assert Path.expand("/foo/./bar") == "/foo/bar"
end

test "expand resolves relative paths against the working directory"
  cwd = System.cwd().unwrap()

  assert Path.expand("foo") == Path.join([cwd, "foo"])
  assert Path.expand("foo/..") == cwd
  assert Path.expand("") == cwd
end

test "expand replaces a leading tilde with HOME"
  saved = System.get_env("HOME")
  System.set_env("HOME", "/home/koja")

  tilde_only = Path.expand("~")
  tilde_child = Path.expand("~/projects")
  tilde_user = Path.expand("~other")

  System.set_env("HOME", saved.or(""))

  assert tilde_only == "/home/koja"
  assert tilde_child == "/home/koja/projects"
  # "~other" is a plain relative component, not a user expansion.
  assert tilde_user == Path.join([System.cwd().unwrap(), "~other"])
end

test "relative_to walks between relative paths"
  assert Path.relative_to("tmp/foo/bar", "tmp") == "foo/bar"
  assert Path.relative_to("tmp/foo/bar", "tmp/bat") == "../foo/bar"
  assert Path.relative_to("foo", "foo") == "."
  assert Path.relative_to("foo/../bar", "baz") == "../bar"
end

test "relative_to strips a shared absolute prefix"
  assert Path.relative_to("/usr/local/foo", "/usr/local") == "foo"
  assert Path.relative_to("/usr/local/foo", "/") == "usr/local/foo"
  assert Path.relative_to("/usr/local/foo", "/etc") == "/usr/local/foo"
  assert Path.relative_to("/usr/local/foo", "/usr/local/foo") == "."
  assert Path.relative_to("/usr/local/../foo/bar", "/usr/foo") == "bar"
end

test "relative_to returns the path unchanged for mixed kinds"
  assert Path.relative_to("/usr/foo/bar", "tmp/bat") == "/usr/foo/bar"
  assert Path.relative_to("foo", "/usr/local") == "foo"
  assert Path.relative_to("foo/../bar", "/usr/local") == "bar"
end
