alias URI.Error as URIError

test "parses a full absolute URI"
  input = "http://user:pass@example.com:8080/path?a=1#frag"
  uri = try Test.require(URI.parse(input))
  expected = URI{
    fragment: Option.Some("frag"),
    host: Option.Some("example.com"),
    path: "/path",
    port: Option.Some(8080),
    query: Option.Some("a=1"),
    scheme: Option.Some("http"),
    userinfo: Option.Some("user:pass"),
  }

  assert uri == expected
end

test "fills default port for known schemes"
  uri = try Test.require(URI.parse("https://koja-lang.org/"))

  assert uri.port == Option.Some(443)
  assert uri.path == "/"
end

test "parses protocol-relative reference"
  uri = try Test.require(URI.parse("//koja-lang.org/"))

  assert uri.scheme.none?()
  assert uri.port.none?()
  assert uri.host == Option.Some("koja-lang.org")
end

test "parses absolute and relative paths"
  absolute = try Test.require(URI.parse("/foo/bar"))

  assert absolute.path == "/foo/bar"
  assert absolute.host.none?()
  assert absolute.scheme.none?()

  relative = try Test.require(URI.parse("foo/bar"))
  assert relative.path == "foo/bar"
end

test "parses bracketed IPv6 host"
  uri = try Test.require(URI.parse("//[fe80::]/"))

  assert uri.host == Option.Some("fe80::")
  assert uri.to_string() == "//[fe80::]/"
end

test "parses scheme-only URI with query"
  uri = try Test.require(URI.parse("https:?query"))

  assert uri.query == Option.Some("query")
  assert uri.path == ""
  assert uri.host.none?()
end

test "lowercases the scheme"
  uri = try Test.require(URI.parse("HTTPS://EXAMPLE.COM/"))

  assert uri.scheme == Option.Some("https")
  assert uri.host == Option.Some("EXAMPLE.COM")
end

test "rejects forbidden characters"
  assert URI.parse("/invalid_greater_than_in_path/>").err?()
  assert URI.parse("http://exa mple.com/").err?()
  assert URI.parse("http://example.com:8a/").err?()
end

test "rejects colon in first segment of relative reference"
  assert URI.parse("1ab:cd").err?()
end

test "reports the offending part"
  match URI.parse("/invalid_greater_than_in_path/>")
    Result.Ok(uri) -> fail "expected error, got #{uri}"
    Result.Err(URIError.InvalidURI(part)) -> assert part == ">"
    Result.Err(err) -> fail "expected InvalidURI, got #{err}"
  end
end

test "to_string reassembles components"
  inputs = [
    "http://user:pass@example.com:8080/path?a=1#frag", "https://koja-lang.org/",
    "//koja-lang.org/", "/foo/bar", "foo/bar", "https:?query"
  ]

  for input in inputs
    uri = try Test.require(URI.parse(input))
    assert uri.to_string() == input
  end
end

test "to_string omits the default port"
  uri = try Test.require(URI.parse("https://example.com:443/"))

  assert uri.port == Option.Some(443)
  assert uri.to_string() == "https://example.com/"
end

test "default_port knows common schemes"
  assert URI.default_port("ftp") == Option.Some(21)
  assert URI.default_port("wss") == Option.Some(443)
  assert URI.default_port("ponzi").none?()
end

test "equality is component-wise"
  a = URI.parse("http://example.com/a?x=1").unwrap()
  b = URI.parse("http://example.com/a?x=1").unwrap()
  c = URI.parse("http://example.com/b?x=1").unwrap()

  assert a == b
  assert a != c
end

test "interpolation renders the URI string"
  uri = URI.parse("https://example.com/pkg?v=1").unwrap()
  assert "#{uri}" == "https://example.com/pkg?v=1"
end
