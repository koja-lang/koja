alias URI.Error as URIError

struct URITest
  @test "parses a full absolute URI"
  fn test_parse_full ! String
    match URI.parse("http://user:pass@example.com:8080/path?a=1#frag")
      Result.Err(err) ->
        fail "expected Ok, got #{err}"

      Result.Ok(uri) ->
        expected = URI{
          fragment: Option.Some("frag"),
          host: Option.Some("example.com"),
          path: "/path",
          port: Option.Some(8080),
          query: Option.Some("a=1"),
          scheme: Option.Some("http"),
          userinfo: Option.Some("user:pass"),
        }

        if uri != expected
          fail "unexpected parse: #{uri.format()}"
        end
    end
  end

  @test "fills default port for known schemes"
  fn test_parse_default_port ! String
    match URI.parse("https://koja-lang.org/")
      Result.Err(err) ->
        fail "expected Ok, got #{err}"

      Result.Ok(uri) ->
        if not URITest.option_int_is(uri.port, 443)
          fail "expected port 443, got #{uri.port.format()}"
        end

        if uri.path != "/"
          fail "expected path /, got #{uri.path}"
        end
    end
  end

  @test "parses protocol-relative reference"
  fn test_parse_protocol_relative ! String
    match URI.parse("//koja-lang.org/")
      Result.Err(err) ->
        fail "expected Ok, got #{err}"

      Result.Ok(uri) ->
        if not (uri.scheme.none?() and uri.port.none?())
          fail "expected no scheme or port: #{uri.format()}"
        end

        if not URITest.option_string_is(uri.host, "koja-lang.org")
          fail "unexpected host: #{uri.host.format()}"
        end
    end
  end

  @test "parses absolute and relative paths"
  fn test_parse_paths ! String
    match URI.parse("/foo/bar")
      Result.Err(err) ->
        fail "expected Ok, got #{err}"

      Result.Ok(uri) ->
        if not (uri.path == "/foo/bar" and uri.host.none?())
          and uri.scheme.none?()

          fail "unexpected parse: #{uri.format()}"
        end
    end

    match URI.parse("foo/bar")
      Result.Err(err) ->
        fail "expected Ok, got #{err}"

      Result.Ok(uri) ->
        if uri.path != "foo/bar"
          fail "unexpected path: #{uri.path}"
        end
    end
  end

  @test "parses bracketed IPv6 host"
  fn test_parse_ipv6 ! String
    match URI.parse("//[fe80::]/")
      Result.Err(err) ->
        fail "expected Ok, got #{err}"

      Result.Ok(uri) ->
        if not URITest.option_string_is(uri.host, "fe80::")
          fail "unexpected host: #{uri.host.format()}"
        end

        if uri.to_string() != "//[fe80::]/"
          fail "bad round trip: #{uri}"
        end
    end
  end

  @test "parses scheme-only URI with query"
  fn test_parse_scheme_query ! String
    match URI.parse("https:?query")
      Result.Err(err) ->
        fail "expected Ok, got #{err}"

      Result.Ok(uri) ->
        if not URITest.option_string_is(uri.query, "query")
          fail "unexpected query: #{uri.query.format()}"
        end

        if not (uri.path == "" and uri.host.none?())
          fail "unexpected parse: #{uri.format()}"
        end
    end
  end

  @test "lowercases the scheme"
  fn test_parse_scheme_case ! String
    match URI.parse("HTTPS://EXAMPLE.COM/")
      Result.Err(err) ->
        fail "expected Ok, got #{err}"

      Result.Ok(uri) ->
        if not URITest.option_string_is(uri.scheme, "https")
          fail "unexpected scheme: #{uri.scheme.format()}"
        end

        if not URITest.option_string_is(uri.host, "EXAMPLE.COM")
          fail "host should keep case: #{uri.host.format()}"
        end
    end
  end

  @test "rejects forbidden characters"
  fn test_parse_invalid ! String
    if not URI.parse("/invalid_greater_than_in_path/>").err?()
      fail "expected error for > in path"
    end

    if not URI.parse("http://exa mple.com/").err?()
      fail "expected error for space in host"
    end

    if not URI.parse("http://example.com:8a/").err?()
      fail "expected error for non-digit port"
    end
  end

  @test "rejects colon in first segment of relative reference"
  fn test_parse_relative_colon ! String
    if not URI.parse("1ab:cd").err?()
      fail "expected error for ambiguous relative reference"
    end
  end

  @test "reports the offending part"
  fn test_parse_error_part ! String
    match URI.parse("/invalid_greater_than_in_path/>")
      Result.Ok(uri) ->
        fail "expected error, got #{uri}"

      Result.Err(err) ->
        match err
          URIError.InvalidURI(part) ->
            if part != ">"
              fail "expected part >, got #{part}"
            end

          _ ->
            fail "expected InvalidURI, got #{err}"
        end
    end
  end

  @test "to_string reassembles components"
  fn test_to_string_round_trip ! String
    inputs = [
      "http://user:pass@example.com:8080/path?a=1#frag",
      "https://koja-lang.org/", "//koja-lang.org/", "/foo/bar", "foo/bar",
      "https:?query"
    ]

    for input in inputs
      match URI.parse(input)
        Result.Err(err) ->
          fail "parse failed for #{input}: #{err}"

        Result.Ok(uri) ->
          if uri.to_string() != input
            fail "round trip failed: #{input} -> #{uri}"
          end
      end
    end
  end

  @test "to_string omits the default port"
  fn test_to_string_default_port ! String
    match URI.parse("https://example.com:443/")
      Result.Err(err) ->
        fail "expected Ok, got #{err}"

      Result.Ok(uri) ->
        if not URITest.option_int_is(uri.port, 443)
          fail "expected port 443, got #{uri.port.format()}"
        end

        if uri.to_string() != "https://example.com/"
          fail "expected port omitted, got #{uri}"
        end
    end
  end

  @test "default_port knows common schemes"
  fn test_default_port ! String
    if not URITest.option_int_is(URI.default_port("ftp"), 21)
      fail "expected ftp -> 21"
    end

    if not URITest.option_int_is(URI.default_port("wss"), 443)
      fail "expected wss -> 443"
    end

    if not URI.default_port("ponzi").none?()
      fail "expected unknown scheme -> None"
    end
  end

  @test "equality is component-wise"
  fn test_equality ! String
    a = URI.parse("http://example.com/a?x=1").unwrap()
    b = URI.parse("http://example.com/a?x=1").unwrap()
    c = URI.parse("http://example.com/b?x=1").unwrap()

    if a != b
      fail "expected equal URIs"
    end

    if a == c
      fail "expected unequal URIs"
    end
  end

  @test "interpolation renders the URI string"
  fn test_interpolation ! String
    uri = URI.parse("https://example.com/pkg?v=1").unwrap()

    if "#{uri}" != "https://example.com/pkg?v=1"
      fail "unexpected interpolation: #{uri}"
    end
  end

  priv fn option_int_is(opt: Option<Int>, expected: Int) -> Bool
    match opt
      Option.Some(value) -> value == expected
      Option.None -> false
    end
  end

  priv fn option_string_is(opt: Option<String>, expected: String) -> Bool
    match opt
      Option.Some(value) -> value == expected
      Option.None -> false
    end
  end
end
