test "set_env and get_env roundtrip"
  System.set_env("KOJA_SYSTEM_TEST_VAR", "hello")
  assert System.get_env("KOJA_SYSTEM_TEST_VAR") == Option.Some("hello")
end

test "get_env returns None for unset variable"
  assert System.get_env("KOJA_DEFINITELY_UNSET_VAR_999").none?()
end

test "cwd returns a non-empty string"
  dir = try Test.require(System.cwd())
  assert dir.length() > 0
end

test "hostname returns a non-empty string"
  assert System.hostname().length() > 0
end
