struct SystemTest
  @test "set_env and get_env roundtrip"
  fn test_set_get_env ! String
    System.set_env("KOJA_SYSTEM_TEST_VAR", "hello")

    match System.get_env("KOJA_SYSTEM_TEST_VAR")
      Option.None ->
        fail "expected Some, got None"

      Option.Some(val) ->
        if val != "hello"
          fail "expected 'hello', got '#{val}'"
        end
    end
  end

  @test "get_env returns None for unset variable"
  fn test_get_env_unset ! String
    match System.get_env("KOJA_DEFINITELY_UNSET_VAR_999")
      Option.Some(_) -> fail "expected None for unset var"
      Option.None -> ()
    end
  end

  @test "cwd returns a non-empty string"
  fn test_cwd ! String
    match System.cwd()
      Result.Err(msg) ->
        fail "cwd failed: #{msg}"

      Result.Ok(dir) ->
        if dir.length() <= 0
          fail "cwd returned empty string"
        end
    end
  end

  @test "hostname returns a non-empty string"
  fn test_hostname ! String
    if System.hostname().length() <= 0
      fail "hostname returned empty string"
    end
  end
end
