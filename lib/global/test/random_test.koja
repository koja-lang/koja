struct RandomTest
  @test "Random.bytes sizes"
  fn test_bytes_sizes ! String
    if Random.bytes(0).byte_size() != 0
      fail "bytes(0) size"
    end

    if Random.bytes(1).byte_size() != 1
      fail "bytes(1) size"
    end

    if Random.bytes(16).byte_size() != 16
      fail "bytes(16) size"
    end

    if Random.bytes(100).byte_size() != 100
      fail "bytes(100) size"
    end
  end

  @test "Random.int range"
  fn test_int_inclusive_range ! String
    trials = 0

    while trials < 32
      n = Random.int(1, 10)

      if n < 1
        fail "Random.int below min"
      end

      if n > 10
        fail "Random.int above max"
      end

      trials += 1
    end

    if Random.int(42, 42) != 42
      fail "singleton range should return that value"
    end
  end
end
