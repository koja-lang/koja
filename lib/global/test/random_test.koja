test "Random.bytes sizes"
  for size in [0, 1, 16, 100]
    assert Random.bytes(size).byte_size() == size
  end
end

test "Random.int range"
  trials = 0

  while trials < 32
    n = Random.int(1, 10)

    assert n >= 1
    assert n <= 10

    trials += 1
  end

  assert Random.int(42, 42) == 42
end
