alias File.Mode as FileMode

test "read /dev/null returns empty string"
  contents = try Test.require(File.read("/dev/null"))
  assert contents.empty?()
end

test "read nonexistent file returns Err"
  assert File.read("/tmp/nonexistent_koja_file_test_12345").err?()
end

test "write and read roundtrip"
  path = "/tmp/koja_file_test_write.txt"

  try Test.require(File.write(path, "hello from koja"))
  read = File.read(path)
  File.delete(path)

  contents = try Test.require(read)
  assert contents == "hello from koja"
end

test "open for read on /dev/null succeeds"
  file = try Test.require(File.open("/dev/null", FileMode.Read))
  _ = file.close()
end

test "open nonexistent file for read returns Err"
  missing = "/tmp/nonexistent_koja_file_test_12345"
  assert File.open(missing, FileMode.Read).err?()
end

test "open for write, write via fd, read back"
  path = "/tmp/koja_file_test_handle_write.txt"

  file = try Test.require(File.open(path, FileMode.Write))
  file.fd.write("handle write")
  read = File.read(path)
  File.delete(path)

  contents = try Test.require(read)
  assert contents == "handle write"
end

test "open for append adds to existing content"
  path = "/tmp/koja_file_test_append.txt"

  try Test.require(File.write(path, "first"))
  opened = File.open(path, FileMode.Append)

  match opened
    Result.Ok(file) -> _ = file.fd.write(" second")
    Result.Err(_) -> ()
  end

  read = File.read(path)
  File.delete(path)

  try Test.require(opened)
  contents = try Test.require(read)
  assert contents == "first second"
end

test "exists? returns true for /dev/null"
  assert File.exists?("/dev/null")
end

test "exists? returns false for nonexistent file"
  assert not File.exists?("/tmp/nonexistent_koja_file_test_99999")
end

test "delete removes a file"
  path = "/tmp/koja_file_test_delete.txt"

  try Test.require(File.write(path, "delete me"))
  try Test.require(File.delete(path))
  assert not File.exists?(path)
end

test "rename moves a file"
  src = "/tmp/koja_file_test_rename_src.txt"
  dst = "/tmp/koja_file_test_rename_dst.txt"

  try Test.require(File.write(src, "rename me"))
  renamed = File.rename(src, dst)
  src_exists = File.exists?(src)
  read = File.read(dst)
  File.delete(src)
  File.delete(dst)

  try Test.require(renamed)
  assert not src_exists
  contents = try Test.require(read)
  assert contents == "rename me"
end

test "close returns Ok"
  file = try Test.require(File.open("/dev/null", FileMode.Read))
  try Test.require(file.close())
end

test "binary write and read preserve arbitrary bytes"
  path = "/tmp/koja_file_test_binary.bin"
  expected: Binary = <<97, 0, 255>>

  try Test.require(File.write(path, expected))
  read = File.read_binary(path)
  File.delete(path)

  actual = try Test.require(read)
  assert actual == expected
end

test "text read rejects invalid UTF-8"
  path = "/tmp/koja_file_test_invalid_utf8.bin"

  try Test.require(File.write(path, <<255>>))
  result = File.read(path)
  File.delete(path)

  assert result.err?()
end

test "mkdir creates a directory that dir? sees and rmdir removes"
  path = "/tmp/koja_file_test_mkdir"
  File.rmdir(path)

  try Test.require(File.mkdir(path))
  created = File.dir?(path)
  removed = File.rmdir(path)

  assert created
  try Test.require(removed)
  assert not File.exists?(path)
end

test "mkdir errors when the directory already exists"
  path = "/tmp/koja_file_test_mkdir_existing"
  File.mkdir_p(path)

  result = File.mkdir(path)
  File.rmdir(path)

  assert result.err?()
end

test "mkdir errors when the parent is missing"
  assert File.mkdir("/tmp/koja_file_test_no_parent/child").err?()
end

test "mkdir_p creates missing parents and is idempotent"
  parent = "/tmp/koja_file_test_mkdir_p"
  nested = "#{parent}/a/b"

  try Test.require(File.mkdir_p(nested))
  repeat = File.mkdir_p(nested)
  created = File.dir?(nested)
  File.rmdir(nested)
  File.rmdir("#{parent}/a")
  File.rmdir(parent)

  assert created
  try Test.require(repeat)
end

test "rmdir errors on a non-empty directory"
  path = "/tmp/koja_file_test_rmdir_full"
  File.mkdir_p(path)

  try Test.require(File.write("#{path}/occupant.txt", "here"))
  result = File.rmdir(path)
  File.delete("#{path}/occupant.txt")
  File.rmdir(path)

  assert result.err?()
end

test "dir? is false for regular files and missing paths"
  assert not File.dir?("/dev/null")
  assert not File.dir?("/tmp/koja_file_test_missing_dir_99999")
end
