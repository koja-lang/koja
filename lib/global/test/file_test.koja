alias File.Error as FileError
alias File.Mode as FileMode
alias Test.require

test "read /dev/null returns empty string"
  contents = try require(File.read("/dev/null"))
  assert contents.empty?()
end

test "read nonexistent file fails with NotFound"
  match File.read("/tmp/nonexistent_koja_file_test_12345")
    Result.Ok(_) ->
      fail "expected the read to fail"

    Result.Err(file_error: FileError) ->
      match file_error
        FileError.NotFound -> ()
        _ -> fail "expected NotFound, got: #{file_error.message()}"
      end

    Result.Err(e) ->
      fail "expected NotFound, got: #{e}"
  end
end

test "write and read roundtrip"
  path = "/tmp/koja_file_test_write.txt"

  try require(File.write(path, "hello from koja"))
  read = File.read(path)
  File.delete(path)

  contents = try require(read)
  assert contents == "hello from koja"
end

test "open for read on /dev/null returns a descriptor"
  fd = try require(File.open("/dev/null", FileMode.Read))
  try require(fd.close())
end

test "open nonexistent file for read fails with NotFound"
  missing = "/tmp/nonexistent_koja_file_test_12345"

  match File.open(missing, FileMode.Read)
    Result.Ok(_) -> fail "expected the open to fail"
    Result.Err(FileError.NotFound) -> ()
    Result.Err(e) -> fail "expected NotFound, got: #{e.message()}"
  end
end

test "open for write, write through the descriptor, read back"
  path = "/tmp/koja_file_test_handle_write.txt"

  fd = try require(File.open(path, FileMode.Write))
  written = fd.write("handle write")
  _ = fd.close()
  read = File.read(path)
  File.delete(path)

  assert try require(written) == 12
  contents = try require(read)
  assert contents == "handle write"
end

test "open for read, read through the descriptor"
  path = "/tmp/koja_file_test_handle_read.txt"

  try require(File.write(path, "line one\nline two"))
  fd = try require(File.open(path, FileMode.Read))
  first = fd.read_line()
  rest = fd.read_string(64)
  at_end = fd.read(1)
  _ = fd.close()
  File.delete(path)

  assert try require(first) == Option.Some("line one")
  assert try require(rest) == "line two"
  assert try require(at_end) == <<>>
end

test "open for append adds to existing content"
  path = "/tmp/koja_file_test_append.txt"

  try require(File.write(path, "first"))
  opened = File.open(path, FileMode.Append)

  match opened
    Result.Ok(fd) ->
      _ = fd.write(" second")
      _ = fd.close()

    Result.Err(_) ->
      ()
  end

  read = File.read(path)
  File.delete(path)

  try require(opened)
  contents = try require(read)
  assert contents == "first second"
end

test "exists? returns true for /dev/null"
  assert File.exists?("/dev/null")
end

test "exists? returns false for nonexistent file"
  assert not File.exists?("/tmp/nonexistent_koja_file_test_99999")
end

test "delete removes a file"
  path = "/tmp/koja_file_test_delete.txt"

  try require(File.write(path, "delete me"))
  try require(File.delete(path))
  assert not File.exists?(path)
end

test "rename moves a file"
  src = "/tmp/koja_file_test_rename_src.txt"
  dst = "/tmp/koja_file_test_rename_dst.txt"

  try require(File.write(src, "rename me"))
  renamed = File.rename(src, dst)
  src_exists = File.exists?(src)
  read = File.read(dst)
  File.delete(src)
  File.delete(dst)

  try require(renamed)
  assert not src_exists
  contents = try require(read)
  assert contents == "rename me"
end

test "binary write and read preserve arbitrary bytes"
  path = "/tmp/koja_file_test_binary.bin"
  expected: Binary = <<97, 0, 255>>

  try require(File.write(path, expected))
  read = File.read_binary(path)
  File.delete(path)

  actual = try require(read)
  assert actual == expected
end

test "text read fails with InvalidUTF8 on bad bytes"
  path = "/tmp/koja_file_test_invalid_utf8.bin"

  try require(File.write(path, <<255>>))
  result = File.read(path)
  File.delete(path)

  match result
    Result.Ok(_) ->
      fail "expected the read to fail"

    Result.Err(conversion: String.ConversionError) ->
      match conversion
        String.ConversionError.InvalidUTF8 -> ()
      end

    Result.Err(e) ->
      fail "expected InvalidUTF8, got: #{e}"
  end
end

test "mkdir creates a directory that dir? sees and rmdir removes"
  path = "/tmp/koja_file_test_mkdir"
  File.rmdir(path)

  try require(File.mkdir(path))
  created = File.dir?(path)
  removed = File.rmdir(path)

  assert created
  try require(removed)
  assert not File.exists?(path)
end

test "mkdir fails with AlreadyExists when the directory exists"
  path = "/tmp/koja_file_test_mkdir_existing"
  File.mkdir_p(path)

  result = File.mkdir(path)
  File.rmdir(path)

  match result
    Result.Ok(_) -> fail "expected mkdir to fail"
    Result.Err(FileError.AlreadyExists) -> ()
    Result.Err(e) -> fail "expected AlreadyExists, got: #{e.message()}"
  end
end

test "mkdir fails with NotFound when the parent is missing"
  match File.mkdir("/tmp/koja_file_test_no_parent/child")
    Result.Ok(_) -> fail "expected mkdir to fail"
    Result.Err(FileError.NotFound) -> ()
    Result.Err(e) -> fail "expected NotFound, got: #{e.message()}"
  end
end

test "mkdir_p creates missing parents and is idempotent"
  parent = "/tmp/koja_file_test_mkdir_p"
  nested = "#{parent}/a/b"

  try require(File.mkdir_p(nested))
  repeat = File.mkdir_p(nested)
  created = File.dir?(nested)
  File.rmdir(nested)
  File.rmdir("#{parent}/a")
  File.rmdir(parent)

  assert created
  try require(repeat)
end

test "rmdir fails with DirectoryNotEmpty on a non-empty directory"
  path = "/tmp/koja_file_test_rmdir_full"
  File.mkdir_p(path)

  try require(File.write("#{path}/occupant.txt", "here"))
  result = File.rmdir(path)
  File.delete("#{path}/occupant.txt")
  File.rmdir(path)

  match result
    Result.Ok(_) -> fail "expected rmdir to fail"
    Result.Err(FileError.DirectoryNotEmpty) -> ()
    Result.Err(e) -> fail "expected DirectoryNotEmpty, got: #{e.message()}"
  end
end

test "dir? is false for regular files and missing paths"
  assert not File.dir?("/dev/null")
  assert not File.dir?("/tmp/koja_file_test_missing_dir_99999")
end
