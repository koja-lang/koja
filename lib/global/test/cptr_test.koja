struct CPtrTest
  @test "null pointer is null"
  fn test_null -> Result<Bool, String>
    null_ptr: CPtr<Int32> = CPtr.null()

    unless null_ptr.null?()
      return Result.Err("expected null")
    end

    Result.Ok(true)
  end

  @test "alloc, write, read"
  fn test_alloc_write_read -> Result<Bool, String>
    ptr: CPtr<Int32> = CPtr.alloc(3)

    if ptr.null?()
      return Result.Err("alloc returned null")
    end

    ptr.write(42)

    unless ptr.read() == 42
      return Result.Err("expected 42")
    end

    ptr.free()
    Result.Ok(true)
  end

  @test "offset write and read"
  fn test_offset -> Result<Bool, String>
    ptr: CPtr<Int32> = CPtr.alloc(3)
    ptr.write(42)
    ptr.offset(1).write(100)
    ptr.offset(2).write(200)

    unless ptr.offset(1).read() == 100
      return Result.Err("expected 100 at offset 1")
    end

    unless ptr.offset(2).read() == 200
      return Result.Err("expected 200 at offset 2")
    end

    unless ptr.read() == 42
      return Result.Err("first element should be unchanged")
    end

    ptr.free()
    Result.Ok(true)
  end

  @test "overwrite and verify"
  fn test_overwrite -> Result<Bool, String>
    ptr: CPtr<Int32> = CPtr.alloc(1)
    ptr.write(42)
    ptr.write(99)

    unless ptr.read() == 99
      return Result.Err("expected 99 after overwrite")
    end

    ptr.free()
    Result.Ok(true)
  end

  @test "Float pointer"
  fn test_float -> Result<Bool, String>
    ptr: CPtr<Float> = CPtr.alloc(1)
    ptr.write(3.14)

    unless ptr.read() == 3.14
      return Result.Err("expected 3.14")
    end

    ptr.free()
    Result.Ok(true)
  end

  @test "UInt8 pointer"
  fn test_uint8 -> Result<Bool, String>
    byte_ptr: CPtr<UInt8> = CPtr.alloc(2)
    byte_ptr.write(65)
    byte_ptr.offset(1).write(0)

    unless byte_ptr.read() == 65
      return Result.Err("expected 65")
    end

    unless byte_ptr.offset(1).read() == 0
      return Result.Err("expected 0")
    end

    byte_ptr.free()
    Result.Ok(true)
  end

  @test "address of null is zero"
  fn test_null_address -> Result<Bool, String>
    null_ptr: CPtr<Int32> = CPtr.null()

    unless null_ptr.address() == 0
      return Result.Err("expected address 0 for null")
    end

    Result.Ok(true)
  end

  @test "address tracks element-width offsets"
  fn test_offset_address -> Result<Bool, String>
    ptr: CPtr<Int32> = CPtr.alloc(2)
    base = ptr.address()
    stepped = ptr.offset(1).address()
    ptr.free()

    unless base > 0
      return Result.Err("expected a non-zero base address")
    end

    unless stepped == base + 4
      return Result.Err("expected offset(1) to step 4 bytes")
    end

    Result.Ok(true)
  end

  @test "format renders the address in lowercase hex"
  fn test_format -> Result<Bool, String>
    null_ptr: CPtr<Int32> = CPtr.null()

    unless null_ptr.format() == "CPtr(0x0)"
      return Result.Err("expected CPtr(0x0), got #{null_ptr.format()}")
    end

    ptr: CPtr<Int32> = CPtr.alloc(1)
    rendered = ptr.format()
    ptr.free()

    unless rendered.starts_with?("CPtr(0x") and rendered.ends_with?(")")
      return Result.Err("unexpected shape #{rendered}")
    end

    digits = rendered.slice(Range{start: 7, stop: rendered.length() - 2})

    unless digits.length() > 0
      return Result.Err("expected at least one hex digit")
    end

    for c in digits
      unless "0123456789abcdef".contains?(c)
        return Result.Err("non-hex digit #{c} in #{rendered}")
      end
    end

    Result.Ok(true)
  end
end
