test "and"
  assert true and true
  assert not (true and false)
  assert not (false and true)
  assert not (false and false)
end

test "or"
  assert true or true
  assert true or false
  assert false or true
  assert not (false or false)
end

test "logical operators short-circuit"
  assert not (false and panic_bool())
  assert true or panic_bool()
end

test "not"
  assert true != false
  assert false != true
end

test "combined logical expressions"
  assert true and not false == true
  assert not (not true or false)
end

priv fn panic_bool -> Bool
  Kernel.panic("short-circuited expression ran")
end
