impl Debug for Option<T>
  @doc """
  Renders `Option.Some(v)` as `Some(<v.format()>)` and
  `Option.None` as `None`.
  """
  fn format(self) -> String
    match self
      Option.Some(value) -> "Some(" <> value.format() <> ")"
      Option.None -> "None"
    end
  end
end

impl Debug for Result<T, E>
  @doc """
  Renders `Result.Ok(v)` as `Ok(<v.format()>)` and
  `Result.Err(e)` as `Err(<e.format()>)`.
  """
  fn format(self) -> String
    match self
      Result.Ok(value) -> "Ok(" <> value.format() <> ")"
      Result.Err(error) -> "Err(" <> error.format() <> ")"
    end
  end
end

impl Debug for List<T>
  @doc """
  Renders the list as `[a, b, c]`, with each element rendered through
  its own `Debug.format`. Empty lists render as `[]`.
  """
  fn format(self) -> String
    result = "["
    first = true

    for item in self
      if first
        result = result <> item.format()
        first = false
      else
        result = result <> ", " <> item.format()
      end
    end

    result <> "]"
  end
end

impl Debug for Map<K, V>
  @doc """
  Renders the map as `[key: value, ...]`.
  Entry order is unspecified.
  """
  fn format(self) -> String
    result = "["
    first = true

    for (key, value) in self
      unless first
        result = result <> ", "
      end

      result = result <> key.format() <> ": " <> value.format()
      first = false
    end

    result <> "]"
  end
end

impl Debug for Set<T>
  @doc """
  Renders the set as `[value, ...]`.
  Element order is unspecified.
  """
  fn format(self) -> String
    result = "["
    first = true

    for item in self
      unless first
        result = result <> ", "
      end

      result = result <> item.format()
      first = false
    end

    result <> "]"
  end
end
