@doc """
Readiness notification delivered to the mailbox of the process that
called `Fd.watch` once the descriptor becomes ready. Infrastructure
processes like `TCPServer` handle it, and most user code handles the
higher-level events they produce, like `TCPServer.Event`, instead.
"""
enum IO.Ready
  Read(Fd)
  Write(Fd)
  Error(Fd)
end

@doc """
The standard error file descriptor.
"""
const STDERR: Fd = Fd{descriptor: 2}

@doc """
The standard input file descriptor.
"""
const STDIN: Fd = Fd{descriptor: 0}

@doc """
The standard output file descriptor.
"""
const STDOUT: Fd = Fd{descriptor: 1}

@doc """
The I/O namespace. Its own functions, `IO.puts`, `IO.warn`, `IO.write`,
and `IO.gets`, are the console. The stream protocols `IO.Reader` and
`IO.Writer` and the stream error `IO.Error` nest under it. For
low-level console access, use `STDIN`, `STDOUT`, and `STDERR` directly
as `Fd` values.
"""
struct IO
  @doc """
  Writes a string to stdout followed by a newline.
  """
  fn puts(message: String)
    STDOUT.write(message)
    STDOUT.write("\n")
  end

  @doc """
  Writes a string to stderr followed by a newline.
  """
  fn warn(message: String)
    STDERR.write(message)
    STDERR.write("\n")
  end

  @doc """
  Writes a string to stdout without a trailing newline.
  """
  fn write(message: String)
    STDOUT.write(message)
  end

  @doc """
  Prints a prompt and reads one line from stdin. Returns the line
  without the trailing newline, or `Option.None` when input ended
  before any byte arrived. See `IO.Reader.read_line`.
  """
  fn gets(prompt: String) -> Option<String> ! IO.Error | String.ConversionError
    IO.write(prompt)
    try STDIN.read_line()
  end
end
