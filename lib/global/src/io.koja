@doc """
Generic I/O readiness notification delivered to a process's mailbox
when a watched file descriptor becomes ready. Used by infrastructure
processes like `TCPListener`; most user code handles higher-level
events like `TCPEvent` instead.
"""
enum IO.Ready
  Read(Fd)
  Write(Fd)
  Error(Fd)
end

@doc """
The standard error file descriptor.
"""
const STDERR: Fd = Fd{descriptor: 2}

@doc """
The standard input file descriptor.
"""
const STDIN: Fd = Fd{descriptor: 0}

@doc """
The standard output file descriptor.
"""
const STDOUT: Fd = Fd{descriptor: 1}

@doc """
Standard I/O operations.

Provides `IO.puts`, `IO.warn`, `IO.write`, and `IO.gets` for common
console I/O. For low-level access, use `STDIN`, `STDOUT`, and `STDERR`
directly as `Fd` values.
"""
struct IO
  @doc """
  Writes a string to stdout followed by a newline.
  """
  fn puts(message: String)
    STDOUT.write(message)
    STDOUT.write("\n")
  end

  @doc """
  Writes a string to stderr followed by a newline.
  """
  fn warn(message: String)
    STDERR.write(message)
    STDERR.write("\n")
  end

  @doc """
  Writes a string to stdout without a trailing newline.
  """
  fn write(message: String)
    STDOUT.write(message)
  end

  @doc """
  Prints a prompt and reads a line from stdin (up to the newline).
  Returns the line without the trailing newline character. At end of
  input, returns the partial line read so far, which is `""` when no
  input remains. Panics when the line is not valid UTF-8.
  """
  fn gets(prompt: String) -> String
    IO.write(prompt)
    line = IO.gets_loop(<<>>)
    line.to_string()
      rescue _ -> Kernel.panic("IO.gets: input is not valid UTF-8")
  end

  # Bytes accumulate raw and decode once per line, since a multi-byte
  # character split across single-byte reads is not valid UTF-8 on its
  # own. An empty read is end of stream, not an empty line, so it ends
  # the line instead of recursing forever.
  priv fn gets_loop(acc: Binary) -> Binary
    match STDIN.read_binary(1)
      Result.Ok(byte) ->
        if byte == <<>> or byte == <<10>>
          acc
        else
          IO.gets_loop(acc <> byte)
        end

      Result.Err(_) ->
        acc
    end
  end
end
