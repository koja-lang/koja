@doc """
The development format. One line per record with the UTC time, the
level, the message, and then each attribute as `key=value`.

```
2026-09-23T20:00:00.123456Z INFO swept 12 rows job=cleaner
```
"""
@experimental
struct Log.Text: Log.Formatter<String>
  fn format_log(self, record: Log.Record) -> String
    time = DateTime{timestamp: record.timestamp, zone: TimeZone.UTC}
    line = "#{time.to_string()} #{record.level.to_string()} #{record.message}"

    for (key, value) in record.attributes
      line = line <> " #{key}=#{value.to_string()}"
    end

    line
  end
end
