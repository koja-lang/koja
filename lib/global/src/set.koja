@doc """
A generic hash set of unique elements of type `T`.
Elements must implement `Hash` and `Equality`. Uses open addressing
with linear probing.
"""
builtin Set<T>
  @doc """
  Returns `true` if the set contains no elements.
  """
  @intrinsic
  fn empty?(self) -> Bool

  @doc """
  Returns `true` if the set contains the given item.
  """
  @intrinsic
  fn has?(self, item: T) -> Bool

  @doc """
  Adds the given item to the set and returns the updated set.
  If the item is already present, the set is returned unchanged.
  """
  @intrinsic
  fn insert(self, item: T) -> Set<T>

  @doc """
  Returns the number of elements in the set.
  """
  @intrinsic
  fn length(self) -> Int

  @doc """
  Creates a new empty set with an initial capacity of 8.
  """
  @intrinsic
  fn new -> Set<T>

  @doc """
  Removes the given item from the set and returns the updated set.
  If the item is not present, the set is returned unchanged.
  """
  @intrinsic
  fn remove(self, item: T) -> Set<T>
end

impl Enumeration<T, Int> for Set<T>
  @doc """
  Returns the opaque cursor for the first set element.
  """
  fn cursor(self) -> Int
    0
  end

  @doc """
  Returns the element at or after the cursor and the next cursor.
  Iteration order is unspecified.
  """
  @intrinsic
  fn next(self, cursor: Int) -> Option<(T, Int)>
end

impl Equality for Set<T: Equality>
  @doc """
  Returns `true` if both sets contain the same elements.
  """
  fn equals?(self, other: Self) -> Bool
    if self.length() != other.length()
      return false
    end

    for item in self
      unless other.has?(item)
        return false
      end
    end

    true
  end
end

impl ListLiteral<T> for Set<T>
  @doc """
  Constructs a set from a list literal by inserting each element,
  naturally deduplicating.
  """
  @intrinsic
  fn from_list(list: List<T>) -> Self
end
