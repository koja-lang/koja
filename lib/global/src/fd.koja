alias File.Mode as FileMode

@doc """
Raw file descriptor for I/O operations.
"""
struct Fd
  descriptor: Int32

  @doc """
  Suspends the current process until this file descriptor is ready.
  Pass `true` to wait for readable, `false` to wait for writable.
  Returns when the I/O reactor detects readiness.
  """
  fn block(self, readable: Bool)
    koja_io_block(self.descriptor, readable ? 1 : 0)
  end

  @doc """
  Closes the file descriptor.
  """
  fn close(self) -> String ! String
    if koja_fd_close(self.descriptor) != 0
      fail "close failed"
    end

    ""
  end

  @doc """
  Reads up to `count` bytes from the file descriptor.
  Returns the data read as a string, or an error message.
  """
  fn read(self, count: Int) -> String ! String
    bytes = try self.read_binary(count)
    bytes.to_string() rescue _ -> fail "read data is not valid UTF-8"
  end

  @doc """
  Reads up to `count` bytes from the file descriptor as raw bytes.
  Unlike `read`, this does not assume the data is UTF-8 text, making it
  suitable for binary wire protocols. Returns the bytes read, or an
  error message.
  """
  fn read_binary(self, count: Int) -> Binary ! String
    ptr = koja_fd_read(self.descriptor, count)

    if ptr.null?()
      fail "read failed"
    end

    RuntimeBlock.adopt_binary(ptr)
  end

  @doc """
  Removes this file descriptor from I/O readiness monitoring.
  No further `IOReady` messages will be delivered for this fd.
  """
  fn unwatch(self)
    koja_rt_unwatch_fd(self.descriptor)
  end

  @doc """
  Registers this file descriptor for I/O readiness notifications.
  When the fd becomes ready, an `IOReady` message is delivered to
  the current process's mailbox. Uses oneshot mode: after one event
  fires, `watch` must be called again to re-register.

  Interest: 0 = readable, 1 = writable.
  """
  fn watch(self, interest: Int)
    koja_rt_watch_fd(self.descriptor, interest)
  end

  @doc """
  Writes data to the file descriptor. Accepts either a `String` (encoded
  as UTF-8) or a `Binary` for raw wire protocols, so non-UTF-8 frames pass
  through unaltered. Returns the number of bytes written, or an error.
  """
  fn write(self, data: Binary | String) -> Int ! String
    bytes =
      match data
        b: Binary -> b
        s: String -> s.to_binary()
      end

    result = koja_fd_write(
      self.descriptor,
      CPtr.borrow(bytes),
      bytes.byte_size(),
    )

    if result < 0
      fail "write failed"
    end

    result
  end

  @extern "C"
  priv fn koja_fd_close(fd: Int32) -> Int32

  @extern "C"
  priv fn koja_fd_read(fd: Int32, count: Int64) -> CPtr<UInt8>

  @extern "C"
  priv fn koja_fd_write(fd: Int32, data: CPtr<UInt8>, len: Int64) -> Int64

  @extern "C"
  priv fn koja_io_block(fd: Int32, readable: Int64)

  @extern "C"
  priv fn koja_rt_unwatch_fd(fd: Int32)

  @extern "C"
  priv fn koja_rt_watch_fd(fd: Int32, interest: Int64)
end

@doc """
The mode used when opening a file: `Read`, `Write`, or `Append`.
"""
enum File.Mode
  Read
  Write
  Append
end

@doc """
A file handle backed by a file descriptor.
"""
struct File
  fd: Fd

  @doc """
  Closes the file handle.
  """
  fn close(self) -> String ! String
    try self.fd.close()
  end

  @doc """
  Deletes the file at the given path.
  Returns "ok" on success or an error message.
  """
  fn delete(path: String) -> String ! String
    cs = try path_cstring(path)
    result = koja_file_delete(cs.ptr)
    cs.free()

    if result < 0
      fail "delete failed"
    end

    "ok"
  end

  @doc """
  Returns true if the given path exists and is a directory. `exists?`
  is true for files and directories alike, while `dir?` distinguishes them.
  """
  fn dir?(path: String) -> Bool
    cs =
      match path_cstring(path)
        Result.Err(_) -> return false
        Result.Ok(value) -> value
      end

    result = koja_file_is_dir(cs.ptr)
    cs.free()
    result == 1
  end

  @doc """
  Returns true if a file or directory exists at the given path.
  """
  fn exists?(path: String) -> Bool
    cs =
      match path_cstring(path)
        Result.Err(_) -> return false
        Result.Ok(value) -> value
      end

    result = koja_file_exists(cs.ptr)
    cs.free()
    result == 1
  end

  @doc """
  Creates a single directory. Errors if the parent directory is missing
  or the path already exists. See `mkdir_p` for the recursive variant.
  Returns "ok" on success or an error message.
  """
  fn mkdir(path: String) -> String ! String
    cs = try path_cstring(path)
    result = koja_file_mkdir(cs.ptr)
    cs.free()

    if result < 0
      fail "mkdir failed"
    end

    "ok"
  end

  @doc """
  Creates a directory along with any missing parents (like `mkdir -p`).
  Succeeds if the directory already exists.
  Returns "ok" on success or an error message.
  """
  fn mkdir_p(path: String) -> String ! String
    cs = try path_cstring(path)
    result = koja_file_mkdir_p(cs.ptr)
    cs.free()

    if result < 0
      fail "mkdir_p failed"
    end

    "ok"
  end

  @doc """
  Opens a file with the given mode. Returns a File handle or an error message.

  Modes:
  - FileMode.Read    — open for reading (file must exist)
  - FileMode.Write   — open for writing (create/truncate)
  - FileMode.Append  — open for appending (create if needed)
  """
  fn open(path: String, mode: FileMode) -> File ! String
    mode_int =
      match mode
        FileMode.Read -> 0
        FileMode.Write -> 1
        FileMode.Append -> 2
      end

    cs = try path_cstring(path)
    fd = koja_file_open(cs.ptr, mode_int)
    cs.free()

    if fd < 0
      fail "open failed"
    end

    File{fd: Fd{descriptor: fd}}
  end

  @doc """
  Reads the entire contents of a file at the given path as a string.
  This is a convenience method that opens, reads, and closes the file.
  Returns the file contents or an error message.
  """
  fn read(path: String) -> String ! String
    bytes = try File.read_binary(path)
    bytes.to_string() rescue _ -> fail "file is not valid UTF-8"
  end

  @doc """
  Reads the entire contents of a file at the given path as raw bytes.
  """
  fn read_binary(path: String) -> Binary ! String
    cs = try path_cstring(path)
    ptr = koja_file_read_all(cs.ptr)
    cs.free()

    if ptr.null?()
      fail "read failed"
    end

    RuntimeBlock.adopt_binary(ptr)
  end

  @doc """
  Renames (moves) a file from source to destination.
  Returns "ok" on success or an error message.
  """
  fn rename(source: String, destination: String) -> String ! String
    src_cs = try path_cstring(source)

    dst_cs =
      match path_cstring(destination)
        Result.Err(error) ->
          src_cs.free()
          fail error

        Result.Ok(value) ->
          value
      end

    result = koja_file_rename(src_cs.ptr, dst_cs.ptr)
    src_cs.free()
    dst_cs.free()

    if result < 0
      fail "rename failed"
    end

    "ok"
  end

  @doc """
  Removes an empty directory. Errors if the directory is not empty.
  See `delete` for removing files.
  Returns "ok" on success or an error message.
  """
  fn rmdir(path: String) -> String ! String
    cs = try path_cstring(path)
    result = koja_file_rmdir(cs.ptr)
    cs.free()

    if result < 0
      fail "rmdir failed"
    end

    "ok"
  end

  @doc """
  Writes text or raw bytes to the given path, creating or truncating it.
  Returns "ok" on success or an error message.
  """
  fn write(path: String, content: Binary | String) -> String ! String
    path_cs = try path_cstring(path)

    bytes =
      match content
        binary: Binary -> binary
        string: String -> string.to_binary()
      end

    result = koja_file_write_all(
      path_cs.ptr,
      CPtr.borrow(bytes),
      bytes.byte_size(),
    )
    path_cs.free()

    if result < 0
      fail "write failed"
    end

    "ok"
  end

  priv fn path_cstring(path: String) -> CString ! String
    path.to_cstring() rescue _ -> fail "path contains an interior NUL"
  end

  @extern "C"
  priv fn koja_file_delete(path: CPtr<UInt8>) -> Int64

  @extern "C"
  priv fn koja_file_exists(path: CPtr<UInt8>) -> Int64

  @extern "C"
  priv fn koja_file_is_dir(path: CPtr<UInt8>) -> Int64

  @extern "C"
  priv fn koja_file_mkdir(path: CPtr<UInt8>) -> Int64

  @extern "C"
  priv fn koja_file_mkdir_p(path: CPtr<UInt8>) -> Int64

  @extern "C"
  priv fn koja_file_open(path: CPtr<UInt8>, mode: Int64) -> Int32

  @extern "C"
  priv fn koja_file_read_all(path: CPtr<UInt8>) -> CPtr<UInt8>

  @extern "C"
  priv fn koja_file_rename(src: CPtr<UInt8>, dst: CPtr<UInt8>) -> Int64

  @extern "C"
  priv fn koja_file_rmdir(path: CPtr<UInt8>) -> Int64

  @extern "C"
  priv fn koja_file_write_all(
    path: CPtr<UInt8>,
    content: CPtr<UInt8>,
    length: Int64,
  ) -> Int64
end
