alias IO.Error as IOError
alias IO.Reader.Options as ReaderOptions
alias IO.Writer.Options as WriterOptions

@doc """
An open file descriptor. `File.open` returns one for a file, `STDIN`,
`STDOUT`, and `STDERR` name the standard streams, and the socket types
wrap one. Reads and writes come from the `IO.Reader` and `IO.Writer`
conformances below, and every operation on an open descriptor fails
with `IO.Error`.
"""
struct Fd
  descriptor: Int32

  @doc """
  Suspends the current process until this file descriptor is ready or
  `timeout` passes. Pass `true` to wait for readable, `false` to wait for
  writable. Returns `true` when the wait ended on the timeout, `false`
  when the I/O reactor detected readiness.
  """
  fn block(self, readable: Bool, timeout: Option<Duration> = Option.None)
    -> Bool

    koja_io_block(self.descriptor, readable ? 1 : 0, timeout_ms(timeout)) == 1
  end

  @doc """
  Closes the file descriptor.
  """
  fn close(self) ! IOError
    if koja_fd_close(self.descriptor) != 0
      fail IOError.last()
    end
  end

  @doc """
  Removes this file descriptor from I/O readiness monitoring.
  No further `IOReady` messages will be delivered for this fd.
  """
  fn unwatch(self)
    koja_rt_unwatch_fd(self.descriptor)
  end

  @doc """
  Registers this file descriptor for I/O readiness notifications.
  When the fd becomes ready, an `IOReady` message is delivered to
  the current process's mailbox. Uses oneshot mode: after one event
  fires, `watch` must be called again to re-register.

  Interest: 0 = readable, 1 = writable.
  """
  fn watch(self, interest: Int)
    koja_rt_watch_fd(self.descriptor, interest)
  end

  priv fn timeout_ms(timeout: Option<Duration>) -> Int
    match timeout
      Option.None -> -1
      Option.Some(duration) -> duration.to_milliseconds()
    end
  end

  @extern "C"
  priv fn koja_fd_close(fd: Int32) -> Int32

  @extern "C"
  priv fn koja_fd_read(fd: Int32, count: Int64, timeout_ms: Int64)
    -> CPtr<UInt8>

  @extern "C"
  priv fn koja_fd_write(
    fd: Int32,
    data: CPtr<UInt8>,
    len: Int64,
    timeout_ms: Int64,
  ) -> Int64

  @extern "C"
  priv fn koja_io_block(fd: Int32, readable: Int64, timeout_ms: Int64) -> Int64

  @extern "C"
  priv fn koja_rt_unwatch_fd(fd: Int32)

  @extern "C"
  priv fn koja_rt_watch_fd(fd: Int32, interest: Int64)
end

impl IO.Reader<IOError> for Fd
  @doc """
  Reads up to `count` bytes from the file descriptor. Returns an empty
  binary at end of stream. With `options.timeout` set, the read fails
  with `IO.Error.TimedOut` once that much time passes with no data.
  """
  fn read(self, count: Int, options: ReaderOptions) -> Binary ! IOError
    ptr = Fd.koja_fd_read(
      self.descriptor,
      count,
      Fd.timeout_ms(options.timeout),
    )

    if ptr.null?()
      fail IOError.last()
    end

    RuntimeBlock.adopt_binary(ptr)
  end
end

impl IO.Writer<IOError> for Fd
  @doc """
  Writes `data` to the file descriptor and returns the number of bytes
  written. With `options.timeout` set, the write fails with
  `IO.Error.TimedOut` once that much time passes with the descriptor
  still not writable.
  """
  fn write(self, data: Binary | String, options: WriterOptions) -> Int ! IOError
    bytes =
      match data
        b: Binary -> b
        s: String -> s.to_binary()
      end

    result = Fd.koja_fd_write(
      self.descriptor,
      CPtr.borrow(bytes),
      bytes.byte_size(),
      Fd.timeout_ms(options.timeout),
    )

    if result < 0
      fail IOError.last()
    end

    result
  end
end
