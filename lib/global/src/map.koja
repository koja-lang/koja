@doc """
A generic hash map from keys of type `K` to values of type `V`.
Keys must implement `Hash` and `Equality`. Uses open addressing
with linear probing.
"""
builtin Map<K, V>
end

impl Enumeration<(K, V), Int> for Map<K, V>
  @doc """
  Returns the opaque cursor for the first map entry.
  """
  fn cursor(self) -> Int
    0
  end

  @doc """
  Returns the entry at or after the cursor and the next cursor.
  Iteration order is unspecified.
  """
  @intrinsic
  fn next(self, cursor: Int) -> Option<((K, V), Int)>
end

impl Equality for Map<K: Equality, V: Equality>
  @doc """
  Returns `true` if both maps contain equal values for the same keys.
  """
  fn equals?(self, other: Self) -> Bool
    if self.length() != other.length()
      return false
    end

    for (key, value) in self
      match other.get(key)
        Option.Some(other_value) ->
          unless value.equals?(other_value)
            return false
          end

        Option.None ->
          return false
      end
    end

    true
  end
end

extend Map<K, V>
  @doc """
  Returns `true` if the map contains no entries.
  """
  @intrinsic
  fn empty?(self) -> Bool

  @doc """
  Returns `Option.Some(value)` if the key exists, or `Option.None` otherwise.
  """
  @intrinsic
  fn get(self, key: K) -> Option<V>

  @doc """
  Returns `true` if the map contains the given key.
  """
  @intrinsic
  fn has?(self, key: K) -> Bool

  @doc """
  Returns the number of entries in the map.
  """
  @intrinsic
  fn length(self) -> Int

  @doc """
  Creates a new empty map with an initial capacity of 8.
  """
  @intrinsic
  fn new -> Map<K, V>

  @doc """
  Inserts or updates the given key-value pair and returns the updated map.
  """
  @intrinsic
  fn put(self, key: K, value: V) -> Map<K, V>

  @doc """
  Removes the entry for the given key and returns the updated map.
  If the key is not present, the map is returned unchanged.
  """
  @intrinsic
  fn remove(self, key: K) -> Map<K, V>
end

@doc """
A protocol for types that can be constructed from a map literal
`[key: value, ...]`. The compiler builds a `Map<K, V>` and passes it
to `from_map`.
"""
protocol MapLiteral<K, V>
  fn from_map(map: Map<K, V>) -> Self
end

impl MapLiteral<K, V> for Map<K, V>
  @doc """
  Returns the map unchanged. `Map<K, V>` is the default type for map literals.
  """
  @intrinsic
  fn from_map(map: Map<K, V>) -> Self
end
