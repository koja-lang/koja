@doc """
An arbitrary byte sequence.
"""
builtin Binary
end

@doc """
An arbitrary bit sequence, not necessarily byte-aligned.
"""
builtin Bits
end

@doc """
A boolean value, `true` or `false`.
"""
builtin Bool
end

@doc """
The type of expressions that never produce a value, such as `Kernel.panic`.
"""
builtin Never
end

@doc """
The empty value, returned by functions with no declared return type.
"""
builtin Unit
end

@doc """
Core runtime operations.
"""
struct Kernel
  @doc """
  Terminates the process immediately with the given exit code.
  Code 0 indicates success, and any non-zero value indicates failure.
  Never returns.
  """
  fn exit(code: Int)
    koja_kernel_exit(code)
  end

  @doc """
  Aborts the process with the given message and a symbolicated stack
  trace. Never returns.
  """
  @intrinsic
  fn panic(message: String)

  @extern "C"
  priv fn koja_kernel_exit(code: Int64)
end

@doc """
An inclusive range from `start` to `stop`. Both endpoints are included.
"""
struct Range
  start: Int
  stop: Int
end

@doc """
A finite source that can be iterated with `for`.
The source stays unchanged while a separate cursor advances.
"""
protocol Enumeration<T, Cursor>
  fn cursor(self) -> Cursor

  fn next(self, cursor: Cursor) -> Option<(T, Cursor)>
end

impl Enumeration<Int, Option<Int>> for Range
  @doc """
  Returns the first range value, or `None` for an empty range.
  """
  fn cursor(self) -> Option<Int>
    self.start > self.stop ? Option.None : Option.Some(self.start)
  end

  @doc """
  Returns the current range value and the next cursor.
  """
  fn next(self, cursor: Option<Int>) -> Option<(Int, Option<Int>)>
    match cursor
      Option.Some(current) when current < self.start or current > self.stop ->
        Option.None

      Option.Some(current) ->
        next_cursor: Option<Int> = current == self.stop
          ? Option.None
          : Option.Some(current + 1)

        Option.Some((current, next_cursor))

      Option.None ->
        Option.None
    end
  end
end

@doc """
A protocol for types that support equality comparison.
"""
protocol Equality
  fn equals?(self, other: Self) -> Bool
end

impl Equality for Bool
  @doc """
  Returns `true` if both boolean values are the same.
  """
  @intrinsic
  fn equals?(self, other: Bool) -> Bool
end

@doc """
A protocol for types that can produce a hash value for use in
hash-based collections like `Map<K, V>` and `Set<T>`.
"""
protocol Hash
  fn hash(self) -> Int
end

impl Hash for Bool
  @doc """
  Returns `0` for `false` and `1` for `true`.
  """
  @intrinsic
  fn hash(self) -> Int
end

@doc """
Why arbitrary bytes could not be decoded as a Koja `String`.
"""
enum String.ConversionError
  InvalidUTF8
end

extend Binary
  @doc """
  Returns the byte at `index` as an `Int` in `0..255`, or
  `Option.None` when `index` is out of bounds. O(1).
  """
  @intrinsic
  fn at(self, index: Int) -> Option<Int>

  @doc """
  Returns the number of bytes in the binary.
  """
  @intrinsic
  fn byte_size(self) -> Int

  @doc """
  Returns a new binary spanning the inclusive byte range
  `[range.start, range.stop]`. Endpoints clamp to the binary's bounds.
  """
  @intrinsic
  fn slice(self, range: Range) -> Binary

  @doc """
  Converts a `Binary` to `Bits`. This is a zero-cost widening conversion:
  every byte-aligned binary is also a valid bitstring.
  """
  @intrinsic
  fn to_bits(self) -> Bits

  @doc """
  Attempts to interpret the binary as a UTF-8 string. Returns the
  string if the bytes are valid UTF-8, or fails with `InvalidUTF8`.
  """
  @intrinsic
  fn to_string(self) -> String ! String.ConversionError
end

impl Equality for Binary
  @doc """
  Returns `true` when both binaries have the same length and bytes.
  """
  @intrinsic
  fn equals?(self, other: Binary) -> Bool
end

impl Hash for Binary
  @doc """
  Returns an FNV-1a hash over the binary's bytes, so `Binary` values
  can key a `Map` or populate a `Set`.
  """
  @intrinsic
  fn hash(self) -> Int
end

extend Bits
  @doc """
  Returns the number of bits in the bitstring.
  """
  @intrinsic
  fn bit_size(self) -> Int

  @doc """
  Returns storage byte `index` as an `Int` in `0..255`, or
  `Option.None` when `index` is out of bounds. Bytes hold bits
  MSB-first, and the trailing bits of the last byte are zero. The
  bitstring occupies `ceil(bit_size / 8)` bytes. O(1).
  """
  @intrinsic
  fn byte_at(self, index: Int) -> Option<Int>

  @doc """
  Attempts to narrow a `Bits` value to `Binary`. Returns the binary if
  the bit length is byte-aligned (divisible by 8), or fails with a
  diagnostic message.
  """
  @intrinsic
  fn to_binary(self) -> Binary ! String
end

impl Equality for Bits
  @doc """
  Returns `true` when both bitstrings have the same bit length and
  bits. Storage bytes compare directly because the trailing bits of
  the last byte are always zero.
  """
  fn equals?(self, other: Bits) -> Bool
    size = self.bit_size()

    if size != other.bit_size()
      return false
    end

    bytes = (size + 7) / 8
    i = 0

    while i < bytes
      if self.byte_at(i).or(0) != other.byte_at(i).or(0)
        return false
      end

      i += 1
    end

    true
  end
end

impl Hash for Bits
  @doc """
  Returns an xorshift-mixed hash over the storage bytes, seeded with
  the bit length so equal bytes at different lengths hash apart. Lets
  `Bits` values key a `Map` or populate a `Set`.
  """
  fn hash(self) -> Int
    size = self.bit_size()
    bytes = (size + 7) / 8
    h = size
    i = 0

    while i < bytes
      h = h.bxor(self.byte_at(i).or(0))
      h = h.bxor(h.bsl(13))
      h = h.bxor(h.bsr(7))
      h = h.bxor(h.bsl(17))
      i += 1
    end

    h
  end
end
