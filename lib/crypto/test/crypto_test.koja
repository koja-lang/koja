  assert d.byte_size() == 64
end

test "SHA512 streaming matches one-shot"
  d1 = SHA512.digest("hello".to_binary())
  ctx = SHA512.new()
  ctx = ctx.update("hel".to_binary())
  ctx = ctx.update("lo".to_binary())
  d2 = ctx.finalize()

