test "SHA1 one-shot digest"
  d = SHA1.digest("hello".to_binary())
  assert d.byte_size() == 20
end

test "SHA1 streaming matches one-shot"
  d1 = SHA1.digest("hello".to_binary())
  ctx = SHA1.new()
  ctx = ctx.update("hel".to_binary())
  ctx = ctx.update("lo".to_binary())
  d2 = ctx.finalize()

  assert d1.byte_size() == d2.byte_size()
  assert CPtr.borrow(d1).read() == CPtr.borrow(d2).read()
end

test "SHA1 empty input"
  d = SHA1.digest("".to_binary())
  assert d.byte_size() == 20
end

test "SHA256 one-shot digest"
  d = SHA256.digest("hello".to_binary())
  assert d.byte_size() == 32
end

test "SHA256 streaming matches one-shot"
  d1 = SHA256.digest("hello".to_binary())
  ctx = SHA256.new()
  ctx = ctx.update("hel".to_binary())
  ctx = ctx.update("lo".to_binary())
  d2 = ctx.finalize()

  assert CPtr.borrow(d1).read() == CPtr.borrow(d2).read()
end

test "SHA256 empty input"
  d = SHA256.digest("".to_binary())
  assert d.byte_size() == 32
end

test "SHA384 empty input"
  d = SHA384.digest("".to_binary())
  assert d.byte_size() == 48
end

test "SHA384 one-shot digest"
  d = SHA384.digest("hello".to_binary())
  assert d.byte_size() == 48
end

test "SHA384 streaming matches one-shot"
  d1 = SHA384.digest("hello".to_binary())
  ctx = SHA384.new()
  ctx = ctx.update("hel".to_binary())
