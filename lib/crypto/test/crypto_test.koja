struct HMACTest
  @test "HMAC-SHA1 produces 20 bytes"
  fn test_hmac_sha1 ! String
    mac = HMAC.sha1("secret".to_binary(), "hello".to_binary())

    if mac.byte_size() != 20
      fail "expected 20 bytes, got #{mac.byte_size()}"
    end
  end

  @test "HMAC-SHA256 produces 32 bytes"
  fn test_hmac_sha256 ! String
    mac = HMAC.sha256("secret".to_binary(), "hello".to_binary())

    if mac.byte_size() != 32
      fail "expected 32 bytes, got #{mac.byte_size()}"
    end
  end

  @test "HMAC-SHA384 produces 48 bytes"
  fn test_hmac_sha384 ! String
    mac = HMAC.sha384("secret".to_binary(), "hello".to_binary())

    if mac.byte_size() != 48
      fail "expected 48 bytes, got #{mac.byte_size()}"
    end
  end

  @test "HMAC-SHA512 produces 64 bytes"
  fn test_hmac_sha512 ! String
    mac = HMAC.sha512("secret".to_binary(), "hello".to_binary())

    if mac.byte_size() != 64
      fail "expected 64 bytes, got #{mac.byte_size()}"
    end
  end
end
