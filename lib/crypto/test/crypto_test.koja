struct SHA1Test
  @test "SHA1 one-shot digest"
  fn test_digest ! String
    d = SHA1.digest("hello".to_binary())

    if d.byte_size() != 20
      fail "expected 20 bytes, got #{d.byte_size()}"
    end
  end

  @test "SHA1 streaming matches one-shot"
  fn test_streaming ! String
    d1 = SHA1.digest("hello".to_binary())
    ctx = SHA1.new()
    ctx = ctx.update("hel".to_binary())
    ctx = ctx.update("lo".to_binary())
    d2 = ctx.finalize()

    if d1.byte_size() != d2.byte_size()
      fail "size mismatch"
    end

    if CPtr.borrow(d1).read() != CPtr.borrow(d2).read()
      fail "first byte mismatch"
    end
  end

  @test "SHA1 empty input"
  fn test_empty ! String
    d = SHA1.digest("".to_binary())

    if d.byte_size() != 20
      fail "expected 20 bytes for empty input"
    end
  end
end

struct SHA256Test
  @test "SHA256 one-shot digest"
  fn test_digest ! String
    d = SHA256.digest("hello".to_binary())

    if d.byte_size() != 32
      fail "expected 32 bytes, got #{d.byte_size()}"
    end
  end

  @test "SHA256 streaming matches one-shot"
  fn test_streaming ! String
    d1 = SHA256.digest("hello".to_binary())
    ctx = SHA256.new()
    ctx = ctx.update("hel".to_binary())
    ctx = ctx.update("lo".to_binary())
    d2 = ctx.finalize()

    if CPtr.borrow(d1).read() != CPtr.borrow(d2).read()
      fail "first byte mismatch"
    end
  end

  @test "SHA256 empty input"
  fn test_empty ! String
    d = SHA256.digest("".to_binary())

    if d.byte_size() != 32
      fail "expected 32 bytes for empty input"
    end
  end
end

