test "Response.new sets Content-Length and version"
  resp = Response.new(Status.ok(), "hello")

  assert resp.status.code == 200
  assert resp.version == "HTTP/1.1"
  assert resp.headers.get("Content-Length").unwrap() == "5"
  assert resp.body == "hello"
end

test "Request.body_as_binary converts body"
  req = Request{
    body: "test",
    headers: Headers.new(),
    method: Method.Get,
    path: "/",
    version: "HTTP/1.1",
  }
  bin = req.body_as_binary()

  assert bin.byte_size() == 4
end
