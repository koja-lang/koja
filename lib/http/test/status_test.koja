test "Status.ok returns 200"
  s = Status.ok()

  assert s.code == 200
  assert s.reason() == "OK"
end

test "Status.not_found returns 404"
  assert Status.not_found().code == 404
end

test "Status.internal_server_error returns 500"
  assert Status.internal_server_error().code == 500
end

test "Status.new creates a status from its code"
  s = Status.new(503)

  assert s.code == 503
  assert s.reason() == "Service Unavailable"
end

test "Status.reason returns an empty string for an unknown code"
  assert Status.new(418).reason() == ""
  assert Status.new(799).reason() == ""
end

test "Status values with the same code are equal"
  assert Status.new(404) == Status.not_found()
  assert Status.new(404) != Status.ok()
end

test "Status.reason matches each named constructor"
  cases: List<(Status, String)> = [
    (Status.bad_request(), "Bad Request"), (Status.created(), "Created"),
    (Status.forbidden(), "Forbidden"),
    (Status.internal_server_error(), "Internal Server Error"),
    (Status.method_not_allowed(), "Method Not Allowed"),
    (Status.no_content(), "No Content"), (Status.not_found(), "Not Found"),
    (Status.unauthorized(), "Unauthorized")
  ]

  for test_case in cases
    (status, expected) = test_case
    assert status.reason() == expected
  end
end

test "Status.ok? checks 2xx range"
  assert Status.ok().ok?()
  assert Status.created().ok?()
  assert not Status.not_found().ok?()
end

test "Status.redirect? checks 3xx range"
  assert Status.new(301).redirect?()
  assert not Status.ok().redirect?()
end

test "Status.client_error? checks 4xx range"
  assert Status.bad_request().client_error?()
  assert Status.not_found().client_error?()
  assert not Status.ok().client_error?()
end

test "Status.server_error? checks 5xx range"
  assert Status.internal_server_error().server_error?()
  assert not Status.ok().server_error?()
end
