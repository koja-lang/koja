test "Status.ok returns 200"
  s = Status.ok()

  assert s.code == 200
  assert s.reason == "OK"
end

test "Status.not_found returns 404"
  assert Status.not_found().code == 404
end

test "Status.internal_server_error returns 500"
  assert Status.internal_server_error().code == 500
end

test "Status.new creates custom status"
  s = Status.new(418, "I'm a Teapot")

  assert s.code == 418
  assert s.reason == "I'm a Teapot"
end

test "Status.ok? checks 2xx range"
  assert Status.ok().ok?()
  assert Status.created().ok?()
  assert not Status.not_found().ok?()
end

test "Status.redirect? checks 3xx range"
  assert Status.new(301, "Moved").redirect?()
  assert not Status.ok().redirect?()
end

test "Status.client_error? checks 4xx range"
  assert Status.bad_request().client_error?()
  assert Status.not_found().client_error?()
  assert not Status.ok().client_error?()
end

test "Status.server_error? checks 5xx range"
  assert Status.internal_server_error().server_error?()
  assert not Status.ok().server_error?()
end
