test "Method.to_string returns uppercase method name"
  cases: List<(Method, String)> = [
    (Method.Connect, "CONNECT"), (Method.Delete, "DELETE"), (Method.Get, "GET"),
    (Method.Head, "HEAD"), (Method.Options, "OPTIONS"), (Method.Patch, "PATCH"),
    (Method.Post, "POST"), (Method.Put, "PUT"), (Method.Query, "QUERY"),
    (Method.Trace, "TRACE")
  ]

  for test_case in cases
    (method, expected) = test_case
    assert method.to_string() == expected
  end
end

test "Method.from_string parses valid methods"
  names = [
    "CONNECT", "DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT",
    "QUERY", "TRACE"
  ]

  for name in names
    assert Method.from_string(name).unwrap().to_string() == name
  end
end

test "Method.from_string rejects unknown methods"
  assert Method.from_string("INVALID").err?()
end
