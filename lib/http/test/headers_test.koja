test "Headers.new creates empty collection"
  h = Headers.new()
  assert not h.has?("Content-Type")
end

test "Headers.append adds a header"
  h = Headers.new().append("Content-Type", "text/html")
  assert h.get("Content-Type").unwrap() == "text/html"
end

test "Headers.get is case-insensitive"
  h = Headers.new().append("Content-Type", "text/html")

  assert h.get("content-type").unwrap() == "text/html"
  assert h.get("CONTENT-TYPE").unwrap() == "text/html"
end

test "Headers.get returns None for missing header"
  h = Headers.new()
  assert h.get("X-Missing").none?()
end

test "Headers.get_all returns all values"
  h = Headers.new().append("Set-Cookie", "a=1").append("Set-Cookie", "b=2")
  all = h.get_all("Set-Cookie")

  assert all.length() == 2
  assert all.get(0).unwrap() == "a=1"
  assert all.get(1).unwrap() == "b=2"
end

test "Headers.set replaces existing header"
  h =
    Headers.new()
    .append("Content-Type", "text/plain")
    .set("Content-Type", "text/html")

  assert h.get("Content-Type").unwrap() == "text/html"
  assert h.get_all("Content-Type").length() == 1
end

test "Headers.has? checks for header presence"
  h = Headers.new().append("Host", "example.com")

  assert h.has?("Host")
  assert h.has?("host")
  assert not h.has?("X-Missing")
end

test "Headers.content_length parses integer value"
  h = Headers.new().append("Content-Length", "42")
  assert h.content_length().unwrap() == 42
end

test "Headers.content_length returns None when missing"
  h = Headers.new()
  assert h.content_length().none?()
end
