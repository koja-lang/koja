alias IO.Error as IOError
alias IO.Reader.Options as ReaderOptions
alias IO.Writer.Options as WriterOptions
alias Net.Socket.Error as SocketError
alias Net.TCPSocket
alias Net.TLSConfig
alias Net.TLSError
alias URI.Error as URIError

# The largest response body the client accepts, 16 MiB.
priv const MAX_RESPONSE_BODY_BYTES: Int = 16777216

priv const READ_SIZE: Int = 8192

@doc """
Sends a DELETE request to the given URL. See `request` for the
timeout and the errors.
"""
fn delete(
  url: String,
  headers: Headers,
  timeout: Option<Duration> = Option.None,
) -> Response ! Error | SocketError | IOError | TLSError

  try request(Method.Delete, url, headers, "", timeout)
end

@doc """
Sends a GET request to the given URL. See `request` for the timeout
and the errors.
"""
fn get(url: String, timeout: Option<Duration> = Option.None)
  -> Response ! Error | SocketError | IOError | TLSError

  try request(Method.Get, url, Headers.new(), "", timeout)
end

@doc """
Sends a HEAD request to the given URL. The response has no body. See
`request` for the timeout and the errors.
"""
fn head(url: String, timeout: Option<Duration> = Option.None)
  -> Response ! Error | SocketError | IOError | TLSError

  try request(Method.Head, url, Headers.new(), "", timeout)
end

@doc """
Sends an OPTIONS request to the given URL. See `request` for the
timeout and the errors.
"""
fn options(url: String, timeout: Option<Duration> = Option.None)
  -> Response ! Error | SocketError | IOError | TLSError

  try request(Method.Options, url, Headers.new(), "", timeout)
end

@doc """
Sends a PATCH request to the given URL with a body. See `request` for
the timeout and the errors.
"""
fn patch(
  url: String,
  body: Binary | String,
  headers: Headers,
  timeout: Option<Duration> = Option.None,
) -> Response ! Error | SocketError | IOError | TLSError

  try request(Method.Patch, url, headers, body, timeout)
end

@doc """
Sends a POST request to the given URL with a body. See `request` for
the timeout and the errors.
"""
fn post(
  url: String,
  body: Binary | String,
  headers: Headers,
  timeout: Option<Duration> = Option.None,
) -> Response ! Error | SocketError | IOError | TLSError

  try request(Method.Post, url, headers, body, timeout)
end

@doc """
Sends a PUT request to the given URL with a body. See `request` for
the timeout and the errors.
"""
fn put(
  url: String,
  body: Binary | String,
  headers: Headers,
  timeout: Option<Duration> = Option.None,
) -> Response ! Error | SocketError | IOError | TLSError

  try request(Method.Put, url, headers, body, timeout)
end

@doc """
Sends one HTTP/1.1 request and returns the response. The client opens
a connection for the request and closes it after the response, so it
sets `Connection: close`. A `String` body is sent as its UTF-8 bytes.

`timeout` bounds the whole request, from the connect to the last byte
of the response. It does not bound the DNS lookup. `Option.None`
waits with no limit. A request that passes the limit fails with
`HTTP.Error.Timeout`.

A response body larger than 16 MiB fails with
`HTTP.Error.Parse(Parser.Error.BodyTooLarge)`. The client drops a 1xx
response and returns the response that follows it. A 101 is the
exception, and the client returns it.

A URL that cannot be requested fails with `HTTP.Error.InvalidUrl`
before any network call. A network failure keeps its own type, which
is `Socket.Error` for the connect and `IO.Error` or `TLSError` after
it. Match by type to tell the causes apart.

```koja
match HTTP.get("https://example.com")
  Result.Ok(response) -> use(response)
  Result.Err(http_error: HTTP.Error) -> log(http_error.message())
  Result.Err(socket_error: Net.Socket.Error) -> log(socket_error.message())
  Result.Err(io_error: IO.Error) -> log(io_error.message())
  Result.Err(tls_error: Net.TLSError) -> log(tls_error.message())
end
```
"""
fn request(
  method: Method,
  url: String,
  headers: Headers,
  body: Binary | String,
  timeout: Option<Duration> = Option.None,
) -> Response ! Error | SocketError | IOError | TLSError

  uri = URI.parse(url)
    rescue e -> fail Error.InvalidUrl(uri_error_message(e, url))

  scheme = try uri.scheme.or_err(
    Error.InvalidUrl("URL must be absolute and use http or https: " <> url),
  )

  if scheme != "http" and scheme != "https"
    fail Error.InvalidUrl("unsupported URL scheme '#{scheme}': " <> url)
  end

  host =
    match uri.host
      Option.Some(h) when not h.empty?() -> h
      _ -> fail Error.InvalidUrl("missing host in URL: " <> url)
    end

  port = try uri.port.or_err(Error.InvalidUrl("missing port in URL: " <> url))

  message = Request{
    body: body_bytes(body),
    headers: headers.set("Connection", "close"),
    method: method,
    uri: uri,
  }

  deadline = timeout.map(limit -> Instant.now().plus(limit))
  limit = try remaining(deadline)

  plain = TCPSocket.connect(host, port, limit) rescue e -> fail socket_cause(e)

  try exchange(plain, host, scheme == "https", message, deadline)
end

# Closes a socket whose request is over. The request already has its
# result, so a failed close changes nothing.
priv fn discard(socket: TCPSocket)
  match socket.close()
    _ -> ()
  end
end

# Runs one request on a new connection, and closes the connection in
# every case.
priv fn exchange(
  plain: TCPSocket,
  host: String,
  secure: Bool,
  message: Request,
  deadline: Option<Instant>,
) -> Response ! Error | SocketError | IOError | TLSError

  socket =
    match prepare(plain, host, secure, deadline)
      Result.Ok(ready) ->
        ready

      Result.Err(cause) ->
        discard(plain)
        fail cause
    end

  result = transfer(socket, message, deadline)
  discard(socket)
  try result
end

# A 1xx response that is not the last response to its request. A 101
# is the last one, because the connection changes protocol after it.
priv fn interim?(status: Status) -> Bool
  status.code >= 100 and status.code < 200 and status.code != 101
end

# Turns `TCP_NODELAY` on, then starts TLS when the URL asks for it.
priv fn prepare(
  plain: TCPSocket,
  host: String,
  secure: Bool,
  deadline: Option<Instant>,
) -> TCPSocket ! Error | SocketError | IOError | TLSError

  socket = try plain.set_nodelay(true)

  if not secure
    return socket
  end

  limit = try remaining(deadline)

  socket.upgrade_tls(host, TLSConfig.client(), limit)
    rescue e -> fail stream_cause(e)
end

# Returns the time left before the deadline, for the next network
# call. Fails with `Error.Timeout` when the deadline has passed.
priv fn remaining(deadline: Option<Instant>) -> Option<Duration> ! Error
  match deadline
    Option.Some(limit) ->
      now = Instant.now()

      if now.nanoseconds >= limit.nanoseconds
        fail Error.Timeout
      end

      Option.Some(limit.since(now))

    Option.None ->
      Option.None
  end
end

# Maps a connect that timed out to `Error.Timeout`, so a caller sees
# one timeout for the whole request.
priv fn socket_cause(e: SocketError) -> Error | SocketError
  if e == SocketError.TimedOut
    return Error.Timeout
  end

  e
end

# Maps a read, a write, or a handshake that timed out to
# `Error.Timeout`, so a caller sees one timeout for the whole request.
priv fn stream_cause(e: IOError | TLSError) -> Error | IOError | TLSError
  match e
    io_error: IOError ->
      if io_error == IOError.TimedOut
        return Error.Timeout
      end

      return io_error

    tls_error: TLSError ->
      return tls_error
  end
end

# Writes the request, then reads until the parser has a whole
# response.
priv fn transfer(socket: TCPSocket, message: Request, deadline: Option<Instant>)
  -> Response ! Error | IOError | TLSError

  limit = try remaining(deadline)

  socket.write_all(message.serialize(), WriterOptions{timeout: limit})
    rescue e -> fail stream_cause(e)

  buffer: Binary = <<>>
  ended = false
  limits = Parser.Limits{max_body_bytes: MAX_RESPONSE_BODY_BYTES}
  response: Option<Response> = Option.None

  while response.none?()
    outcome = Parser.parse_response(buffer, message.method, ended, limits)
      rescue e -> fail Error.Parse(e)

    match outcome
      Parser.Outcome.Complete((received, rest)) ->
        if interim?(received.status)
          buffer = rest
        else
          response = Option.Some(received)
        end

      Parser.Outcome.Incomplete ->
        limit = try remaining(deadline)

        chunk = socket.read(READ_SIZE, ReaderOptions{timeout: limit})
          rescue e -> fail stream_cause(e)

        if chunk.byte_size() == 0
          ended = true
        else
          buffer = buffer <> chunk
        end
    end
  end

  # The loop ends only when `response` holds a value.
  response.unwrap()
end

priv fn uri_error_message(error: URIError, url: String) -> String
  match error
    URIError.InvalidPercentEncoding(part) ->
      "invalid percent encoding '#{part}' in URL: #{url}"

    URIError.InvalidURI(part) ->
      "invalid URI component '#{part}' in URL: #{url}"

    URIError.InvalidUTF8 ->
      "URL is not valid UTF-8: " <> url
  end
end
