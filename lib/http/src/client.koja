alias JSON.StringBuilder
alias Net.Socket.Error as SocketError
alias Net.TCPSocket
alias Net.TLSError
alias URI.Error as URIError

@doc """
Sends a DELETE request to the given URL.
"""
fn delete(url: String, headers: Headers) -> Response ! Error
  try request(Method.Delete, url, headers, "")
end

@doc """
Sends a GET request to the given URL.
"""
fn get(url: String) -> Response ! Error
  try request(Method.Get, url, Headers.new(), "")
end

@doc """
Sends a HEAD request to the given URL.
"""
fn head(url: String) -> Response ! Error
  try request(Method.Head, url, Headers.new(), "")
end

@doc """
Sends an OPTIONS request to the given URL.
"""
fn options(url: String) -> Response ! Error
  try request(Method.Options, url, Headers.new(), "")
end

@doc """
Sends a PATCH request to the given URL with a body.
"""
fn patch(url: String, body: String, headers: Headers) -> Response ! Error
  try request(Method.Patch, url, headers, body)
end

@doc """
Sends a POST request to the given URL with a body.
"""
fn post(url: String, body: String, headers: Headers) -> Response ! Error
  try request(Method.Post, url, headers, body)
end

@doc """
Sends a PUT request to the given URL with a body.
"""
fn put(url: String, body: String, headers: Headers) -> Response ! Error
  try request(Method.Put, url, headers, body)
end

@doc """
Sends an HTTP request with the given method, URL, headers,
  and body. Opens a TCP connection, writes the request, reads
  the full response, and closes the connection.
"""
fn request(method: Method, url: String, headers: Headers, body: String)
  -> Response
  ! Error

  parsed = URI.parse(url)
    rescue e -> fail Error.InvalidUrl(uri_error_message(e, url))

  scheme = try parsed.scheme.or_err(
    Error.InvalidUrl("URL must be absolute and use http or https: " <> url),
  )

  unless scheme == "http" or scheme == "https"
    fail Error.InvalidUrl("unsupported URL scheme '#{scheme}': " <> url)
  end

  host =
    match parsed.host
      Option.Some(h) when not h.empty?() -> h
      _ -> fail Error.InvalidUrl("missing host in URL: " <> url)
    end

  port = try parsed.port.or_err(
    Error.InvalidUrl("missing port in URL: " <> url),
  )
  path = parsed.path.empty?() ? "/" : parsed.path

  target =
    match parsed.query
      Option.Some(query) -> path <> "?" <> query
      Option.None -> path
    end

  socket =
    if scheme == "https"
      TCPSocket.connect_tls(host, port)
        rescue e -> fail Error.ConnectionFailed(net_error_message(e))
    else
      TCPSocket.connect(host, port)
        rescue e -> fail Error.ConnectionFailed(e.message())
    end

  raw = build_request(method, host, target, headers, body)

  socket.write(raw)
    rescue e -> fail Error.ConnectionFailed("write failed: " <>
      net_error_message(e))

  try read_response(socket)
end

priv fn uri_error_message(error: URIError, url: String) -> String
  match error
    URIError.InvalidPercentEncoding(part) ->
      "invalid percent encoding '#{part}' in URL: #{url}"

    URIError.InvalidURI(part) ->
      "invalid URI component '#{part}' in URL: #{url}"

    URIError.InvalidUTF8 ->
      "URL is not valid UTF-8: " <> url
  end
end

priv fn build_request(
  method: Method,
  host: String,
  path: String,
  headers: Headers,
  body: String,
) -> String

  sb = StringBuilder.new()
    .add(method.to_string())
    .add(" ")
    .add(path)
    .add(" HTTP/1.1\r\n")
    .add("Host: ")
    .add(host)
    .add("\r\n")

  if not body.empty?() and not headers.has?("Content-Length")
    sb = sb.add("Content-Length: ").add("#{body.byte_length()}").add("\r\n")
  end

  sb = write_headers(sb, headers, 0).add("Connection: close\r\n\r\n")

  if not body.empty?()
    sb = sb.add(body)
  end

  sb.build()
end

priv fn write_headers(sb: StringBuilder, headers: Headers, i: Int)
  -> StringBuilder

  if i >= headers.entries.length()
    return sb
  end

  entry = headers.entries.get(i).unwrap()
  sb = sb.add(entry.name).add(": ").add(entry.value).add("\r\n")
  write_headers(sb, headers, i + 1)
end

priv fn read_response(socket: TCPSocket) -> Response ! Error
  data = try read_all(socket, StringBuilder.new())
  try Parser.parse_response(data)
end

priv fn net_error_message(e: SocketError | TLSError) -> String
  match e
    socket_error: SocketError -> socket_error.message()
    tls_error: TLSError -> tls_error.message()
  end
end

priv fn read_all(socket: TCPSocket, sb: StringBuilder) -> String ! Error
  chunk = socket.read(8192)
    rescue e -> fail Error.ConnectionFailed("read failed: " <>
      net_error_message(e))

  if chunk.empty?()
    match socket.close()
      _ -> ()
    end

    return sb.build()
  end

  sb = sb.add(chunk)
  try read_all(socket, sb)
end
