@doc """
An HTTP response with a status, headers, and a body. The parser
creates one from the bytes a client reads, and a server handler
builds one with `Response.new`.

`body` holds bytes. Use `text` to decode it as UTF-8.

`version` says which HTTP version a received response arrived as. A
writer ignores it.
"""
struct Response
  body: Binary
  headers: Headers
  status: Status
  version: Version = Version.HTTP1_1

  @doc """
  Creates a response with the given status and body. A `String` body
  is stored as its UTF-8 bytes. Sets `Content-Length` from the byte
  size of the body.
  """
  fn new(status: Status, body: Binary | String) -> Response
    bytes = body_bytes(body)
    headers = Headers.new().set("Content-Length", "#{bytes.byte_size()}")
    Response{body: bytes, headers: headers, status: status}
  end

  @doc """
  Encodes the response as an HTTP/1.1 message. The status line
  carries `status.reason()`. Sets `Content-Length` from the byte size
  of the body when the headers have none. Does not set `Connection`.
  Ignores `version`, and never writes a chunked body.
  """
  fn serialize(self) -> Binary
    head = "HTTP/1.1 #{self.status.code} " <> self.status.reason() <> "\r\n" <>
      header_lines(self.headers)

    if not self.headers.has?("Content-Length")
      head = head <> "Content-Length: #{self.body.byte_size()}\r\n"
    end

    (head <> "\r\n").to_binary() <> self.body
  end

  @doc """
  Decodes the body as UTF-8. Fails with
  `String.ConversionError.InvalidUTF8` when the bytes are not valid
  UTF-8.
  """
  fn text(self) -> String ! String.ConversionError
    try self.body.to_string()
  end
end
