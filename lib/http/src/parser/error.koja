@doc """
Why a parser rejected a message. Each cause is one response a server
sends: `HeadersTooLarge` is 431, `Malformed` is 400, and
`UnsupportedMethod` is 501. `Malformed` carries what was wrong, and
`UnsupportedMethod` carries the method name.

A parser has no limit for a body, so a body that is too large is not
a `Parser.Error`. A `Content-Length` or a chunk size that does not
fit an `Int` is `Malformed`.
"""
enum Parser.Error
  HeadersTooLarge
  Malformed(String)
  UnsupportedMethod(String)

  @doc """
  Returns a human-readable description of the error.
  """
  fn message(self) -> String
    match self
      Parser.Error.HeadersTooLarge -> "the head is larger than the limit"
      Parser.Error.Malformed(detail) -> "malformed message: " <> detail
      Parser.Error.UnsupportedMethod(name) -> "unsupported method: " <> name
    end
  end
end
