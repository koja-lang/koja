@doc """
HTTP response status code. Two statuses with the same code are
equal. `reason()` looks up the reason phrase. Named constructors
are provided for common status codes.
"""
struct Status
  code: Int
end

extend Status
  @doc """
  Returns a 400 Bad Request status.
  """
  fn bad_request -> Status
    Status{code: 400}
  end

  @doc """
  Returns true if the status code is in the 4xx range.
  """
  fn client_error?(self) -> Bool
    self.code >= 400 and self.code < 500
  end

  @doc """
  Returns a 201 Created status.
  """
  fn created -> Status
    Status{code: 201}
  end

  @doc """
  Returns a 403 Forbidden status.
  """
  fn forbidden -> Status
    Status{code: 403}
  end

  @doc """
  Returns a 500 Internal Server Error status.
  """
  fn internal_server_error -> Status
    Status{code: 500}
  end

  @doc """
  Returns a 405 Method Not Allowed status.
  """
  fn method_not_allowed -> Status
    Status{code: 405}
  end

  @doc """
  Creates a status from its code.
  """
  fn new(code: Int) -> Status
    Status{code: code}
  end

  @doc """
  Returns a 204 No Content status.
  """
  fn no_content -> Status
    Status{code: 204}
  end

  @doc """
  Returns a 404 Not Found status.
  """
  fn not_found -> Status
    Status{code: 404}
  end

  @doc """
  Returns a 200 OK status.
  """
  fn ok -> Status
    Status{code: 200}
  end

  @doc """
  Returns true if the status code is in the 2xx range.
  """
  fn ok?(self) -> Bool
    self.code >= 200 and self.code < 300
  end

  @doc """
  Returns the standard reason phrase for the code, such as
  `"Not Found"` for 404. Returns `""` for a code with no standard
  phrase.
  """
  fn reason(self) -> String
    match self.code
      100 -> "Continue"
      101 -> "Switching Protocols"
      102 -> "Processing"
      103 -> "Early Hints"
      200 -> "OK"
      201 -> "Created"
      202 -> "Accepted"
      203 -> "Non-Authoritative Information"
      204 -> "No Content"
      205 -> "Reset Content"
      206 -> "Partial Content"
      207 -> "Multi-Status"
      208 -> "Already Reported"
      226 -> "IM Used"
      300 -> "Multiple Choices"
      301 -> "Moved Permanently"
      302 -> "Found"
      303 -> "See Other"
      304 -> "Not Modified"
      305 -> "Use Proxy"
      307 -> "Temporary Redirect"
      308 -> "Permanent Redirect"
      400 -> "Bad Request"
      401 -> "Unauthorized"
      402 -> "Payment Required"
      403 -> "Forbidden"
      404 -> "Not Found"
      405 -> "Method Not Allowed"
      406 -> "Not Acceptable"
      407 -> "Proxy Authentication Required"
      408 -> "Request Timeout"
      409 -> "Conflict"
      410 -> "Gone"
      411 -> "Length Required"
      412 -> "Precondition Failed"
      413 -> "Content Too Large"
      414 -> "URI Too Long"
      415 -> "Unsupported Media Type"
      416 -> "Range Not Satisfiable"
      417 -> "Expectation Failed"
      421 -> "Misdirected Request"
      422 -> "Unprocessable Content"
      423 -> "Locked"
      424 -> "Failed Dependency"
      425 -> "Too Early"
      426 -> "Upgrade Required"
      428 -> "Precondition Required"
      429 -> "Too Many Requests"
      431 -> "Request Header Fields Too Large"
      451 -> "Unavailable For Legal Reasons"
      500 -> "Internal Server Error"
      501 -> "Not Implemented"
      502 -> "Bad Gateway"
      503 -> "Service Unavailable"
      504 -> "Gateway Timeout"
      505 -> "HTTP Version Not Supported"
      506 -> "Variant Also Negotiates"
      507 -> "Insufficient Storage"
      508 -> "Loop Detected"
      510 -> "Not Extended"
      511 -> "Network Authentication Required"
      _ -> ""
    end
  end

  @doc """
  Returns true if the status code is in the 3xx range.
  """
  fn redirect?(self) -> Bool
    self.code >= 300 and self.code < 400
  end

  @doc """
  Returns true if the status code is in the 5xx range.
  """
  fn server_error?(self) -> Bool
    self.code >= 500 and self.code < 600
  end

  @doc """
  Returns a 401 Unauthorized status.
  """
  fn unauthorized -> Status
    Status{code: 401}
  end
end
