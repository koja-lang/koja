@doc """
HTTP request method. Represents the action to be performed
on the identified resource.
"""
enum Method
  Connect
  Delete
  Get
  Head
  Options
  Patch
  Post
  Put
  Query
  Trace

  @doc """
  Parses an uppercase HTTP method string into a Method value.
  Fails for unrecognized methods.
  """
  fn from_string(s: String) -> Method ! String
    match s
      "CONNECT" -> Method.Connect
      "DELETE" -> Method.Delete
      "GET" -> Method.Get
      "HEAD" -> Method.Head
      "OPTIONS" -> Method.Options
      "PATCH" -> Method.Patch
      "POST" -> Method.Post
      "PUT" -> Method.Put
      "QUERY" -> Method.Query
      "TRACE" -> Method.Trace
      _ -> fail "unknown HTTP method: #{s}"
    end
  end

  @doc """
  Returns the uppercase string representation of this method.
  """
  fn to_string(self) -> String
    match self
      Method.Connect -> "CONNECT"
      Method.Delete -> "DELETE"
      Method.Get -> "GET"
      Method.Head -> "HEAD"
      Method.Options -> "OPTIONS"
      Method.Patch -> "PATCH"
      Method.Post -> "POST"
      Method.Put -> "PUT"
      Method.Query -> "QUERY"
      Method.Trace -> "TRACE"
    end
  end
end
