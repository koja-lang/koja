@doc """
The `koja.new` toolchain task backing `koja new <name>`. Scaffolds a
new project directory with `koja.toml`, `.gitignore`, a starter
`Process` entry in `src/`, and a starter test in `test/`.
"""
struct New
end

impl Koja.Task for New
  fn run(args: List<String>) ! String
    name = try args.get(0).or_err("usage: koja new <name>")

    unless valid_project_name?(name)
      fail "project name must be lowercase snake_case (like `my_app`). The code namespace is derived from it (`my_app` -> `MyApp`)"
    end

    if File.exists?(name)
      fail "directory '#{name}' already exists"
    end

    File.mkdir_p("#{name}/src")
      rescue message -> fail "cannot create directory: #{message}"

    File.mkdir_p("#{name}/test")
      rescue message -> fail "cannot create directory: #{message}"

    try write_scaffold(name)

    IO.puts("created project '#{name}'")
  end
end

priv fn write_scaffold(name: String) ! String
  try write_file("#{name}/koja.toml", toml_content(name))
  try write_file("#{name}/.gitignore", gitignore_content())
  try write_file("#{name}/src/app.koja", app_content())
  try write_file("#{name}/test/app_test.koja", app_test_content())
end

# Appends the trailing newline the heredoc closing delimiter strips.
priv fn write_file(path: String, content: String) ! String
  File.write(path, "#{content}\n")
    rescue message -> fail "cannot write #{path}: #{message}"

  ()
end

priv fn valid_project_name?(name: String) -> Bool
  chars = name.codepoints()

  starts_lower =
    match chars.get(0)
      Option.None -> false
      Option.Some(first) -> ascii_lowercase?(first)
    end

  starts_lower
    and chars.all?(c -> ascii_lowercase?(c) or ascii_digit?(c) or c == "_")
end

priv fn ascii_lowercase?(char: String) -> Bool
  "abcdefghijklmnopqrstuvwxyz".contains?(char)
end

priv fn ascii_digit?(char: String) -> Bool
  "0123456789".contains?(char)
end

# Stamp the scaffolding compiler's minor as the minimum. Pre-1.0
# minors are breaking, so a fresh project needs at least the
# compiler that generated it.
priv fn minimum_koja_version -> String
  version = toolchain_version()
  parts = version.split(".")

  match parts.get(0)
    Option.None ->
      version

    Option.Some(major) ->
      match parts.get(1)
        Option.None -> version
        Option.Some(minor) -> "#{major}.#{minor}"
      end
  end
end

priv fn toolchain_version -> String
  cs = koja_toolchain_version().to_cstring()
  result = cs.to_string()
  cs.free()
  result.unwrap()
end

priv fn toml_content(name: String) -> String
  """
  [project]
  entry = "App"
  koja = "#{minimum_koja_version()}"
  name = "#{name}"
  version = "0.1.0"
  """
end

priv fn gitignore_content -> String
  """
  /build
  /deps
  """
end

priv fn app_content -> String
  """
  alias Process.Step
  alias Process.StopReason

  fn greet(name: String) -> String
    "Hello, \#{name}!"
  end

  struct App
  end

  impl Process<(), (), ()> for App
    fn start(config: ()) -> Self ! StopReason
      App{}
    end

    fn handle(self, msg: (), from: Option<ReplyTo<()>>) -> Step<Self>
      Step.Continue(self)
    end

    fn run(self) -> StopReason
      IO.puts(greet("Koja"))
      StopReason.Normal
    end
  end
  """
end

priv fn app_test_content -> String
  """
  struct AppTest
    @test "greet builds a greeting message"
    fn test_greet -> Result<Bool, String>
      actual = greet("Koja")
      expected = "Hello, Koja!"

      unless actual == expected
        return Result.Err("expected `\#{expected}`, got `\#{actual}`")
      end

      Result.Ok(true)
    end
  end
  """
end

@extern "C"
priv fn koja_toolchain_version -> CPtr<UInt8>
