alias Net.IPAddress
alias Net.Socket
alias Net.Socket.Address as SocketAddress
alias Net.Socket.Error as SocketError
alias Net.Socket.Kind as SocketKind
alias Net.TCPListener
alias Net.TCPSocket
alias Net.UDPSocket

struct SocketTest
  @test "create stream socket"
  fn test_create_stream ! String
    match Socket.create(SocketKind.Stream)
      Result.Err(msg) -> fail "stream create failed: #{msg}"
      Result.Ok(s) -> _ = s.close()
    end
  end

  @test "create datagram socket"
  fn test_create_datagram ! String
    match Socket.create(SocketKind.Datagram)
      Result.Err(msg) -> fail "datagram create failed: #{msg}"
      Result.Ok(s) -> _ = s.close()
    end
  end

  @test "bind stream socket to any:0"
  fn test_bind ! String
    match Socket.create(SocketKind.Stream)
      Result.Err(msg) ->
        fail "create for bind failed: #{msg}"

      Result.Ok(s) ->
        match s.bind(SocketAddress{ip: IPAddress.any(), port: 0})
          Result.Err(msg) -> fail "bind failed: #{msg}"
          Result.Ok(bound) -> _ = bound.close()
        end
    end
  end

  @test "connect to loopback:1 is refused"
  fn test_connect_refused ! String
    match Socket.create(SocketKind.Stream)
      Result.Err(msg) ->
        fail "create for connect failed: #{msg}"

      Result.Ok(s) ->
        match s.connect(SocketAddress{ip: IPAddress.loopback(), port: 1})
          Result.Ok(conn) ->
            _ = conn.close()
            fail "expected connection refused"

          Result.Err(_) ->
            ()
        end
    end
  end

  @test "resolve localhost returns non-empty list"
  fn test_resolve_localhost ! String
    match Socket.resolve("localhost")
      Result.Err(msg) ->
        fail "resolve failed: #{msg}"

      Result.Ok(addrs) ->
        rendered_loopback = addrs.any?(address -> address.version ==
            IPAddress.Version.V4 and address.to_string() == "127.0.0.1")

        if not rendered_loopback
          fail "resolve did not return rendered IPv4 loopback"
        end
    end
  end

  @test "TCPListener.bind to port 0"
  fn test_tcp_listener_bind ! String
    match TCPListener.bind(0)
      Result.Err(e) -> fail "tcp listener bind failed: " <> e.message()
      Result.Ok(listener) -> _ = listener.close()
    end
  end

  @test "TCPSocket.connect_addr to loopback:1 is refused"
  fn test_tcp_connect_refused ! String
    match TCPSocket.connect_addr(
      SocketAddress{ip: IPAddress.loopback(), port: 1},
    )
      Result.Ok(conn) ->
        _ = conn.close()
        fail "expected tcp connection refused"

      Result.Err(SocketError.ConnectionRefused) ->
        ()

      Result.Err(e) ->
        fail "expected ConnectionRefused, got: " <> e.message()
    end
  end

  @test "UDPSocket.bind to port 0"
  fn test_udp_bind ! String
    match UDPSocket.bind(0)
      Result.Err(e) -> fail "udp bind failed: " <> e.message()
      Result.Ok(sock) -> _ = sock.close()
    end
  end

  @test "UDPSocket.bind_addr with loopback"
  fn test_udp_bind_addr ! String
    match UDPSocket.bind_addr(SocketAddress{ip: IPAddress.loopback(), port: 0})
      Result.Err(e) -> fail "udp bind_addr failed: " <> e.message()
      Result.Ok(sock) -> _ = sock.close()
    end
  end

  @test "TCPListener.bind_addr with loopback"
  fn test_tcp_listener_bind_addr ! String
    match TCPListener.bind_addr(
      SocketAddress{ip: IPAddress.loopback(), port: 0},
    )
      Result.Err(e) -> fail "tcp listener bind_addr failed: " <> e.message()
      Result.Ok(listener) -> _ = listener.close()
    end
  end

  @test "UDP send preserves embedded NUL length"
  fn test_udp_send_embedded_nul ! String
    socket =
      match Socket.create(SocketKind.Datagram)
        Result.Err(message) -> fail message
        Result.Ok(value) -> value
      end

    payload = <<97, 0, 98>>.to_string().unwrap()
    address = SocketAddress{ip: IPAddress.loopback(), port: 9}
    result = socket.send_to(payload, address)
    _ = socket.close()

    match result
      Result.Err(message) ->
        fail message

      Result.Ok(sent) ->
        if sent != 3
          fail "expected 3 bytes sent, got #{sent}"
        end
    end
  end

  @test "UDP recv_from returns a complete sender address"
  fn test_udp_recv_from_address ! String
    (receiver, port) = try bind_loopback_udp()
    sender = UDPSocket.bind(0) rescue error -> fail error.message()
    target = SocketAddress{ip: IPAddress.loopback(), port: port}

    _sent = sender.send_to("ping", target) rescue error -> fail error.message()
    (data, address) = receiver.recv_from(16)
      rescue error -> fail error.message()

    _sender_closed = sender.close()
    _receiver_closed = receiver.close()

    if data != "ping".to_binary()
      fail "unexpected UDP payload"
    end

    if address.ip.version != IPAddress.Version.V4
      fail "expected an IPv4 sender address"
    end

    if address.ip.to_string() != "127.0.0.1"
      fail "unexpected sender address: #{address.ip.to_string()}"
    end

    if address.port <= 0
      fail "expected a positive sender port"
    end
  end
end

priv fn bind_loopback_udp -> (UDPSocket, Int) ! String
  attempts = 0

  while attempts < 20
    port = Random.int(49152, 65535)

    match UDPSocket.bind_addr(
      SocketAddress{ip: IPAddress.loopback(), port: port},
    )
      Result.Ok(socket) -> return (socket, port)
      Result.Err(_) -> attempts += 1
    end
  end

  fail "could not bind a loopback UDP test socket"
end
