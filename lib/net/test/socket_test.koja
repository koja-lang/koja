alias IO.Descriptor.Interest
alias IO.Error as IOError
alias IO.Reader.Options as ReaderOptions
alias IO.Ready as IOReady
alias Net.IPAddress
alias Net.Socket
alias Net.Socket.Address as SocketAddress
alias Net.Socket.Error as SocketError
alias Net.Socket.Kind as SocketKind
alias Net.TCPListener
alias Net.TCPSocket
alias Net.UDPSocket
alias Test.require

const SHORT_WAIT: Duration = Duration{
  unit: Duration.Unit.Milliseconds,
  value: 50,
}

test "create stream socket"
  s = try require(Socket.create(SocketKind.Stream))
  _ = s.close()
end

test "create datagram socket"
  s = try require(Socket.create(SocketKind.Datagram))
  _ = s.close()
end

test "bind stream socket to any:0"
  s = try require(Socket.create(SocketKind.Stream))
  bound = try require(s.bind(SocketAddress{ip: IPAddress.ANY, port: 0}))
  _ = bound.close()
end

test "connect to loopback:1 is refused"
  s = try require(Socket.create(SocketKind.Stream))

  match s.connect(SocketAddress{ip: IPAddress.LOOPBACK, port: 1})
    Result.Ok(conn) ->
      _ = conn.close()
      fail "expected connection refused"

    Result.Err(_) ->
      ()
  end
end

test "resolve localhost returns non-empty list"
  addrs = try require(Socket.resolve("localhost"))

  assert addrs.any?(address -> address.version == IPAddress.Version.V4
    and address.to_string() == "127.0.0.1")
end

test "TCPListener.bind to port 0"
  listener = try require(TCPListener.bind(0))
  _ = listener.close()
end

test "TCPSocket.connect_addr to loopback:1 is refused"
  match TCPSocket.connect_addr(SocketAddress{ip: IPAddress.LOOPBACK, port: 1})
    Result.Ok(conn) ->
      _ = conn.close()
      fail "expected tcp connection refused"

    Result.Err(SocketError.ConnectionRefused) ->
      ()

    Result.Err(e) ->
      fail "expected ConnectionRefused, got: #{e.message()}"
  end
end

test "TCPListener.accept fails with TimedOut after its timeout"
  listener = try require(
    TCPListener.bind_addr(SocketAddress{ip: IPAddress.LOOPBACK, port: 0}),
  )
  result = listener.accept(Option.Some(SHORT_WAIT))
  _ = listener.close()

  match result
    Result.Ok(conn) ->
      _ = conn.close()
      fail "expected accept to time out"

    Result.Err(SocketError.TimedOut) ->
      ()

    Result.Err(e) ->
      fail "expected TimedOut, got: #{e.message()}"
  end
end

test "Socket.accept fails with Closed on a closed socket"
  socket = try require(Socket.create(SocketKind.Stream))
  try require(socket.close())

  match socket.accept(Option.Some(SHORT_WAIT))
    Result.Ok(client) ->
      _ = client.close()
      fail "expected accept to fail on a closed socket"

    Result.Err(SocketError.Closed) ->
      ()

    Result.Err(e) ->
      fail "expected Closed, got: #{e.message()}"
  end
end

test "TCPSocket.read fails with TimedOut when the peer is silent"
  (listener, port) = try bind_loopback_tcp()
  addr = SocketAddress{ip: IPAddress.LOOPBACK, port: port}
  client = try require(TCPSocket.connect_addr(addr))
  result = client.read(16, ReaderOptions{timeout: Option.Some(SHORT_WAIT)})
  _ = client.close()
  _ = listener.close()

  match result
    Result.Ok(_) -> fail "expected read to time out"
    Result.Err(IOError.TimedOut) -> ()
    Result.Err(io_error: IOError) ->
      fail "expected TimedOut, got: #{io_error.message()}"
    Result.Err(tls_error: TLSError) ->
      fail "expected TimedOut, got: #{tls_error.message()}"
  end
end

test "TCPSocket.set_nodelay sets the option on both ends of a connection"
  (listener, port) = try bind_loopback_tcp()
  addr = SocketAddress{ip: IPAddress.LOOPBACK, port: port}
  client = try require(TCPSocket.connect_addr(addr))
  accepted = listener.accept(Option.Some(SHORT_WAIT))
  _ = listener.close()
  server = try require(accepted)

  client_on = client.set_nodelay(true)
  server_on = server.set_nodelay(true)
  written = client.write_all("ping")
  read = server.read(16, ReaderOptions{timeout: Option.Some(SHORT_WAIT)})
  client_off = client.set_nodelay(false)
  _ = client.close()
  _ = server.close()

  try require(client_on)
  try require(server_on)
  try require(written)
  assert try require(read) == "ping".to_binary()
  try require(client_off)
end

test "TCPSocket.descriptor gets IO.Ready after the peer writes"
  (listener, port) = try bind_loopback_tcp()
  addr = SocketAddress{ip: IPAddress.LOOPBACK, port: port}
  client = try require(TCPSocket.connect_addr(addr))
  accepted = listener.accept(Option.Some(SHORT_WAIT))
  _ = listener.close()
  server = try require(accepted)

  watched = server.descriptor()
  watcher = spawn Watcher.start(server)
  written = client.write_all("ping")
  ready = watcher.call(WatchMsg.Ready, 2000)
  read = server.read(16, ReaderOptions{timeout: Option.Some(SHORT_WAIT)})
  _ = client.close()
  _ = server.close()

  try require(written)
  assert try require(read) == "ping".to_binary()

  match ready
    Result.Ok(IOReady.Read(descriptor)) -> assert descriptor.raw == watched.raw
    Result.Ok(other) -> fail "expected Read, got: #{other}"
    Result.Err(_) -> fail "no readiness message arrived"
  end
end

test "UDPSocket.bind to port 0"
  sock = try require(UDPSocket.bind(0))
  _ = sock.close()
end

test "UDPSocket.bind_addr with loopback"
  sock = try require(
    UDPSocket.bind_addr(SocketAddress{ip: IPAddress.LOOPBACK, port: 0}),
  )
  _ = sock.close()
end

test "TCPListener.bind_addr with loopback"
  listener = try require(
    TCPListener.bind_addr(SocketAddress{ip: IPAddress.LOOPBACK, port: 0}),
  )
  _ = listener.close()
end

test "UDP send preserves embedded NUL length"
  socket = try require(Socket.create(SocketKind.Datagram))
  payload = <<97, 0, 98>>.to_string().unwrap()
  address = SocketAddress{ip: IPAddress.LOOPBACK, port: 9}
  result = socket.send_to(payload, address)
  _ = socket.close()

  sent = try require(result)
  assert sent == 3
end

test "UDP recv_from returns a complete sender address"
  (receiver, port) = try bind_loopback_udp()
  sender = try require(UDPSocket.bind(0))
  target = SocketAddress{ip: IPAddress.LOOPBACK, port: port}

  _sent = try require(sender.send_to("ping", target))
  (data, address) = try require(receiver.recv_from(16))

  _sender_closed = sender.close()
  _receiver_closed = receiver.close()

  assert data == "ping".to_binary()
  assert address.ip.version == IPAddress.Version.V4
  assert address.ip.to_string() == "127.0.0.1"
  assert address.port > 0
end

priv enum WatchMsg
  # Reply with the readiness message, once it arrived.
  Ready
end

# Watches the descriptor of a socket. Answers `WatchMsg.Ready` with the
# readiness message, and holds the answer until that message arrives.
priv struct Watcher: Process<TCPSocket, WatchMsg | IOReady, IOReady>
  caller: Option<ReplyTo<IOReady>> = Option.None
  ready: Option<IOReady> = Option.None

  fn start(socket: TCPSocket) -> Self ! Process.StopReason
    socket.descriptor().watch(Interest.Readable)
    Watcher{}
  end

  fn handle(self, msg: WatchMsg | IOReady, from: Option<ReplyTo<IOReady>>)
    -> Process.Step<Self>

    match msg
      ready: IOReady -> self.ready = Option.Some(ready)
      ask: WatchMsg -> self.caller = from
    end

    match self.ready
      Option.Some(ready) -> ReplyTo.reply(self.caller, ready)
      Option.None -> Option.None
    end

    Process.Step.Continue(self)
  end
end

priv fn bind_loopback_udp -> (UDPSocket, Int) ! Test.Failure
  attempts = 0

  while attempts < 20
    port = Random.int(49152, 65535)

    match UDPSocket.bind_addr(SocketAddress{ip: IPAddress.LOOPBACK, port: port})
      Result.Ok(socket) -> return (socket, port)
      Result.Err(_) -> attempts += 1
    end
  end

  fail "could not bind a loopback UDP test socket"
end

priv fn bind_loopback_tcp -> (TCPListener, Int) ! Test.Failure
  attempts = 0

  while attempts < 20
    port = Random.int(49152, 65535)
    addr = SocketAddress{ip: IPAddress.LOOPBACK, port: port}

    match TCPListener.bind_addr(addr)
      Result.Ok(listener) -> return (listener, port)
      Result.Err(_) -> attempts += 1
    end
  end

  fail "could not bind a loopback TCP test socket"
end
