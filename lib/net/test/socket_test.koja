alias IO.Error as IOError
alias Net.IPAddress
alias Net.Socket
alias Net.Socket.Address as SocketAddress
alias Net.Socket.Error as SocketError
alias Net.Socket.Kind as SocketKind
alias Net.TCPListener
alias Net.TCPListener.Options as ListenerOptions
alias Net.TCPSocket
alias Net.UDPSocket
alias Test.require

const SHORT_WAIT: Duration = Duration{
  unit: Duration.Unit.Milliseconds,
  value: 50,
}

test "create stream socket"
  s = try require(Socket.create(SocketKind.Stream))
  _ = s.close()
end

test "create datagram socket"
  s = try require(Socket.create(SocketKind.Datagram))
  _ = s.close()
end

test "bind stream socket to any:0"
  s = try require(Socket.create(SocketKind.Stream))
  bound = try require(s.bind(SocketAddress{ip: IPAddress.ANY, port: 0}))
  _ = bound.close()
end

test "connect to loopback:1 is refused"
  s = try require(Socket.create(SocketKind.Stream))

  match s.connect(SocketAddress{ip: IPAddress.LOOPBACK, port: 1})
    Result.Ok(conn) ->
      _ = conn.close()
      fail "expected connection refused"

    Result.Err(_) ->
      ()
  end
end

test "resolve localhost returns non-empty list"
  addrs = try require(Socket.resolve("localhost"))

  assert addrs.any?(address -> address.version == IPAddress.Version.V4
    and address.to_string() == "127.0.0.1")
end

test "TCPListener.bind to port 0"
  listener = try require(TCPListener.bind(0))
  _ = listener.close()
end

test "TCPSocket.connect_addr to loopback:1 is refused"
  match TCPSocket.connect_addr(SocketAddress{ip: IPAddress.LOOPBACK, port: 1})
    Result.Ok(conn) ->
      _ = conn.close()
      fail "expected tcp connection refused"

    Result.Err(SocketError.ConnectionRefused) ->
      ()

    Result.Err(e) ->
      fail "expected ConnectionRefused, got: #{e.message()}"
  end
end

test "TCPListener.accept fails with TimedOut after accept_timeout"
  options = ListenerOptions{accept_timeout: Option.Some(SHORT_WAIT)}
  listener = try require(
    TCPListener.bind_addr(
      SocketAddress{ip: IPAddress.LOOPBACK, port: 0},
      options,
    ),
  )
  result = listener.accept()
  _ = listener.close()

  match result
    Result.Ok(conn) ->
      _ = conn.close()
      fail "expected accept to time out"

    Result.Err(SocketError.TimedOut) ->
      ()

    Result.Err(e) ->
      fail "expected TimedOut, got: #{e.message()}"
  end
end

test "TCPSocket.read fails with TimedOut when the peer is silent"
  (listener, port) = try bind_loopback_tcp(ListenerOptions{})
  addr = SocketAddress{ip: IPAddress.LOOPBACK, port: port}
  client = try require(TCPSocket.connect_addr(addr))
  result = client.with_read_timeout(Option.Some(SHORT_WAIT)).read(16)
  _ = client.close()
  _ = listener.close()

  match result
    Result.Ok(_) ->
      fail "expected read to time out"

    Result.Err(io_error: IOError) ->
      match io_error
        IOError.TimedOut -> ()
        _ -> fail "expected TimedOut, got: #{io_error.message()}"
      end

    Result.Err(tls_error: TLSError) ->
      fail "expected TimedOut, got: #{tls_error.message()}"

    Result.Err(conversion: String.ConversionError) ->
      fail "expected TimedOut, got: #{conversion}"
  end
end

test "TCPListener.accept copies the listener timeouts onto the socket"
  options = ListenerOptions{
    read_timeout: Option.Some(SHORT_WAIT),
    write_timeout: Option.Some(SHORT_WAIT),
  }
  (listener, port) = try bind_loopback_tcp(options)
  addr = SocketAddress{ip: IPAddress.LOOPBACK, port: port}
  client = try require(TCPSocket.connect_addr(addr))
  server = try require(listener.accept())
  _ = client.close()
  _ = server.close()
  _ = listener.close()

  assert client.read_timeout == Option.None
  assert server.read_timeout == Option.Some(SHORT_WAIT)
  assert server.write_timeout == Option.Some(SHORT_WAIT)
end

test "UDPSocket.bind to port 0"
  sock = try require(UDPSocket.bind(0))
  _ = sock.close()
end

test "UDPSocket.bind_addr with loopback"
  sock = try require(
    UDPSocket.bind_addr(SocketAddress{ip: IPAddress.LOOPBACK, port: 0}),
  )
  _ = sock.close()
end

test "TCPListener.bind_addr with loopback"
  listener = try require(
    TCPListener.bind_addr(SocketAddress{ip: IPAddress.LOOPBACK, port: 0}),
  )
  _ = listener.close()
end

test "UDP send preserves embedded NUL length"
  socket = try require(Socket.create(SocketKind.Datagram))
  payload = <<97, 0, 98>>.to_string().unwrap()
  address = SocketAddress{ip: IPAddress.LOOPBACK, port: 9}
  result = socket.send_to(payload, address)
  _ = socket.close()

  sent = try require(result)
  assert sent == 3
end

test "UDP recv_from returns a complete sender address"
  (receiver, port) = try bind_loopback_udp()
  sender = try require(UDPSocket.bind(0))
  target = SocketAddress{ip: IPAddress.LOOPBACK, port: port}

  _sent = try require(sender.send_to("ping", target))
  (data, address) = try require(receiver.recv_from(16))

  _sender_closed = sender.close()
  _receiver_closed = receiver.close()

  assert data == "ping".to_binary()
  assert address.ip.version == IPAddress.Version.V4
  assert address.ip.to_string() == "127.0.0.1"
  assert address.port > 0
end

priv fn bind_loopback_udp -> (UDPSocket, Int) ! Test.Failure
  attempts = 0

  while attempts < 20
    port = Random.int(49152, 65535)

    match UDPSocket.bind_addr(SocketAddress{ip: IPAddress.LOOPBACK, port: port})
      Result.Ok(socket) -> return (socket, port)
      Result.Err(_) -> attempts += 1
    end
  end

  fail "could not bind a loopback UDP test socket"
end

priv fn bind_loopback_tcp(options: ListenerOptions)
  -> (TCPListener, Int) ! Test.Failure

  attempts = 0

  while attempts < 20
    port = Random.int(49152, 65535)
    addr = SocketAddress{ip: IPAddress.LOOPBACK, port: port}

    match TCPListener.bind_addr(addr, options)
      Result.Ok(listener) -> return (listener, port)
      Result.Err(_) -> attempts += 1
    end
  end

  fail "could not bind a loopback TCP test socket"
end
