alias Crypto.Certificate
alias Crypto.PrivateKey
alias IO.Error as IOError
alias IO.Reader.Options as ReaderOptions
alias Net.Socket.Address as SocketAddress
alias Test.require

# Self-signed test certificate (CN=localhost, 100-year expiry).
# `koja test` always runs from the package root, so the relative
# fixture paths are stable. Configs take parsed in-memory values,
# so tests read the fixtures first.
const TLS_TEST_CERT_PATH: String = "test/fixtures/localhost_cert.pem"
const TLS_TEST_KEY_PATH: String = "test/fixtures/localhost_key.pem"

test "TLS loopback handshake and echo roundtrip"
  server_config = try require(server_test_config())
  try run_echo_roundtrip(43117, server_config, TLSConfig.insecure())
end

test "verifying client accepts a server trusted via custom CA PEM"
  server_config = try require(server_test_config())
  ca = try require(read_test_certificate())
  client_config = TLSConfig.client().with_ca(ca)
  try run_echo_roundtrip(43119, server_config, client_config)
end

test "verifying client rejects a self-signed server certificate"
  server_config = try require(server_test_config())
  addr = SocketAddress{ip: IPAddress.LOOPBACK, port: 43118}
  listener = try require(TCPListener.bind_addr(addr))

  server = Task.async(fn () -> Result<String, String>
    serve_tls_attempt(listener, server_config)
  end)

  plain = try require(TCPSocket.connect_addr(addr))
  upgraded = plain.upgrade_tls("localhost", TLSConfig.client())

  match plain.close()
    _ -> ()
  end

  match Task.await(server)
    _ -> ()
  end

  match listener.close()
    _ -> ()
  end

  match upgraded
    Result.Ok(_) ->
      fail "handshake should have failed certificate verification"

    Result.Err(tls_error: TLSError) ->
      match tls_error
        TLSError.VerificationFailed(_) -> ()
        _ -> fail "expected verification failure, got: #{tls_error.message()}"
      end

    Result.Err(io_error: IOError) ->
      fail "expected verification failure, got: #{io_error.message()}"
  end
end

test "TLS read fails with TimedOut when the peer is silent"
  server_config = try require(server_test_config())
  addr = SocketAddress{ip: IPAddress.LOOPBACK, port: 43120}
  listener = try require(TCPListener.bind_addr(addr))

  server = Task.async(fn () -> Result<String, String>
    serve_tls_silent(listener, server_config)
  end)

  plain = try require(TCPSocket.connect_addr(addr))

  client =
    match plain.upgrade_tls("localhost", TLSConfig.insecure())
      Result.Ok(s) -> s
      Result.Err(e) -> fail "upgrade_tls: #{net_message(e)}"
    end

  limit = Duration{unit: Duration.Unit.Milliseconds, value: 50}
  result = client.read(16, ReaderOptions{timeout: Option.Some(limit)})

  match client.close()
    _ -> ()
  end

  match Task.await(server)
    _ -> ()
  end

  match listener.close()
    _ -> ()
  end

  match result
    Result.Ok(_) ->
      fail "expected read to time out"

    Result.Err(io_error: IOError) ->
      match io_error
        IOError.TimedOut -> ()
        _ -> fail "expected TimedOut, got: #{io_error.message()}"
      end

    Result.Err(tls_error: TLSError) ->
      fail "expected TimedOut, got: #{tls_error.message()}"
  end
end

test "alpn_wire puts a length byte before each protocol name"
  h2 = "h2".to_binary()
  http1 = "http/1.1".to_binary()

  assert try require(alpn_wire(["h2", "http/1.1"])) ==
    <<2>> <> h2 <> <<8>> <> http1
  assert try require(alpn_wire(["h2"])) == <<2>> <> h2
  assert try require(alpn_wire([])) == <<>>
end

test "alpn_wire takes a name of 255 bytes and rejects longer and empty names"
  longest = name_of_size(255)
  wire = try require(alpn_wire([longest]))

  assert wire.byte_size() == 256
  assert wire.at(0) == Option.Some(255)
  assert alpn_wire([name_of_size(256)]) ==
    Result.Err(TLSError.ProtocolNameInvalid)
  assert alpn_wire(["h2", ""]) == Result.Err(TLSError.ProtocolNameInvalid)
end

test "with_alpn and with_ca keep the fields they do not set"
  ca = try require(read_test_certificate())
  config = TLSConfig.client().with_alpn(["h2", "http/1.1"]).with_ca(ca)

  assert TLSConfig.client().alpn == []
  assert config.alpn == ["h2", "http/1.1"]
  assert config.verify
  assert not TLSConfig.insecure().with_alpn(["h2"]).verify
end

test "alpn is None on a connection without TLS"
  addr = SocketAddress{ip: IPAddress.LOOPBACK, port: 43121}
  listener = try require(TCPListener.bind_addr(addr))
  plain = try require(TCPSocket.connect_addr(addr))
  selected = plain.alpn()

  match plain.close()
    _ -> ()
  end

  match listener.close()
    _ -> ()
  end

  assert selected == Option.None
end

test "a client that offers protocols gets None when the server selects none"
  server_config = try require(server_test_config())
  addr = SocketAddress{ip: IPAddress.LOOPBACK, port: 43122}
  listener = try require(TCPListener.bind_addr(addr))

  server = Task.async(fn () -> Result<String, String>
    serve_tls_silent(listener, server_config)
  end)

  plain = try require(TCPSocket.connect_addr(addr))
  config = TLSConfig.insecure().with_alpn(["h2", "http/1.1"])

  client =
    match plain.upgrade_tls("localhost", config)
      Result.Ok(s) -> s
      Result.Err(e) -> fail "upgrade_tls: #{net_message(e)}"
    end

  selected = client.alpn()

  match client.close()
    _ -> ()
  end

  match Task.await(server)
    _ -> ()
  end

  match listener.close()
    _ -> ()
  end

  assert selected == Option.None
end

test "a client handshake rejects a protocol name it cannot encode"
  addr = SocketAddress{ip: IPAddress.LOOPBACK, port: 43123}
  listener = try require(TCPListener.bind_addr(addr))
  plain = try require(TCPSocket.connect_addr(addr))
  config = TLSConfig.insecure().with_alpn(["h2", ""])
  upgraded = plain.upgrade_tls("localhost", config)

  match plain.close()
    _ -> ()
  end

  match listener.close()
    _ -> ()
  end

  match upgraded
    Result.Ok(_) ->
      fail "expected the handshake to reject the name"

    Result.Err(tls_error: TLSError) ->
      match tls_error
        TLSError.ProtocolNameInvalid -> ()
        _ -> fail "expected ProtocolNameInvalid, got: #{tls_error.message()}"
      end

    Result.Err(io_error: IOError) ->
      fail "expected ProtocolNameInvalid, got: #{io_error.message()}"
  end
end

# A protocol name of `size` bytes.
priv fn name_of_size(size: Int) -> String
  name = ""

  while name.byte_length() < size
    name = name <> "a"
  end

  name
end

priv fn run_echo_roundtrip(
  port: Int,
  server_config: TLSConfig,
  client_config: TLSConfig,
) ! Test.Failure

  addr = SocketAddress{ip: IPAddress.LOOPBACK, port: port}
  listener = try require(TCPListener.bind_addr(addr))

  server = Task.async(fn () -> Result<String, String>
    serve_tls_echo(listener, server_config)
  end)

  plain = try require(TCPSocket.connect_addr(addr))
  assert not plain.tls?()

  client =
    match plain.upgrade_tls("localhost", client_config)
      Result.Ok(s) -> s
      Result.Err(e) -> fail "upgrade_tls: #{net_message(e)}"
    end

  assert client.tls?()

  client.write("hello over tls")
    rescue e -> fail "client write: #{net_message(e)}"

  echoed =
    match client.read_string(1024)
      Result.Ok(d) -> d
      Result.Err(e) -> fail "client read: #{net_message(e)}"
    end

  match client.close()
    _ -> ()
  end

  server_seen =
    match Task.await(server)
      Result.Ok(Result.Ok(d)) -> d
      Result.Ok(Result.Err(e)) -> fail "server: #{e}"
      Result.Err(_) -> fail "server task did not finish"
    end

  match listener.close()
    _ -> ()
  end

  assert echoed == "hello over tls"
  assert server_seen == "hello over tls"
end

priv fn serve_tls_attempt(listener: TCPListener, config: TLSConfig)
  -> Result<String, String>

  raw =
    match listener.accept()
      Result.Ok(s) -> s
      Result.Err(e) -> return Result.Err("accept: " <> e.message())
    end

  outcome =
    match raw.accept_tls(config)
      Result.Ok(secured) ->
        match secured.close()
          _ -> ()
        end

        "handshake ok"

      Result.Err(e) ->
        match raw.close()
          _ -> ()
        end

        "handshake failed: " <> net_message(e)
    end

  Result.Ok(outcome)
end

# Completes the handshake, then waits for the client to hang up
# without ever writing.
priv fn serve_tls_silent(listener: TCPListener, config: TLSConfig)
  -> Result<String, String>

  raw =
    match listener.accept()
      Result.Ok(s) -> s
      Result.Err(e) -> return Result.Err("accept: " <> e.message())
    end

  secured =
    match raw.accept_tls(config)
      Result.Ok(s) -> s
      Result.Err(e) -> return Result.Err("accept_tls: " <> net_message(e))
    end

  outcome =
    match secured.read(16)
      Result.Ok(_) -> "client wrote"
      Result.Err(_) -> "client hung up"
    end

  match secured.close()
    _ -> ()
  end

  Result.Ok(outcome)
end

priv fn serve_tls_echo(listener: TCPListener, config: TLSConfig)
  -> Result<String, String>

  raw =
    match listener.accept()
      Result.Ok(s) -> s
      Result.Err(e) -> return Result.Err("accept: " <> e.message())
    end

  secured =
    match raw.accept_tls(config)
      Result.Ok(s) -> s
      Result.Err(e) -> return Result.Err("accept_tls: " <> net_message(e))
    end

  data =
    match secured.read_string(1024)
      Result.Ok(d) -> d
      Result.Err(e) -> return Result.Err("server read: " <> net_message(e))
    end

  match secured.write(data)
    Result.Err(e) -> return Result.Err("server write: " <> net_message(e))
    Result.Ok(_) -> ()
  end

  match secured.close()
    _ -> ()
  end

  Result.Ok(data)
end

priv fn net_message(e: IOError | TLSError | String.ConversionError) -> String
  match e
    io_error: IOError -> io_error.message()
    tls_error: TLSError -> tls_error.message()
    conversion: String.ConversionError -> "#{conversion}"
  end
end

priv fn read_test_certificate -> Result<Certificate, String>
  text =
    match File.read(TLS_TEST_CERT_PATH)
      Result.Ok(pem) -> pem
      Result.Err(e) -> return Result.Err("read cert fixture: #{e}")
    end

  match Certificate.parse(text)
    Result.Ok(c) -> Result.Ok(c)
    Result.Err(e) -> Result.Err("parse cert fixture: " <> e.message())
  end
end

priv fn server_test_config -> Result<TLSConfig, String>
  cert =
    match read_test_certificate()
      Result.Ok(c) -> c
      Result.Err(e) -> return Result.Err(e)
    end

  key_text =
    match File.read(TLS_TEST_KEY_PATH)
      Result.Ok(pem) -> pem
      Result.Err(e) -> return Result.Err("read key fixture: #{e}")
    end

  key =
    match PrivateKey.parse(key_text)
      Result.Ok(k) -> k
      Result.Err(e) -> return Result.Err("parse key fixture: " <> e.message())
    end

  Result.Ok(TLSConfig.server(cert, key))
end
