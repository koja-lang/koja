alias Net.Socket.Error as SocketError

@doc """
Why connection setup failed. Variants name causes, not operations.
The caller already knows which call failed, so these say why.

`Interrupted` means a system message such as a lifecycle event
arrived while the process waited. The caller must return to its run
loop so that message is handled, and must not retry the call first.
`Unknown` carries the raw OS errno for causes outside the mapped set.

Produced by `bind`, `listen`, `accept`, `connect`, and name
resolution on `TCPSocket`, `TCPListener`, and `UDPSocket`. Once a
connection is open, reads, writes, and `close` fail with `IO.Error`
instead. TLS handshakes can also fail with `TLSError`, so their
signatures return the union `Socket.Error | TLSError`.
"""
enum Socket.Error
  AddressInUse
  ConnectionAborted
  ConnectionRefused
  HostUnreachable
  Interrupted
  NameNotFound
  NetworkUnreachable
  PermissionDenied
  TimedOut
  Unknown(Int)

  @doc """
  Maps a runtime cause code to the connection cause it names, or
  `Option.None` when the code belongs to another domain. Mostly
  internal.
  """
  fn from_code(code: Int) -> Option<SocketError>
    # Mirrors `error_kind_code` in `crates/koja-runtime-posix/src/util.rs`.

    match code
      1 -> Option.Some(SocketError.AddressInUse)
      5 -> Option.Some(SocketError.ConnectionAborted)
      6 -> Option.Some(SocketError.ConnectionRefused)
      9 -> Option.Some(SocketError.HostUnreachable)
      10 -> Option.Some(SocketError.Interrupted)
      13 -> Option.Some(SocketError.NameNotFound)
      14 -> Option.Some(SocketError.NetworkUnreachable)
      17 -> Option.Some(SocketError.PermissionDenied)
      18 -> Option.Some(SocketError.TimedOut)
      _ -> Option.None
    end
  end

  @doc """
  Builds the error for the most recent failed runtime connection
  call. Mostly internal. Prefer matching returned errors.
  """
  fn last -> SocketError
    SocketError.from_code_or_unknown(koja_last_error_code())
  end

  @doc """
  Returns a human-readable description of the error.
  """
  fn message(self) -> String
    match self
      SocketError.AddressInUse -> "address already in use"
      SocketError.ConnectionAborted -> "connection aborted"
      SocketError.ConnectionRefused -> "connection refused"
      SocketError.HostUnreachable -> "host unreachable"
      SocketError.Interrupted -> "interrupted by a system message"
      SocketError.NameNotFound -> "hostname could not be resolved"
      SocketError.NetworkUnreachable -> "network unreachable"
      SocketError.PermissionDenied -> "permission denied"
      SocketError.TimedOut -> "operation timed out"
      SocketError.Unknown(errno) -> "socket error (errno #{errno})"
    end
  end

  priv fn from_code_or_unknown(code: Int) -> SocketError
    # Negative codes are raw OS errno values for unmapped causes.

    match SocketError.from_code(code)
      Option.Some(error) -> error
      Option.None -> SocketError.Unknown(code < 0 ? 0 - code : 0)
    end
  end

  @extern "C"
  priv fn koja_last_error_code -> Int32
end
