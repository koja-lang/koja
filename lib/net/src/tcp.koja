alias Fd.Interest
alias IO.Error as IOError
alias IO.Reader.Options as ReaderOptions
alias IO.Ready as IOReady
alias IO.Writer.Options as WriterOptions
alias Net.Socket.Address as SocketAddress
alias Net.Socket.Error as SocketError
alias Net.Socket.Kind as SocketKind
alias Net.TCPServer.Config as TCPServerConfig
alias Net.TCPServer.Event as TCPEvent
alias Net.TCPServer.Msg as TCPServerMsg
alias Process.Lifecycle
alias Process.Step
alias Process.StopReason

@doc """
A TCP connection for reading and writing byte streams. Use `connect` to
establish a client connection by hostname, or `connect_addr` to connect
to a specific `SocketAddress`. Server-side `TCPSocket` values are returned
by `TCPListener.accept`.

Connections can be secured with TLS. `connect_tls` establishes a
verified client connection, `upgrade_tls` and `accept_tls` perform
handshakes on an existing connection, and the reads, writes, and
`close` use the TLS session when one is active.

Reads and writes come from the `IO.Reader` and `IO.Writer`
conformances below, so `read` returns bytes and `read_string` and
`read_line` decode. Connection setup (`connect*`,
`TCPListener.accept`) fails with `SocketError`. Once connected, every
read and write fails with `IOError | TLSError`, the `TLSError` half for
a record the TLS layer rejected or a peer that left without a
`close_notify`, and `close` fails with `IOError`.

Every wait takes its bound per call. The reads take
`IO.Reader.Options`, `write` takes `IO.Writer.Options`, and the TLS
handshakes take a `timeout`. A wait that passes its limit fails with
`IOError.TimedOut`. `Option.None` waits without limit.
"""
struct TCPSocket
  socket: Socket
  tls: Option<TLSSession>

  @doc """
  Connects to a remote host by resolving the hostname via DNS and
  establishing a TCP connection to the first resolved address.
  Returns the connected socket or an error if resolution or
  connection fails. `timeout` bounds the TCP handshake only, not the
  DNS lookup.
  """
  fn connect(host: String, port: Int, timeout: Option<Duration> = Option.None)
    -> TCPSocket ! SocketError

    addrs = try Socket.resolve(host)

    if addrs.empty?()
      fail SocketError.NameNotFound
    end

    addr = addrs.get(0).unwrap()
    try TCPSocket.connect_addr(SocketAddress{ip: addr, port: port}, timeout)
  end

  @doc """
  Connects to a specific `SocketAddress` without DNS resolution.
  Returns the connected socket or an error if the connection fails.
  With a `timeout`, fails with `SocketError.TimedOut` once that much
  time passes with the handshake still pending.
  """
  fn connect_addr(addr: SocketAddress, timeout: Option<Duration> = Option.None)
    -> TCPSocket ! SocketError

    sock = try Socket.create(SocketKind.Stream)
    connected = try sock.connect(addr, timeout)
    TCPSocket{socket: connected, tls: Option.None}
  end

  @doc """
  Connects to a remote host and secures the connection with a verified
  TLS handshake (certificate chain and hostname are both checked).
  Equivalent to `connect` followed by `upgrade_tls` with the default
  client configuration. `timeout` bounds the TCP handshake and then,
  measured anew, the TLS handshake. Connection setup fails with
  `SocketError`, the TLS handshake with `IOError` or `TLSError`.
  """
  fn connect_tls(
    host: String,
    port: Int,
    timeout: Option<Duration> = Option.None,
  ) -> TCPSocket ! SocketError | IOError | TLSError

    try TCPSocket.connect_tls_with(host, port, TLSConfig.client(), timeout)
  end

  @doc """
  Connects to a remote host and secures the connection with a TLS
  handshake using the given configuration. Use `TLSConfig.insecure()`
  to skip certificate verification (testing only). `timeout` bounds
  the TCP handshake and then, measured anew, the TLS handshake.
  """
  fn connect_tls_with(
    host: String,
    port: Int,
    config: TLSConfig,
    timeout: Option<Duration> = Option.None,
  ) -> TCPSocket ! SocketError | IOError | TLSError

    socket = try TCPSocket.connect(host, port, timeout)
    try socket.upgrade_tls(host, config, timeout)
  end

  @doc """
  Performs a client-side TLS handshake on an established connection.
  `hostname` is sent for SNI and checked against the server certificate
  when verification is enabled. Returns the upgraded socket. `timeout`
  bounds the whole handshake, and a wait past it fails with
  `IOError.TimedOut`.
  """
  fn upgrade_tls(
    self,
    hostname: String,
    config: TLSConfig,
    timeout: Option<Duration> = Option.None,
  ) -> TCPSocket ! IOError | TLSError

    session = try TLSSession.connect(self.socket.fd, hostname, config, timeout)
    TCPSocket{socket: self.socket, tls: Option.Some(session)}
  end

  @doc """
  Performs a server-side TLS handshake on an accepted connection using
  the certificate and key from `config`. Returns the upgraded socket.
  `timeout` bounds the whole handshake, and a wait past it fails with
  `IOError.TimedOut`.
  """
  fn accept_tls(
    self,
    config: TLSConfig,
    timeout: Option<Duration> = Option.None,
  ) -> TCPSocket ! IOError | TLSError

    session = try TLSSession.accept(self.socket.fd, config, timeout)
    TCPSocket{socket: self.socket, tls: Option.Some(session)}
  end

  @doc """
  Returns true if the connection has an active TLS session.
  """
  fn tls?(self) -> Bool
    self.tls.some?()
  end

  @doc """
  Closes the TCP connection, shutting down the TLS session first when
  one is active.
  """
  fn close(self) ! IOError
    match self.tls
      Option.Some(session) -> session.shutdown()
      Option.None -> ()
    end

    try self.socket.close()
  end
end

impl IO.Reader<IOError | TLSError> for TCPSocket
  @doc """
  Reads up to `count` bytes from the connection. Returns an empty
  binary at end of stream. Fails with `IOError.TimedOut` when
  `options.timeout` passes with no data.
  """
  fn read(self, count: Int, options: ReaderOptions)
    -> Binary ! IOError | TLSError

    match self.tls
      Option.Some(session) ->
        try session.read(self.socket.fd, count, options.timeout)
      Option.None -> try self.socket.fd.read(count, options)
    end
  end
end

impl IO.Writer<IOError | TLSError> for TCPSocket
  @doc """
  Writes data to the connection. Accepts either a `String` (encoded as
  UTF-8) or a `Binary` for raw wire protocols. Returns the number of
  bytes written. Fails with `IOError.TimedOut` when `options.timeout`
  passes with the connection still not writable. Some bytes may
  already be written.
  """
  fn write(self, data: Binary | String, options: WriterOptions)
    -> Int ! IOError | TLSError

    match self.tls
      Option.Some(session) ->
        try session.write(self.socket.fd, data, options.timeout)
      Option.None -> try self.socket.fd.write(data, options)
    end
  end
end

@doc """
A TCP listener that accepts incoming connections on a bound port.
Use `bind` to listen on all interfaces at a given port, or `bind_addr`
to listen on a specific address. Each call to `accept` returns a
`TCPSocket` for the new client connection.
"""
struct TCPListener
  socket: Socket

  @doc """
  Binds to the given port on all interfaces (0.0.0.0), sets
  `SO_REUSEADDR`, and starts listening with a backlog of 128.
  Returns the listener or an error if any step fails.
  """
  fn bind(port: Int) -> TCPListener ! SocketError
    try TCPListener.bind_addr(SocketAddress{ip: IPAddress.ANY, port: port})
  end

  @doc """
  Binds to a specific `SocketAddress`, sets `SO_REUSEADDR`, and
  starts listening with a backlog of 128. Returns the listener or
  an error if any step fails.
  """
  fn bind_addr(addr: SocketAddress) -> TCPListener ! SocketError
    sock = try Socket.create(SocketKind.Stream)
    sock = try sock.set_reuse_addr()
    sock = try sock.bind(addr)
    sock = try sock.listen(128)
    TCPListener{socket: sock}
  end

  @doc """
  Accepts an incoming TCP connection. Blocks until a client connects,
  or fails with `SocketError.TimedOut` once `timeout` passes.
  `Option.None` waits without limit, and `Duration.ZERO` polls, so a
  pending connection returns at once and an empty backlog fails with
  `TimedOut` without waiting. Returns a `TCPSocket` for the new
  connection, or an error if the accept fails.
  """
  fn accept(self, timeout: Option<Duration> = Option.None)
    -> TCPSocket ! SocketError

    fd = try self.socket.accept(timeout)
    TCPSocket{socket: Socket{fd: fd}, tls: Option.None}
  end

  @doc """
  Returns the underlying file descriptor, for `Fd.watch` and `Fd.block`.
  """
  fn fd(self) -> Fd
    self.socket.fd
  end

  @doc """
  Closes the listener and stops accepting new connections.
  """
  fn close(self) ! IOError
    try self.socket.close()
  end
end

@doc """
Events delivered to a process that spawns a `TCPServer`.
"""
enum TCPServer.Event
  Connected(TCPSocket)
  Closed(Fd)
  Error(SocketError)
end

@doc """
Configuration for spawning a `TCPServer`.
`owner` is the process that receives `TCPServer.Event` messages.
"""
struct TCPServer.Config
  port: Int
  owner: Ref<TCPEvent, String>
end

@doc """
An actor that listens for TCP connections and delivers `TCPEvent`
messages to its owner process. Uses `IOReady` internally to avoid
blocking on accept.

Spawn with:
```
me: Ref<TCPEvent, String> = Ref.self_ref()
server = spawn TCPServer.start(TCPServerConfig{port: 4000, owner: me})
```
"""
struct TCPServer
  listener: TCPListener
  owner: Ref<TCPEvent, String>
end

@doc """
Messages a `TCPServer` accepts. `AcceptReady` asks the server to
accept every pending connection now instead of waiting for the next
`IOReady` wakeup.
"""
enum TCPServer.Msg
  AcceptReady
end

impl Process<TCPServerConfig, TCPServerMsg | IOReady, String> for TCPServer
  fn start(config: TCPServerConfig) -> Self ! StopReason
    match TCPListener.bind(config.port)
      Result.Ok(listener) ->
        listener.fd().watch(Interest.Readable)
        TCPServer{listener: listener, owner: config.owner}

      Result.Err(e) ->
        config.owner.cast(TCPEvent.Error(e))
        fail StopReason.Shutdown
    end
  end

  fn handle(self, msg: TCPServerMsg | IOReady, from: Option<ReplyTo<String>>)
    -> Step<Self>

    match msg
      io: IOReady ->
        self.on_io_ready(io)

      cmd: TCPServerMsg ->
        match cmd
          TCPServerMsg.AcceptReady -> self.drain_accepts()
        end
    end
  end

  fn handle_signal(self, signal: Lifecycle) -> Step<Self>
    match signal
      Lifecycle.Shutdown ->
        match self.listener.close()
          _ -> ()
        end

        Step.Done(StopReason.Shutdown)

      Lifecycle.Interrupt ->
        match self.listener.close()
          _ -> ()
        end

        Step.Done(StopReason.Shutdown)

      _ ->
        Step.Continue(self)
    end
  end
end

extend TCPServer
  priv fn on_io_ready(self, io: IOReady) -> Step<Self>
    match io
      IOReady.Read(_) ->
        self.drain_accepts()

      IOReady.Error(_) ->
        self.owner.cast(TCPEvent.Error(SocketError.last()))
        Step.Done(StopReason.Shutdown)

      _ ->
        self.listener.fd().watch(Interest.Readable)
        Step.Continue(self)
    end
  end

  # Accepts every pending connection, then arms the listener for the
  # next wakeup. A zero bound makes `accept` a poll, so `TimedOut`
  # means the backlog is empty. Any other error goes to the owner and
  # the listener stays up.
  priv fn drain_accepts(self) -> Step<Self>
    match self.listener.accept(Option.Some(Duration.ZERO))
      Result.Ok(client) ->
        self.owner.cast(TCPEvent.Connected(client))
        self.drain_accepts()

      Result.Err(SocketError.TimedOut) ->
        self.listener.fd().watch(Interest.Readable)
        Step.Continue(self)

      Result.Err(e) ->
        self.owner.cast(TCPEvent.Error(e))
        self.listener.fd().watch(Interest.Readable)
        Step.Continue(self)
    end
  end
end
