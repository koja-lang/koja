alias IO.Error as IOError
alias IO.Ready as IOReady
alias Net.Socket.Address as SocketAddress
alias Net.Socket.Error as SocketError
alias Net.Socket.Kind as SocketKind
alias Net.TCPServer.Config as TCPServerConfig
alias Net.TCPServer.Event as TCPEvent
alias Net.TCPServer.Msg as TCPServerMsg
alias Process.Lifecycle
alias Process.Step
alias Process.StopReason

@doc """
A TCP connection for reading and writing byte streams. Use `connect` to
establish a client connection by hostname, or `connect_addr` to connect
to a specific `SocketAddress`. Server-side `TCPSocket` values are returned
by `TCPListener.accept`.

Connections can be secured with TLS: `connect_tls` establishes a verified
client connection, `upgrade_tls` / `accept_tls` perform handshakes on an
existing connection, and `read`/`write`/`close` transparently use the TLS
session when one is active.

Connection setup (`connect*`, `TCPListener.accept`) fails with
`SocketError`. Once connected, `read`, `read_binary`, `write`, and
`close` fail with `IOError`, and TLS adds `TLSError` to the union.

`read_timeout` and `write_timeout` bound each read and write. A wait
that passes its limit fails with `IOError.TimedOut`. `Option.None`
waits without limit. Set them with `with_read_timeout` and
`with_write_timeout`, or through `TCPListener.Options` for accepted
connections.
"""
struct TCPSocket
  socket: Socket
  tls: Option<TLSSession>
  read_timeout: Option<Duration> = Option.None
  write_timeout: Option<Duration> = Option.None

  @doc """
  Connects to a remote host by resolving the hostname via DNS and
  establishing a TCP connection to the first resolved address.
  Returns the connected socket or an error if resolution or
  connection fails. `timeout` bounds the TCP handshake only, not the
  DNS lookup.
  """
  fn connect(host: String, port: Int, timeout: Option<Duration> = Option.None)
    -> TCPSocket ! SocketError

    addrs = try Socket.resolve(host)

    if addrs.empty?()
      fail SocketError.NameNotFound
    end

    addr = addrs.get(0).unwrap()
    try TCPSocket.connect_addr(SocketAddress{ip: addr, port: port}, timeout)
  end

  @doc """
  Connects to a specific `SocketAddress` without DNS resolution.
  Returns the connected socket or an error if the connection fails.
  With a `timeout`, fails with `SocketError.TimedOut` once that much
  time passes with the handshake still pending.
  """
  fn connect_addr(addr: SocketAddress, timeout: Option<Duration> = Option.None)
    -> TCPSocket ! SocketError

    sock = try Socket.create(SocketKind.Stream)
    connected = try sock.connect(addr, timeout)
    TCPSocket{socket: connected, tls: Option.None}
  end

  @doc """
  Connects to a remote host and secures the connection with a verified
  TLS handshake (certificate chain and hostname are both checked).
  Equivalent to `connect` followed by `upgrade_tls` with the default
  client configuration. `timeout` bounds the TCP handshake only.
  Connection setup fails with `SocketError`, the TLS handshake with
  `IOError` or `TLSError`.
  """
  fn connect_tls(
    host: String,
    port: Int,
    timeout: Option<Duration> = Option.None,
  ) -> TCPSocket ! SocketError | IOError | TLSError

    try TCPSocket.connect_tls_with(host, port, TLSConfig.client(), timeout)
  end

  @doc """
  Connects to a remote host and secures the connection with a TLS
  handshake using the given configuration. Use `TLSConfig.insecure()`
  to skip certificate verification (testing only). `timeout` bounds
  the TCP handshake only.
  """
  fn connect_tls_with(
    host: String,
    port: Int,
    config: TLSConfig,
    timeout: Option<Duration> = Option.None,
  ) -> TCPSocket ! SocketError | IOError | TLSError

    socket = try TCPSocket.connect(host, port, timeout)
    try socket.upgrade_tls(host, config)
  end

  @doc """
  Performs a client-side TLS handshake on an established connection.
  `hostname` is sent for SNI and checked against the server certificate
  when verification is enabled. Returns the upgraded socket. The
  handshake waits are bounded by `read_timeout` and `write_timeout`.
  """
  fn upgrade_tls(self, hostname: String, config: TLSConfig)
    -> TCPSocket ! IOError | TLSError

    session = try TLSSession.connect(
      self.socket.fd,
      hostname,
      config,
      self.read_timeout,
      self.write_timeout,
    )
    TCPSocket{
      socket: self.socket,
      tls: Option.Some(session),
      read_timeout: self.read_timeout,
      write_timeout: self.write_timeout,
    }
  end

  @doc """
  Performs a server-side TLS handshake on an accepted connection using
  the certificate and key from `config`. Returns the upgraded socket.
  The handshake waits are bounded by `read_timeout` and `write_timeout`.
  """
  fn accept_tls(self, config: TLSConfig) -> TCPSocket ! IOError | TLSError
    session = try TLSSession.accept(
      self.socket.fd,
      config,
      self.read_timeout,
      self.write_timeout,
    )
    TCPSocket{
      socket: self.socket,
      tls: Option.Some(session),
      read_timeout: self.read_timeout,
      write_timeout: self.write_timeout,
    }
  end

  @doc """
  Returns true if the connection has an active TLS session.
  """
  fn tls?(self) -> Bool
    self.tls.some?()
  end

  @doc """
  Returns a copy of the connection whose reads wait at most `limit`.
  `Option.None` removes the limit.
  """
  fn with_read_timeout(self, limit: Option<Duration>) -> TCPSocket
    TCPSocket{
      socket: self.socket,
      tls: self.tls,
      read_timeout: limit,
      write_timeout: self.write_timeout,
    }
  end

  @doc """
  Returns a copy of the connection whose writes wait at most `limit`.
  `Option.None` removes the limit.
  """
  fn with_write_timeout(self, limit: Option<Duration>) -> TCPSocket
    TCPSocket{
      socket: self.socket,
      tls: self.tls,
      read_timeout: self.read_timeout,
      write_timeout: limit,
    }
  end

  @doc """
  Reads up to `count` bytes from the connection. Returns the data
  as a string or an error if the read fails. Fails with
  `IOError.TimedOut` when `read_timeout` passes with no data, and
  with `String.ConversionError.InvalidUTF8` when the bytes are not
  UTF-8.
  """
  fn read(self, count: Int)
    -> String ! IOError | TLSError | String.ConversionError

    bytes = try self.read_binary(count)
    try bytes.to_string()
  end

  @doc """
  Reads up to `count` raw bytes from the connection. Suitable for
  binary protocols where the data is not UTF-8 text. Returns the bytes
  or an error if the read fails. Fails with `IOError.TimedOut`
  when `read_timeout` passes with no data.
  """
  fn read_binary(self, count: Int) -> Binary ! IOError | TLSError
    match self.tls
      Option.Some(session) ->
        try session.read_binary(self.socket.fd, count, self.read_timeout)
      Option.None -> try self.socket.fd.read_binary(count, self.read_timeout)
    end
  end

  @doc """
  Writes data to the connection. Accepts either a `String` (encoded as
  UTF-8) or a `Binary` for raw wire protocols. Returns the number of
  bytes written or an error if the write fails. Fails with
  `IOError.TimedOut` when `write_timeout` passes with the
  connection still not writable. Some bytes may already be written.
  """
  fn write(self, data: Binary | String) -> Int ! IOError | TLSError
    match self.tls
      Option.Some(session) ->
        try session.write(self.socket.fd, data, self.write_timeout)
      Option.None -> try self.socket.fd.write(data, self.write_timeout)
    end
  end

  @doc """
  Closes the TCP connection, shutting down the TLS session first when
  one is active.
  """
  fn close(self) ! IOError
    match self.tls
      Option.Some(session) -> session.shutdown()
      Option.None -> ()
    end

    try self.socket.close()
  end
end

@doc """
Timeouts for a `TCPListener`. `accept_timeout` bounds each `accept`.
`read_timeout` and `write_timeout` are copied onto every accepted
`TCPSocket`. `Option.None` waits without limit.
"""
struct TCPListener.Options
  read_timeout: Option<Duration> = Option.None
  write_timeout: Option<Duration> = Option.None
  accept_timeout: Option<Duration> = Option.None
end

@doc """
A TCP listener that accepts incoming connections on a bound port.
Use `bind` to listen on all interfaces at a given port, or `bind_addr`
to listen on a specific address. Each call to `accept` returns a
`TCPSocket` for the new client connection.
"""
struct TCPListener
  socket: Socket
  options: TCPListener.Options = TCPListener.Options{}

  @doc """
  Binds to the given port on all interfaces (0.0.0.0), sets
  `SO_REUSEADDR`, and starts listening with a backlog of 128.
  Returns the listener or an error if any step fails. `options`
  sets the accept timeout and the timeouts of accepted connections.
  """
  fn bind(port: Int, options: TCPListener.Options = TCPListener.Options{})
    -> TCPListener ! SocketError

    try TCPListener.bind_addr(
      SocketAddress{ip: IPAddress.ANY, port: port},
      options,
    )
  end

  @doc """
  Binds to a specific `SocketAddress`, sets `SO_REUSEADDR`, and
  starts listening with a backlog of 128. Returns the listener or
  an error if any step fails. `options` sets the accept timeout and
  the timeouts of accepted connections.
  """
  fn bind_addr(
    addr: SocketAddress,
    options: TCPListener.Options = TCPListener.Options{},
  ) -> TCPListener ! SocketError

    sock = try Socket.create(SocketKind.Stream)
    sock = try sock.set_reuse_addr()
    sock = try sock.bind(addr)
    sock = try sock.listen(128)
    TCPListener{socket: sock, options: options}
  end

  @doc """
  Accepts an incoming TCP connection. Blocks until a client connects,
  or fails with `SocketError.TimedOut` once `accept_timeout` passes.
  Returns a `TCPSocket` for the new connection, carrying the
  listener's `read_timeout` and `write_timeout`, or an error if the
  accept fails.
  """
  fn accept(self) -> TCPSocket ! SocketError
    fd = try self.socket.accept(self.options.accept_timeout)
    TCPSocket{
      socket: Socket{fd: fd},
      tls: Option.None,
      read_timeout: self.options.read_timeout,
      write_timeout: self.options.write_timeout,
    }
  end

  @doc """
  Non-blocking accept: returns `Option.Some(socket)` if a connection is
  immediately available, or `Option.None` if no connection is pending.
  """
  fn try_accept(self) -> Option<TCPSocket>
    raw = self.socket.try_accept_raw()

    if raw >= 0
      Option.Some(TCPSocket{
        socket: Socket{fd: Fd{descriptor: raw}},
        tls: Option.None,
        read_timeout: self.options.read_timeout,
        write_timeout: self.options.write_timeout,
      })
    else
      Option.None
    end
  end

  @doc """
  Returns the underlying file descriptor for use with `Fd.watch`.
  """
  fn fd(self) -> Fd
    self.socket.fd
  end

  @doc """
  Closes the listener and stops accepting new connections.
  """
  fn close(self) ! IOError
    try self.socket.close()
  end
end

@doc """
Events delivered to a process that spawns a `TCPServer`.
"""
enum TCPServer.Event
  Connected(TCPSocket)
  Closed(Fd)
  Error(SocketError)
end

@doc """
Configuration for spawning a `TCPServer`.
`owner` is the process that receives `TCPServer.Event` messages.
"""
struct TCPServer.Config
  port: Int
  owner: Ref<TCPEvent, String>
end

@doc """
An actor that listens for TCP connections and delivers `TCPEvent`
messages to its owner process. Uses `IOReady` internally to avoid
blocking on accept.

Spawn with:
```
me: Ref<TCPEvent, String> = Ref.self_ref()
server = spawn TCPServer.start(TCPServerConfig{port: 4000, owner: me})
```
"""
struct TCPServer
  listener: TCPListener
  owner: Ref<TCPEvent, String>
end

@doc """
Messages a `TCPServer` accepts. `AcceptReady` asks the server to
accept every pending connection now instead of waiting for the next
`IOReady` wakeup.
"""
enum TCPServer.Msg
  AcceptReady
end

impl Process<TCPServerConfig, TCPServerMsg | IOReady, String> for TCPServer
  fn start(config: TCPServerConfig) -> Self ! StopReason
    match TCPListener.bind(config.port)
      Result.Ok(listener) ->
        listener.fd().watch(0)
        TCPServer{listener: listener, owner: config.owner}

      Result.Err(e) ->
        config.owner.cast(TCPEvent.Error(e))
        fail StopReason.Shutdown
    end
  end

  fn handle(self, msg: TCPServerMsg | IOReady, from: Option<ReplyTo<String>>)
    -> Step<Self>

    match msg
      io: IOReady ->
        self.on_io_ready(io)

      cmd: TCPServerMsg ->
        match cmd
          TCPServerMsg.AcceptReady -> self.drain_accepts()
        end
    end
  end

  fn handle_signal(self, signal: Lifecycle) -> Step<Self>
    match signal
      Lifecycle.Shutdown ->
        match self.listener.close()
          _ -> ()
        end

        Step.Done(StopReason.Shutdown)

      Lifecycle.Interrupt ->
        match self.listener.close()
          _ -> ()
        end

        Step.Done(StopReason.Shutdown)

      _ ->
        Step.Continue(self)
    end
  end
end

extend TCPServer
  priv fn on_io_ready(self, io: IOReady) -> Step<Self>
    match io
      IOReady.Read(_) ->
        self.drain_accepts()

      IOReady.Error(_) ->
        self.owner.cast(TCPEvent.Error(SocketError.last()))
        Step.Done(StopReason.Shutdown)

      _ ->
        self.listener.fd().watch(0)
        Step.Continue(self)
    end
  end

  priv fn drain_accepts(self) -> Step<Self>
    match self.listener.try_accept()
      Option.Some(client) ->
        self.owner.cast(TCPEvent.Connected(client))
        self.drain_accepts()

      Option.None ->
        self.listener.fd().watch(0)
        Step.Continue(self)
    end
  end
end
