alias Net.Socket.Address as SocketAddress
alias Net.Socket.Error as SocketError
alias Net.Socket.Kind as SocketKind

@doc """
A UDP socket for sending and receiving datagrams. UDP is connectionless --
the same socket can send to and receive from any address. Use `bind` to
listen on a port, or bind to port 0 for an ephemeral port.
"""
struct UDPSocket
  socket: Socket

  @doc """
  Binds to the given port on all interfaces (0.0.0.0). Use port 0
  to let the OS assign an ephemeral port. Returns the bound socket
  or an error if the bind fails.
  """
  fn bind(port: Int) -> UDPSocket ! SocketError
    try UDPSocket.bind_addr(SocketAddress{ip: IPAddress.any(), port: port})
  end

  @doc """
  Binds to a specific `SocketAddress`. Returns the bound socket or
  an error if the bind fails.
  """
  fn bind_addr(addr: SocketAddress) -> UDPSocket ! SocketError
    sock = Socket.create(SocketKind.Datagram)
      rescue _ -> fail SocketError.last()
    bound = sock.bind(addr) rescue _ -> fail SocketError.last()
    UDPSocket{socket: bound}
  end

  @doc """
  Sends data to the given address. Returns the number of bytes
  sent or an error if the send fails.
  """
  fn send_to(self, data: Binary | String, addr: SocketAddress)
    -> Int
    ! SocketError

    self.socket.send_to(data, addr) rescue _ -> fail SocketError.last()
  end

  @doc """
  Receives up to `count` bytes. Returns a tuple of the received data
  and the sender's address, or an error if the receive fails.
  """
  fn recv_from(self, count: Int) -> (Binary, SocketAddress) ! SocketError
    self.socket.recv_from(count) rescue _ -> fail SocketError.last()
  end

  @doc """
  Closes the UDP socket.
  """
  fn close(self) -> Bool ! SocketError
    self.socket.close() rescue _ -> fail SocketError.last()
    true
  end
end
