alias IO.Error as IOError
alias Net.Socket.Address as SocketAddress
alias Net.Socket.Error as SocketError
alias Net.Socket.Kind as SocketKind

@doc """
The kind of socket: `Stream` (TCP) or `Datagram` (UDP).
"""
enum Socket.Kind
  Datagram
  Stream
end

@doc """
An IP address paired with a port number.
"""
struct Socket.Address
  ip: IPAddress
  port: Int
end

@doc """
POSIX socket for TCP/UDP network I/O.
"""
struct Socket
  descriptor: IO.Descriptor

  @doc """
  Accepts an incoming connection. Returns the client file descriptor.
  With a `timeout`, fails with `SocketError.TimedOut` once that much
  time passes with no client.
  """
  fn accept(self, timeout: Option<Duration> = Option.None)
    -> IO.Descriptor ! SocketError

    client_fd = koja_socket_accept(self.descriptor.raw, timeout_ms(timeout))

    if client_fd == -1
      fail SocketError.last()
    end

    IO.Descriptor{raw: client_fd}
  end

  @doc """
  Binds the socket to the given address and port.
  """
  fn bind(self, addr: SocketAddress) -> Socket ! SocketError
    result = koja_socket_bind(
      self.descriptor.raw,
      CPtr.borrow(addr.ip.bytes),
      addr.ip.bytes.byte_size(),
      addr.port,
    )

    if result == -1
      fail SocketError.last()
    end

    self
  end

  @doc """
  Closes the socket.
  """
  fn close(self) ! IOError
    try self.descriptor.close()
  end

  @doc """
  Connects the socket to the given address and port. With a `timeout`,
  fails with `SocketError.TimedOut` once that much time passes with
  the handshake still pending.
  """
  fn connect(self, addr: SocketAddress, timeout: Option<Duration> = Option.None)
    -> Socket ! SocketError

    result = koja_socket_connect(
      self.descriptor.raw,
      CPtr.borrow(addr.ip.bytes),
      addr.ip.bytes.byte_size(),
      addr.port,
      timeout_ms(timeout),
    )

    if result == -1
      fail SocketError.last()
    end

    self
  end

  @doc """
  Creates a socket of the given kind (Stream or Datagram).
  """
  fn create(kind: SocketKind) -> Socket ! SocketError
    sock_type =
      match kind
        SocketKind.Stream -> 1
        SocketKind.Datagram -> 2
      end

    fd = koja_socket_create(sock_type)

    if fd == -1
      fail SocketError.last()
    end

    Socket{descriptor: IO.Descriptor{raw: fd}}
  end

  @doc """
  Starts listening for incoming connections with the given backlog.
  """
  fn listen(self, backlog: Int) -> Socket ! SocketError
    result = koja_socket_listen(self.descriptor.raw, backlog)

    if result == -1
      fail SocketError.last()
    end

    self
  end

  @doc """
  Receives data and the sender's address (for unconnected datagram sockets).
  Returns a tuple of the data and sender address.
  """
  fn recv_from(self, count: Int) -> (Binary, SocketAddress) ! SocketError
    (data, ip_bytes, port) = self.recv_from_raw(count)
      rescue _ -> fail SocketError.last()
    (data, SocketAddress{ip: ip_address_from_bytes(ip_bytes), port: port})
  end

  @doc """
  Resolves a hostname to a list of IP addresses via DNS. Fails with
  `SocketError.NameNotFound` when the name does not resolve.
  """
  fn resolve(hostname: String) -> List<IPAddress> ! SocketError
    addresses = Socket.resolve_raw(hostname) rescue _ -> fail SocketError.last()
    addresses.map(bytes -> ip_address_from_bytes(bytes))
  end

  @doc """
  Sends data to the given address (for unconnected datagram sockets).
  Returns the number of bytes sent.
  """
  fn send_to(self, data: Binary | String, addr: SocketAddress)
    -> Int ! SocketError

    bytes =
      match data
        binary: Binary -> binary
        string: String -> string.to_binary()
      end

    result = koja_socket_send_to(
      self.descriptor.raw,
      CPtr.borrow(bytes),
      bytes.byte_size(),
      CPtr.borrow(addr.ip.bytes),
      addr.ip.bytes.byte_size(),
      addr.port,
    )

    if result == -1
      fail SocketError.last()
    end

    result
  end

  @doc """
  Sets the SO_REUSEADDR option on the socket.
  """
  fn set_reuse_addr(self) -> Socket ! SocketError
    result = koja_socket_setsockopt_reuse(self.descriptor.raw)

    if result == -1
      fail SocketError.last()
    end

    self
  end

  priv fn timeout_ms(timeout: Option<Duration>) -> Int
    match timeout
      Option.None -> -1
      Option.Some(duration) -> duration.to_milliseconds()
    end
  end

  @intrinsic
  priv fn last_error -> String

  @intrinsic
  priv fn recv_from_raw(self, count: Int) -> (Binary, Binary, Int) ! String

  @intrinsic
  priv fn resolve_raw(hostname: String) -> List<Binary> ! String

  @extern "C"
  priv fn koja_socket_accept(fd: Int32, timeout_ms: Int64) -> Int32

  @extern "C"
  priv fn koja_socket_bind(
    fd: Int32,
    ip: CPtr<UInt8>,
    ip_length: Int64,
    port: Int64,
  ) -> Int64

  @extern "C"
  priv fn koja_socket_connect(
    fd: Int32,
    ip: CPtr<UInt8>,
    ip_length: Int64,
    port: Int64,
    timeout_ms: Int64,
  ) -> Int64

  @extern "C"
  priv fn koja_socket_create(kind: Int64) -> Int32

  @extern "C"
  priv fn koja_socket_listen(fd: Int32, backlog: Int64) -> Int64

  @extern "C"
  priv fn koja_socket_send_to(
    fd: Int32,
    data: CPtr<UInt8>,
    data_length: Int64,
    ip: CPtr<UInt8>,
    ip_length: Int64,
    port: Int64,
  ) -> Int64

  @extern "C"
  priv fn koja_socket_setsockopt_reuse(fd: Int32) -> Int64
end
