@doc """
How one spec ended. Every variant carries the time the spec ran for.

  - `Passed` is a body that returned `Result.Ok`.
  - `Failed` is a body that returned `Result.Err`. The `Failure` inside
    says whether it was an assertion, an error, or a skip.
  - `Crashed` is a body whose process died before it returned. The
    string is the panic message, followed by the backtrace when the
    runtime has one.
  - `TimedOut` is a body that was still running at its deadline. The
    `Duration` is the deadline.
"""
enum Outcome
  Crashed(String, Duration)
  Failed(Failure, Duration)
  Passed(Duration)
  TimedOut(Duration)

  @doc """
  The time the spec ran for.
  """
  fn elapsed(self) -> Duration
    match self
      Outcome.Crashed(_, elapsed) -> elapsed
      Outcome.Failed(_, elapsed) -> elapsed
      Outcome.Passed(elapsed) -> elapsed
      Outcome.TimedOut(elapsed) -> elapsed
    end
  end

  @doc """
  `true` only for `Passed`.
  """
  fn ok?(self) -> Bool
    match self
      Outcome.Passed(_) -> true
      _ -> false
    end
  end

  @doc """
  `true` when the body ended with `Failure.Skipped`.
  """
  fn skipped?(self) -> Bool
    match self
      Outcome.Failed(Failure.Skipped(_), _) -> true
      _ -> false
    end
  end
end
