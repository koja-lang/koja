alias JSON.Value

@doc """
The machine reporter. Writes one JSON object per line to stderr, or
to the `--out` file, so a spec that prints to stdout cannot corrupt
the stream. The event shapes are part of the `Test` package's public
surface.

```
{"event":"started","total":13}
{"event":"spec_started","id":"test/stack_test.koja:14","group":"StackTest","description":"pops in reverse order"}
{"event":"spec_finished","id":"test/stack_test.koja:14","outcome":"passed","microseconds":3120}
{"event":"spec_finished","id":"test/stack_test.koja:22","outcome":"failed","microseconds":1045,"failure":{"kind":"assertion",...}}
{"event":"spec_finished","id":"test/stack_test.koja:30","outcome":"crashed","microseconds":12400,"reason":"index 5 out of bounds"}
{"event":"spec_finished","id":"test/stack_test.koja:38","outcome":"skipped","microseconds":18,"reason":"DATABASE_URL is not set"}
{"event":"spec_finished","id":"test/stack_test.koja:46","outcome":"timed_out","microseconds":60000000}
{"event":"finished","passed":10,"failed":2,"skipped":1,"crashed":0,"timed_out":0,"microseconds":75211}
```

`microseconds` is the time the spec ran for, or the deadline for a
`timed_out` spec. It is an integer so the value survives every JSON
parser exactly. The `failure` object has a `kind` of `assertion`, with `expression`,
`file`, `line`, `column`, `source_line`, `left`, `right`, and
`message`, or a `kind` of `error` with `message`. A skip is its own
`outcome` value because CI counts skips apart from failures.
"""
struct JsonReporter
  sink: JsonReporter.Sink

  @doc """
  Opens the `--out` file when `options.out` is set, otherwise writes
  to stderr. A file that cannot be opened falls back to stderr with
  one warning.
  """
  fn new(options: Options) -> JsonReporter
    match options.out
      Option.Some(path) ->
        match File.open(path, File.Mode.Write)
          Result.Ok(fd) ->
            JsonReporter{sink: JsonReporter.Sink.File(fd)}

          Result.Err(e) ->
            IO.warn(
              "koja test: cannot open #{path} (#{e.message()}), writing events to stderr",
            )
            JsonReporter{sink: JsonReporter.Sink.Stderr}
        end

      Option.None ->
        JsonReporter{sink: JsonReporter.Sink.Stderr}
    end
  end

  @doc """
  The `started` event for `plan`.
  """
  fn started_event(plan: Plan) -> Value
    ["event": "started", "total": plan.total().to_json()]
  end

  @doc """
  The `spec_started` event for `spec`.
  """
  fn spec_started_event(spec: Spec) -> Value
    [
      "event": "spec_started",
      "id": spec.id(),
      "group": spec.group,
      "description": spec.description
    ]
  end

  @doc """
  The `spec_finished` event for `spec` and `outcome`.
  """
  fn spec_finished_event(spec: Spec, outcome: Outcome) -> Value
    head: List<(String, Value)> = [
      ("event", "spec_finished"),
      ("id", spec.id()),
      ("outcome", JsonReporter.outcome_name(outcome)),
      ("microseconds", outcome.elapsed().to_microseconds().to_json())
    ]

    tail: List<(String, Value)> =
      match outcome
        Outcome.Passed(_) -> []
        Outcome.TimedOut(_) -> []
        Outcome.Crashed(reason, _) -> [("reason", reason)]
        Outcome.Failed(Failure.Skipped(reason), _) -> [("reason", reason)]
        Outcome.Failed(failure, _) ->
          [("failure", JsonReporter.failure_value(failure))]
      end

    JSON.Object{entries: head.concat(tail)}
  end

  @doc """
  The `finished` event for `summary`.
  """
  fn finished_event(summary: Summary) -> Value
    [
      "event": "finished",
      "passed": summary.passed.to_json(),
      "failed": summary.failed.to_json(),
      "skipped": summary.skipped.to_json(),
      "crashed": summary.crashed.to_json(),
      "timed_out": summary.timed_out.to_json(),
      "microseconds": summary.elapsed.to_microseconds().to_json()
    ]
  end

  priv fn outcome_name(outcome: Outcome) -> String
    match outcome
      Outcome.Passed(_) -> "passed"
      Outcome.Failed(Failure.Skipped(_), _) -> "skipped"
      Outcome.Failed(_, _) -> "failed"
      Outcome.Crashed(_, _) -> "crashed"
      Outcome.TimedOut(_) -> "timed_out"
    end
  end

  priv fn failure_value(failure: Failure) -> Value
    match failure
      Failure.Assertion(assertion) ->
        [
          "kind": "assertion",
          "expression": assertion.expression,
          "file": assertion.file,
          "line": assertion.line.to_json(),
          "column": assertion.column.to_json(),
          "source_line": assertion.source_line,
          "left": JsonReporter.optional(assertion.left),
          "right": JsonReporter.optional(assertion.right),
          "message": JsonReporter.optional(assertion.message)
        ]
      Failure.Error(message) -> ["kind": "error", "message": message]
      Failure.Skipped(reason) -> ["kind": "skipped", "message": reason]
    end
  end

  priv fn optional(text: Option<String>) -> Value
    match text
      Option.Some(value) -> value.to_json()
      Option.None -> JSON.NULL.to_json()
    end
  end

  priv fn emit(self, value: Value)
    line = JSON.encode(value)

    match self.sink
      JsonReporter.Sink.Stderr -> IO.warn(line)
      JsonReporter.Sink.File(fd) -> _ = fd.write(line <> "\n")
    end
  end
end

@doc """
Where the JSON lines go. `File` carries the descriptor `File.open`
returned for the `--out` path.
"""
enum JsonReporter.Sink
  File(IO.Descriptor)
  Stderr
end

impl Reporter for JsonReporter
  fn started(self, plan: Plan) -> Self
    self.emit(JsonReporter.started_event(plan))
    self
  end

  fn spec_started(self, spec: Spec) -> Self
    self.emit(JsonReporter.spec_started_event(spec))
    self
  end

  fn spec_finished(self, spec: Spec, outcome: Outcome) -> Self
    self.emit(JsonReporter.spec_finished_event(spec, outcome))
    self
  end

  fn finished(self, summary: Summary) -> Self
    self.emit(JsonReporter.finished_event(summary))

    match self.sink
      JsonReporter.Sink.File(fd) -> _ = fd.close()
      JsonReporter.Sink.Stderr -> ()
    end

    self
  end
end
