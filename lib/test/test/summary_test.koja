struct SummaryTest
  priv fn ms(milliseconds: Int) -> Duration
    Duration.from_milliseconds(milliseconds)
  end

  test "an empty summary is ok"
    assert Summary{}.ok?()
    assert Summary{}.total() == 0
    assert Summary{}.elapsed.zero?()
  end

  test "record counts each outcome kind and sums the time"
    summary = Summary{}
      .record(Outcome.Passed(SummaryTest.ms(3)))
      .record(Outcome.Failed(Failure.Error("boom"), SummaryTest.ms(1)))
      .record(
        Outcome.Failed(Failure.Skipped("no db"), Duration.from_microseconds(18)),
      )
      .record(Outcome.Crashed("index out of bounds", SummaryTest.ms(12)))
      .record(Outcome.TimedOut(SummaryTest.ms(60000)))

    assert summary.passed == 1
    assert summary.failed == 1
    assert summary.skipped == 1
    assert summary.crashed == 1
    assert summary.timed_out == 1
    assert summary.total() == 5
    assert summary.elapsed.as_microseconds() == 60_016_018
  end

  test "a skip alone keeps the summary ok"
    summary = Summary{}.record(
      Outcome.Failed(Failure.Skipped("no db"), SummaryTest.ms(0)),
    )

    assert summary.ok?()
  end

  test "a failure, a crash, or a timeout makes the summary not ok"
    assert not Summary{}
      .record(Outcome.Failed(Failure.Error("boom"), SummaryTest.ms(0)))
      .ok?()
    assert not Summary{}
      .record(Outcome.Crashed("boom", SummaryTest.ms(0)))
      .ok?()
    assert not Summary{}.record(Outcome.TimedOut(SummaryTest.ms(1))).ok?()
  end

  test "outcome predicates"
    assert Outcome.Passed(SummaryTest.ms(1)).ok?()
    assert not Outcome.Passed(SummaryTest.ms(1)).skipped?()
    assert Outcome.Failed(Failure.Skipped("x"), SummaryTest.ms(1)).skipped?()
    assert not Outcome.Failed(Failure.Error("x"), SummaryTest.ms(1)).ok?()
    assert Outcome.Crashed("x", SummaryTest.ms(7)).elapsed() ==
      SummaryTest.ms(7)
  end
end
