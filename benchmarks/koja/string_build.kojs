# String builder loops in one process, the shape that copied the whole
# accumulator on every step before consuming `<>`. Appends 10M pieces
# to a single accumulator through a plain rebind and through an
# interpolation with a formatted integer. BEAM's counterpart leans on
# its binary append optimization, which is the same idea: grow the
# buffer in place while the reference is unique.

n = 10000000

t0 = Instant.now()
s = ""
i = 0

while i < n
  s = s <> "piece"
  i += 1
end

concat_elapsed = t0.elapsed().to_milliseconds()
"concat_ms #{concat_elapsed} bytes #{s.byte_length()}".print()

t2 = Instant.now()
acc = ""
j = 0

while j < n
  acc = "#{acc}#{j % 10}"
  j += 1
end

interp_elapsed = t2.elapsed().to_milliseconds()
"interp_ms #{interp_elapsed} bytes #{acc.byte_length()}".print()
